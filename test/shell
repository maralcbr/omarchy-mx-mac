#!/bin/bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
TEST_DIR="$ROOT/test/shell.d"
source "$ROOT/test/require-modern-bash"

tests=()
if (( $# > 0 )); then
  for requested_test in "$@"; do
    requested_test=$(cd -- "$(dirname -- "$requested_test")" && pwd)/$(basename "$requested_test")
    if [[ $requested_test != $TEST_DIR/*-test.sh || ! -f $requested_test ]]; then
      printf 'Invalid focused shell test: %s\n' "$requested_test" >&2
      exit 2
    fi
    if [[ $(basename "$requested_test") == "base-test.sh" ]]; then
      printf 'The shell test base cannot run directly.\n' >&2
      exit 2
    fi
    tests+=("$requested_test")
  done
else
  shopt -s nullglob
  for test in "$TEST_DIR"/*-test.sh; do
    if [[ $(basename "$test") != "base-test.sh" ]]; then
      tests+=("$test")
    fi
  done
  shopt -u nullglob
fi

if (( ${#tests[@]} == 0 )); then
  echo "No shell tests found in $TEST_DIR" >&2
  exit 1
fi

# Keep going after a failing file. A test file exits at its first failed
# assertion, so aborting the run there too would hide every file after it --
# one packaging failure was masking 114 of 134 files.
failed=()
for test in "${tests[@]}"; do
  printf '==> %s\n' "${test#$ROOT/}"
  if ! bash "$test"; then
    failed+=("${test#$ROOT/}")
  fi
done

if (( ${#failed[@]} > 0 )); then
  printf '\n%d of %d test files failed:\n' "${#failed[@]}" "${#tests[@]}" >&2
  printf '  %s\n' "${failed[@]}" >&2
  exit 1
fi

printf '\nAll %d test files passed.\n' "${#tests[@]}"
