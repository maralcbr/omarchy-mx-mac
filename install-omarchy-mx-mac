#!/bin/bash

set -euo pipefail

repo="${OMARCHY_REPO:-maralcbr/omarchy-mx-mac}"
release_base_url="${OMARCHY_RELEASE_BASE_URL:-https://github.com/$repo/releases/latest/download}"
fingerprint=40DFB630FF42BCFFB047046CF0134EE680CAC571
work_dir=$(mktemp -d "${TMPDIR:-/tmp}/omarchy-mx-mac-install.XXXXXXXX")
trap 'rm -rf "$work_dir"' EXIT

fail() { echo "Error: $*" >&2; exit 1; }

(( EUID == 0 )) || fail "Run this installer as root"
[[ $(uname -m) == "aarch64" ]] || fail "Omarchy MX Mac requires aarch64"
grep -aq 'apple,' /proc/device-tree/compatible 2>/dev/null || fail "Apple Silicon device tree not found"

pacman -Syu --noconfirm --needed curl git gnupg

descriptor="$work_dir/omarchy-mx-mac-release"
signature="$descriptor.sig"
keyring="$work_dir/omarchy-release.gpg"
key_home="$work_dir/gnupg"
mkdir -m 700 "$key_home"
curl --proto '=https' --tlsv1.2 --fail --location --retry 3 --output "$descriptor" "$release_base_url/omarchy-mx-mac-release"
curl --proto '=https' --tlsv1.2 --fail --location --retry 3 --output "$signature" "$release_base_url/omarchy-mx-mac-release.sig"
GNUPGHOME="$key_home" gpg --batch --keyserver hkps://keys.openpgp.org --recv-keys "$fingerprint"
actual_fingerprint=$(GNUPGHOME="$key_home" gpg --with-colons --fingerprint "$fingerprint" | awk -F: '$1 == "fpr" { print $10; exit }')
[[ $actual_fingerprint == "$fingerprint" ]] || fail "Omarchy release signing key fingerprint mismatch"
GNUPGHOME="$key_home" gpg --batch --export "$fingerprint" >"$keyring"
gpgv --keyring "$keyring" "$signature" "$descriptor" >/dev/null 2>&1 || fail "Stable release signature verification failed"

declare -A release=()
while IFS='=' read -r key value; do
  [[ -n $key && -n $value && -z ${release[$key]:-} ]] || fail "Malformed stable release descriptor"
  case "$key" in
    format|track|sequence|version|source_tag|source_commit|minimum_updater_version) release[$key]="$value" ;;
    *) fail "Unknown stable release field: $key" ;;
  esac
done <"$descriptor"

[[ ${release[format]:-} == "1" && ${release[track]:-} == "stable-mac" ]] || fail "Invalid stable release descriptor"
[[ ${release[sequence]:-} =~ ^[1-9][0-9]*$ ]] || fail "Invalid stable release sequence"
[[ ${release[version]:-} =~ ^[0-9]+\.[0-9]+\.[0-9]+-mac\.[0-9]+$ ]] || fail "Invalid stable release version"
[[ ${release[source_tag]:-} == "v${release[version]}" ]] || fail "Stable release tag and version do not match"
[[ ${release[source_commit]:-} =~ ^[0-9a-f]{40}$ ]] || fail "Invalid stable release source commit"
[[ ${release[minimum_updater_version]:-} == "1" ]] || fail "This release requires a newer installer"

root_checkout=/root/.local/share/omarchy
mkdir -p "${root_checkout%/*}"
rm -rf "$root_checkout"
git clone --filter=blob:none --no-checkout "https://github.com/$repo.git" "$root_checkout"
git -C "$root_checkout" fetch origin --no-tags "refs/tags/${release[source_tag]}:refs/tags/${release[source_tag]}"
resolved_commit=$(git -C "$root_checkout" rev-list -n 1 "${release[source_tag]}")
[[ $resolved_commit == "${release[source_commit]}" ]] || fail "Release tag does not match the signed source commit"
git -C "$root_checkout" checkout --detach "${release[source_commit]}"

export OMARCHY_REPO="$repo"
export OMARCHY_REF="${release[source_tag]}"
export OMARCHY_RELEASE_COMMIT="${release[source_commit]}"
bash "$root_checkout/bootstrap.sh"
