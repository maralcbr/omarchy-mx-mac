#!/bin/bash

# omarchy:summary=Prompt for confirmation before starting an update

# A Snapdragon or other aarch64 machine installed on a channel not qualified
# for it has no Omarchy repository; this is where its owner finds out.
notes=("• You cannot stop the update once you start!" "• Make sure you're connected to power or have a full battery")
if source "$OMARCHY_PATH/install/helpers/pacman.sh" 2>/dev/null; then
  notice=$(omarchy_pacman_missing_repository_notice /etc/pacman.conf)
  [[ -z $notice ]] || notes+=("• $notice")
fi

gum style --border normal --padding "1 2" \
  "Ready to update?" \
  "" \
  "${notes[@]}" \
  "" \
  "What's new: https://github.com/omacom/omarchy/releases/latest"

echo

if ! gum confirm "Continue with update?"; then
  echo "Update cancelled"
  exit 1
fi
