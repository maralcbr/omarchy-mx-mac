#!/bin/bash

# omarchy:summary=Install Omarchy on a fresh Asahi Arch system
# omarchy:args=--asahi-packages DIR [--user USER|--deferred-user] [--offline]
# omarchy:hidden=true
# omarchy:requires-sudo=true

set -euo pipefail

bundle_dir=""
target_user=""
deferred_user=0
offline=0
state_dir=/var/lib/omarchy/fresh-install
pacman_cache=/var/cache/pacman/pkg

fail() {
  echo "Error: $*" >&2
  exit 1
}

# Offline --offline exits:
#   4 cache or printed-transaction verification mismatch
#   5 configuration or pin mismatch
#   6 Aurora updater refused the offline pin or descriptor
offline_fail() {
  echo "Error: $*" >&2
  exit 4
}

offline_config_fail() {
  echo "Error: $*" >&2
  exit 5
}

aurora_offline_fail() {
  echo "Error: $*" >&2
  exit 6
}

repo_config_fail() {
  echo "Error: $*" >&2
  if (( offline )); then
    exit 5
  fi
  exit 1
}

# pacman-conf prints expanded tokens, one per line (PackageRequired, not Required).
offline_local_file_siglevel_ok() {
  grep -Fxq PackageRequired <<<"$1" && return 0
  grep -Fxq Required <<<"$1" && ! grep -Fxq PackageOptional <<<"$1"
}

usage() {
  echo "Usage: omarchy-install-asahi-fresh --asahi-packages DIR [--user USER|--deferred-user] [--offline]" >&2
}

retry() {
  local attempt

  for attempt in {1..3}; do
    "$@" && return 0
    (( attempt < 3 )) || return 1
    sleep 5
  done
}

# An interrupted install resumes only with the user and release that started
# it. Name each checkpoint field that differs from this run, with both values,
# and how to resume. The checkpoint holds only the user name and the public
# release identifiers.
checkpoint_mismatch() {
  local recorded="$1" expected="$2" side line key value
  local -A fields=()
  local -a differences=()
  local -a keys=(user sequence tag source_commit package_source_commit)
  local -A labels=(
    [user]="user"
    [sequence]="release sequence"
    [tag]="release tag"
    [source_commit]="release source commit"
    [package_source_commit]="package source commit"
  )

  for side in recorded expected; do
    while IFS= read -r line; do
      [[ $line == *=* ]] || continue
      key=${line%%=*}
      value=${line#*=}
      if [[ $key == identity && $value == deferred ]]; then
        key=user
        value="none (--deferred-user)"
      fi
      [[ -n $key && -n ${labels[$key]-} ]] || continue
      fields[$side.$key]=${value//[^[:print:]]/?}
    done <<<"${!side}"
  done

  local release_differs=0 names=""
  for key in "${keys[@]}"; do
    [[ ${fields[recorded.$key]-} == "${fields[expected.$key]-}" ]] && continue
    differences+=("$key")
    names+="${names:+, }${labels[$key]}"
    [[ $key == user ]] || release_differs=1
  done

  {
    if (( ${#differences[@]} == 0 )); then
      echo "Error: The incomplete installation checkpoint does not match this run"
    else
      echo "Error: An incomplete installation was started with a different $names"
    fi
    for key in "${differences[@]}"; do
      printf '  %s: recorded %s, this run %s\n' "${labels[$key]}" \
        "${fields[recorded.$key]:-(missing)}" "${fields[expected.$key]:-(missing)}"
    done
    if [[ ${fields[recorded.user]-} != "${fields[expected.user]-}" ]]; then
      if [[ ${fields[recorded.user]-} == "none (--deferred-user)" ]]; then
        echo "To resume it, run the installer again with --deferred-user."
      elif [[ ${fields[recorded.user]-} =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; then
        echo "To resume it, run the installer again with --user ${fields[recorded.user]}."
      fi
    fi
    if (( release_differs )) && [[ ${fields[recorded.tag]-} =~ ^asahi-quattro-[0-9A-Za-z._-]+$ ]]; then
      echo "To resume it, run the installer again with --release-tag ${fields[recorded.tag]}, the release that started it."
    fi
    echo "To install a different release or user instead, start again from a freshly installed Asahi system."
  } >&2
  exit 1
}

record_target_home_owner() {
  printf '%s\n' "$owner_token" | install -Dm600 /dev/stdin "$target_home/.omarchy-fresh-install-owner.tmp"
  mv "$target_home/.omarchy-fresh-install-owner.tmp" "$target_home/.omarchy-fresh-install-owner"
}

# Runs one of the verified runtime's own commands before the runtime is
# installed. Only these commands see the sudo stand-in and the runtime's key
# files; everything else is inherited, including OMARCHY_PROC_ROOT for a VM's
# Apple fixture.
runtime_command() {
  local defaults="$package_runtime_root/usr/share/omarchy/default"

  env \
    PATH="$package_runtime_root/sudo:$package_runtime_root/usr/bin:/usr/local/sbin:/usr/local/bin:/usr/bin" \
    OMARCHY_PATH="$package_runtime_root/usr/share/omarchy" \
    OMARCHY_ASAHI_KEY_FILE="$defaults/omarchy-release.gpg" \
    OMARCHY_ASAHI_PACKAGE_KEY_FILE="$defaults/omarchy-arm-repository.asc" \
    "$@"
}

# A clean Asahi Arch system has no [omarchy] repository. Without one ahead of
# Arch Linux ARM, the first transaction finds no Omarchy-built package and
# takes Hyprland from Arch Linux ARM. The verified runtime's own repository
# updater configures it, with the same checks it applies on installed Macs.
# A linux-aurora install also takes its kernel and m1n1 from [omarchy-aurora],
# which the runtime's Aurora updater pins (or, in an image build, verifies and
# stages without moving the builder's pin), directly ahead of [omarchy].
configure_package_repository() {
  local pacman_conf="$1" settings_archive="$2" omarchy_archive="$3"
  local archive updater defaults repositories server channel_record channel_status=0

  package_runtime_root=$(mktemp -d)
  trap 'rm -rf "$package_runtime_root"' EXIT
  for archive in "$settings_archive" "$omarchy_archive"; do
    bsdtar -xf "$archive" -C "$package_runtime_root" || fail "Could not unpack $(basename "$archive")"
  done
  updater="$package_runtime_root/usr/bin/omarchy-update-asahi-repository"
  defaults="$package_runtime_root/usr/share/omarchy/default"
  [[ -f $updater && -f $defaults/omarchy-release.gpg && -f $defaults/omarchy-arm-repository.asc ]] ||
    fail "The verified runtime cannot configure the Apple Silicon package repository"

  install -d -m 0700 "$package_runtime_root/sudo"
  cat >"$package_runtime_root/sudo/sudo" <<'EOF'
#!/bin/bash
(( EUID == 0 )) || [[ ${OMARCHY_ASAHI_TESTING:-0} == 1 ]] ||
  { echo "sudo: this installer stand-in only runs as root" >&2; exit 1; }
[[ ${1:-} != -* ]] || { echo "sudo: this installer stand-in takes no options" >&2; exit 1; }
exec "$@"
EOF
  chmod 0755 "$package_runtime_root/sudo/sudo"

  if (( ! offline )); then
    echo "Configuring the signed Apple Silicon package repository"
    runtime_command "$updater" --yes --bootstrap ||
      fail "Could not configure the signed Apple Silicon package repository; no packages were installed"
  fi

  channel_record=$(runtime_command omarchy-apple-silicon-channel status) || channel_status=$?
  case $channel_status in
    0) ;;
    3) channel_record="" ;;
    *) fail "This Mac's Apple Silicon channel record cannot be trusted; no packages were installed" ;;
  esac
  if [[ $kernel_package == linux-aurora ]]; then
    if [[ ${OMARCHY_MAC_IMAGE_BUILD:-} == 1 ]]; then
      echo "Keeping the image's pinned Aurora kernel repository"
    else
      echo "Pinning the Aurora kernel repository"
    fi
    if (( offline )); then
      runtime_command "$package_runtime_root/usr/bin/omarchy-update-aurora-repository" ||
        aurora_offline_fail "Could not pin the Aurora kernel repository; no packages were installed"
    else
      runtime_command "$package_runtime_root/usr/bin/omarchy-update-aurora-repository" ||
        fail "Could not pin the Aurora kernel repository; no packages were installed"
    fi
  fi
  rm -rf "$package_runtime_root"
  trap - EXIT

  repositories=$(pacman-conf --config "$pacman_conf" --repo-list) || repo_config_fail "Could not read the configured repositories"
  [[ ${repositories%%$'\n'*} != "omarchy-aurora" ]] || repositories=${repositories#omarchy-aurora$'\n'}
  [[ ${repositories%%$'\n'*} == "omarchy" ]] ||
    repo_config_fail "The [omarchy] repository must come before every other repository, except an [omarchy-aurora] directly ahead of it"
  server=$(awk '
    /^[[:space:]]*\[omarchy\][[:space:]]*$/ { inside = 1; next }
    inside && /^[[:space:]]*\[[^]]+\][[:space:]]*$/ { inside = 0 }
    inside && /^[[:space:]]*Server[[:space:]]*=/ { sub(/^[[:space:]]*Server[[:space:]]*=[[:space:]]*/, ""); sub(/[[:space:]]+$/, ""); print }
  ' "$pacman_conf")
  [[ -n $server && $server != *$'\n'* ]] || repo_config_fail "The [omarchy] repository must have exactly one Server"
  if (( offline )) || [[ ${OMARCHY_MAC_IMAGE_BUILD:-} == 1 ]]; then
    stable_prefix="https://github.com/maralcbr/omarchy-pkgs/releases/download/asahi-packages-stable-"
    if [[ $server != "$stable_prefix"* || ! ${server#"$stable_prefix"} =~ ^[0-9a-f]{40}$ ]]; then
      if (( offline )); then
        offline_config_fail "The [omarchy] repository must name an asahi-packages-stable tag"
      else
        repo_config_fail "The [omarchy] repository must name an asahi-packages-stable tag"
      fi
    fi
    if (( offline )); then
      [[ -n ${OMARCHY_ASAHI_KEEP_SERVER:-} ]] ||
        offline_config_fail "OMARCHY_ASAHI_KEEP_SERVER must name the expected asahi-packages-stable Server"
      [[ $server == "$OMARCHY_ASAHI_KEEP_SERVER" ]] ||
        offline_config_fail "The [omarchy] repository does not match OMARCHY_ASAHI_KEEP_SERVER"
    fi
  fi
  # System setup rewrites [omarchy] through install/hardware/pacman.sh, which
  # would otherwise swap a kept candidate or mirror for its own default.
  export OMARCHY_ASAHI_KEEP_SERVER="$server"
}

# One pacman --print-format '%l %h' line: cache objects must exist with the
# database sha256; local -U archives must exist at the printed path.
verify_offline_printed_archive() {
  local location=$1 hash=$2 filename cached
  [[ -n $location ]] || return 0
  filename=$(basename "${location%%\?*}")
  cached="$pacman_cache/$filename"
  if [[ $location == /* && $location != $pacman_cache/* ]]; then
    [[ -f $location ]] || offline_fail "Printed local archive is missing: $location"
    return 0
  fi
  [[ -f $cached ]] || offline_fail "Cached archive is missing: $filename"
  [[ $hash =~ ^[0-9a-f]{64}$ ]] || offline_fail "Could not read the database sha256 for $filename"
  [[ $(sha256sum "$cached" | cut -d' ' -f1) == "$hash" ]] ||
    offline_fail "Cached archive $filename does not match the database sha256"
}

verify_offline_printed_archives() {
  local line location hash
  local -a lines=()
  mapfile -t lines
  for line in "${lines[@]}"; do
    [[ -n $line ]] || continue
    read -r location hash <<<"$line"
    verify_offline_printed_archive "$location" "$hash"
  done
}

# The builder's GRUB and boot files are the image's, not this install's: a
# deferred install regenerates them on every attempt and checks what it made
# against the installed kernel package.
regenerate_boot_files() {
  omarchy-mac-boot-update || fail "Could not regenerate the boot loader configuration"
  update-m1n1 || fail "Could not regenerate the m1n1 boot image"
}

verify_kernel_image() {
  local kernel_files

  kernel_files=$(pacman -Qlq "$kernel_package") || fail "Could not list the files of $kernel_package"
  kernel_version=$(sed -n 's|^/usr/lib/modules/\([^/]*\)/vmlinuz$|\1|p' <<<"$kernel_files")
  [[ -n $kernel_version && $kernel_version != *$'\n'* ]] || fail "Could not identify the installed $kernel_package kernel"
  cmp -s "/boot/vmlinuz-$kernel_package" "/usr/lib/modules/$kernel_version/vmlinuz" ||
    fail "/boot/vmlinuz-$kernel_package is not the installed $kernel_package kernel"
}

verify_initramfs() {
  local initramfs_files

  initramfs_files=$(lsinitcpio -l "/boot/initramfs-$kernel_package.img") ||
    fail "Could not read the $kernel_package initramfs"
  grep -Fq "usr/lib/modules/$kernel_version/" <<<"$initramfs_files" ||
    fail "The $kernel_package initramfs does not carry the modules of $kernel_version"
}

# A menu entry that actually boots the kernel: a linux directive naming the
# kernel image and an initrd directive naming its initramfs, not a mention of
# either name in a comment.
# A Mac that boots Limine has no GRUB configuration to verify: its menu, UKI
# and command line are checked by omarchy-apple-silicon-boot-check instead.
# This must not depend on the Omarchy runtime, which an interrupted install
# has not put in place yet, so it reads the ESP the image shipped.
limine_mac() {
  [[ -f /boot/efi/limine.conf ]] || return 1
  ! command -v omarchy-mac-limine-active >/dev/null 2>&1 || omarchy-mac-limine-active
}

verify_grub_config() {
  [[ -f /boot/grub/grub.cfg ]] || { limine_mac && return 0; }
  grep -Eq "^[[:space:]]*linux(16|efi)?[[:space:]]+[^[:space:]]*vmlinuz-$kernel_package([[:space:]]|\$)" /boot/grub/grub.cfg &&
    grep -Eq "^[[:space:]]*initrd(16|efi)?[[:space:]]+[^[:space:]]*initramfs-$kernel_package\.img([[:space:]]|\$)" /boot/grub/grub.cfg ||
    fail "The GRUB configuration does not boot $kernel_package"
}

verify_boot_chain() {
  OMARCHY_BOOT_CHECK_ALLOW_PENDING_REBOOT=1 omarchy-apple-silicon-boot-check "$kernel_package" ||
    fail "The boot files do not match the installed $kernel_package and its m1n1"
}

# The last check rebuilds m1n1 stage 2 and compares it with the ESP's copy.
verify_boot_files() {
  verify_kernel_image
  verify_initramfs
  verify_grub_config
  verify_boot_chain
}

# HID and btrfs drop-ins must be in the image before mkinitcpio.
# install/hardware/all.sh's image-mode branch is the one place that decides
# which leaves run statically; it applies them through run_logged.
apply_static_boot_prerequisites() {
  local hid_conf=/etc/mkinitcpio.conf.d/apple_hid_modules.conf
  local btrfs_dropin=/etc/systemd/system/kmod-static-nodes.service.d/10-before-tmpfiles-setup-dev.conf
  [[ -n ${OMARCHY_PATH:-} && $OMARCHY_PATH == /* ]] || fail "OMARCHY_PATH is unset"
  OMARCHY_INSTALL=${OMARCHY_INSTALL:-$OMARCHY_PATH/install}
  [[ -f $OMARCHY_INSTALL/helpers/logging.sh && -f $OMARCHY_INSTALL/hardware/all.sh ]] ||
    fail "Install helpers are missing under $OMARCHY_INSTALL"
  # Source in a child so all.sh's image-mode `return 0` cannot skip the drop-in checks.
  OMARCHY_PATH="$OMARCHY_PATH" OMARCHY_INSTALL="$OMARCHY_INSTALL" \
    OMARCHY_MAC_IMAGE_BUILD=1 OMARCHY_MAC_TARGET=generic-apple-silicon \
    OMARCHY_MAC_DEFERRED_STEPS="${OMARCHY_MAC_DEFERRED_STEPS:-/var/lib/omarchy/mac-first-boot/deferred-steps}" \
    PATH="$OMARCHY_PATH/bin:$PATH" bash -eE -c 'source "$1"; source "$2"' bash \
      "$OMARCHY_INSTALL/helpers/logging.sh" "$OMARCHY_INSTALL/hardware/all.sh" </dev/null ||
    fail "Could not apply static Apple boot leaves to the image"
  [[ -f $hid_conf ]] || fail "The Apple HID initramfs drop-in is missing from the image"
  [[ -f $btrfs_dropin ]] || fail "The btrfs static-nodes drop-in is missing from the image"
}

while (($#)); do
  case "$1" in
    --asahi-packages)
      (($# > 1)) || fail "--asahi-packages requires a directory"
      bundle_dir="$2"
      shift 2
      ;;
    --user)
      (($# > 1)) || fail "--user requires a username"
      target_user="$2"
      shift 2
      ;;
    --deferred-user)
      deferred_user=1
      shift
      ;;
    --offline)
      offline=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      fail "Unknown option: $1"
      ;;
  esac
done

(( ! deferred_user )) || [[ -z $target_user ]] || fail "--user and --deferred-user cannot be combined"
(( ! offline )) || (( deferred_user )) || fail "--offline requires --deferred-user"
[[ ${OMARCHY_MAC_IMAGE_BUILD:-} != 1 ]] || (( deferred_user )) || fail "OMARCHY_MAC_IMAGE_BUILD=1 requires --deferred-user"
if [[ ${OMARCHY_MAC_IMAGE_BUILD:-} == 1 ]]; then
  # The repository updater probes Apple hardware at startup. Export the generic
  # identity before any runtime command so CI and chroots without a device-tree
  # can configure [omarchy].
  export OMARCHY_MAC_IMAGE_BUILD=1
  export OMARCHY_MAC_TARGET=generic-apple-silicon
fi
(( ! offline )) || export OMARCHY_AURORA_OFFLINE=1 OMARCHY_ASAHI_OFFLINE=1
(( EUID == 0 )) || fail "Run the fresh installer as root"
[[ -d $bundle_dir ]] || fail "The verified package directory is unavailable"
[[ -n ${OMARCHY_ASAHI_PACKAGE_SOURCE:-} ]] || fail "Missing verified package source commit"
[[ $OMARCHY_ASAHI_PACKAGE_SOURCE =~ ^[0-9a-f]{40}$ ]] || fail "Invalid package source commit"
[[ $(uname -m) == "aarch64" ]] || fail "Fresh Apple Silicon installation requires aarch64"
if [[ ${OMARCHY_MAC_IMAGE_BUILD:-} != 1 ]]; then
  [[ -r /proc/device-tree/compatible ]] || fail "Apple device-tree information is unavailable"
  grep -aq 'apple,' /proc/device-tree/compatible || fail "Apple Silicon device tree not found"
fi

kernel_marker=/usr/share/omarchy/apple-silicon-kernel
# Aurora is the kernel this installer picks. linux-asahi remains only if the
# image's kernel marker already names it; the installer never selects it.
kernel_package=linux-aurora
if [[ -f $kernel_marker && ! -L $kernel_marker ]]; then
  read -r kernel_package <"$kernel_marker" || true
fi
[[ $kernel_package =~ ^linux-[a-z0-9]+$ ]] || fail "Unreadable kernel package name"
# The Aurora kernel boots through its own m1n1 build, which replaces m1n1.
m1n1_package=m1n1
[[ $kernel_package != linux-aurora ]] || m1n1_package=m1n1-aurora

# The boot loader of the image: GRUB, or Limine on an image that ships it.
boot_loader_packages=(grub)
if pacman -Q limine >/dev/null 2>&1 && [[ -f /boot/efi/limine.conf ]]; then
  boot_loader_packages=(limine limine-mkinitcpio-hook)
fi
for package in "$kernel_package" "$kernel_package-headers" "$m1n1_package" "${boot_loader_packages[@]}"; do
  pacman -Q "$package" >/dev/null 2>&1 || fail "Required Asahi package is not installed: $package"
done
[[ -f /boot/vmlinuz-$kernel_package ]] || fail "/boot/vmlinuz-$kernel_package is unavailable"
[[ -f /boot/grub/grub.cfg || -f /boot/efi/limine.conf ]] ||
  fail "The image has neither a GRUB configuration nor a Limine menu to boot from"
for repository in asahi-alarm core extra alarm aur; do
  pacman-conf --repo-list | grep -Fxq "$repository" || fail "Required repository is unavailable: $repository"
done
# The package repository updater requires it, and it runs before anything is installed.
pacman -Q jq >/dev/null 2>&1 || fail "Install jq first (pacman -S jq)"
if [[ ${OMARCHY_MAC_IMAGE_BUILD:-} != 1 ]]; then
  (( $(swapon --show --noheadings | wc -l) == 0 )) || fail "Disable swap before installing Omarchy"
  [[ $(cat /sys/module/zswap/parameters/enabled 2>/dev/null || echo N) == "N" ]] || fail "Disable zswap before installing Omarchy"
fi

expected_packages=(omarchy-keyring omarchy-settings-dev omarchy-dev omarchy-nvim quickshell-git ttf-jetbrains-mono-nerd-basic)
archives=()
for package in "${expected_packages[@]}"; do
  matches=("$bundle_dir/$package"-*.pkg.tar.*)
  filtered=()
  for match in "${matches[@]}"; do
    [[ -f $match && $match != *.sig ]] && filtered+=("$match")
  done
  ((${#filtered[@]} == 1)) || fail "Expected exactly one verified archive for $package"
  archives+=("${filtered[0]}")
done

# A deferred install creates no account: omarchy-provision-owner creates the
# owner on first boot, as it does for an image install.
checkpoint_identity="identity=deferred"
if (( ! deferred_user )); then
  if [[ -z $target_user ]]; then
    tty </dev/tty >/dev/null 2>&1 || fail "--user is required without an interactive terminal"
    read -rp "Omarchy username: " target_user </dev/tty
  fi
  [[ $target_user =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || fail "Invalid username: $target_user"
  [[ $target_user != "root" ]] || fail "The Omarchy user cannot be root"
  checkpoint_identity="user=$target_user"
fi
release_sequence=${OMARCHY_ASAHI_RELEASE_SEQUENCE:?Missing release sequence}
release_tag=${OMARCHY_ASAHI_RELEASE_TAG:?Missing release tag}
release_source=${OMARCHY_ASAHI_RELEASE_SOURCE:?Missing release source}
[[ $release_sequence =~ ^[1-9][0-9]*$ ]] || fail "Invalid signed Asahi release sequence"
[[ $release_tag == asahi-quattro-* && $release_tag != */* ]] || fail "Invalid signed Asahi release tag"
[[ $release_source =~ ^[0-9a-f]{40}$ ]] || fail "Invalid signed Asahi release source"
expected_state=$(printf '%s\n' \
  "$checkpoint_identity" \
  "sequence=$release_sequence" \
  "tag=$release_tag" \
  "source_commit=$release_source" \
  "package_source_commit=$OMARCHY_ASAHI_PACKAGE_SOURCE")
expected_release=$(printf '%s\n' \
  "format=1" \
  "sequence=$release_sequence" \
  "tag=$release_tag" \
  "source_commit=$release_source" \
  "package_source_commit=$OMARCHY_ASAHI_PACKAGE_SOURCE")
exec {install_lock}>/run/lock/omarchy-asahi-fresh.lock
flock -n "$install_lock" || fail "Another fresh installation is already running"
if [[ -e $state_dir ]]; then
  [[ -d $state_dir && -f $state_dir/release && -f $state_dir/asahi-kernel.sha256 && -f $state_dir/grub.sha256 && -f $state_dir/owner-token ]] ||
    fail "The incomplete installation checkpoint is invalid"
  [[ $(<"$state_dir/release") == "$expected_state" ]] || checkpoint_mismatch "$(<"$state_dir/release")" "$expected_state"
  owner_token=$(<"$state_dir/owner-token")
  [[ $owner_token =~ ^[0-9a-f]{64}$ ]] || fail "The incomplete installation owner token is invalid"
  if [[ -f $state_dir/completing ]]; then
    [[ -f /var/lib/omarchy/asahi-quattro-release && $(< /var/lib/omarchy/asahi-quattro-release) == "$expected_release" ]] ||
      fail "The completed installation release marker is invalid"
    if (( ! deferred_user )); then
      getent passwd "$target_user" >/dev/null || fail "The completed installation target user is unavailable"
      IFS=: read -r _ _ target_uid _ target_comment target_home target_shell < <(getent passwd "$target_user")
      target_identity="$target_user:$target_uid:$target_home:$target_shell:$owner_token"
      [[ -f $state_dir/target-user && $(<"$state_dir/target-user") == "$target_identity" ]] ||
        fail "The completed installation target user is invalid"
      [[ $target_comment == "$owner_token" || -z $target_comment ]] || fail "The completed installation target user is invalid"
      if [[ -e $target_home/.omarchy-fresh-install-owner ]]; then
        [[ -f $target_home/.omarchy-fresh-install-owner && $(<"$target_home/.omarchy-fresh-install-owner") == "$owner_token" ]] ||
          fail "The completed installation target home is invalid"
        rm -f "$target_home/.omarchy-fresh-install-owner"
      fi
      [[ -z $target_comment ]] || usermod --comment "" "$target_user"
    fi
    rm -rf "$state_dir"
    echo "Fresh Omarchy 4 installation completion recovered"
    exit 0
  fi
  if (( ! deferred_user )) && getent passwd "$target_user" >/dev/null; then
    IFS=: read -r _ _ target_uid _ target_comment target_home target_shell < <(getent passwd "$target_user")
    target_identity="$target_user:$target_uid:$target_home:$target_shell:$owner_token"
    [[ -f $state_dir/target-user && $(<"$state_dir/target-user") == "$target_identity" ]] ||
      fail "The target user is not owned by this installation"
    [[ $target_comment == "$owner_token" ]] || fail "The target user is not owned by this installation"
    if [[ -e $target_home/.omarchy-fresh-install-owner ]]; then
      [[ -f $target_home/.omarchy-fresh-install-owner && $(<"$target_home/.omarchy-fresh-install-owner") == "$owner_token" ]] ||
        fail "The target home is not owned by this installation"
    else
      record_target_home_owner
    fi
  elif (( ! deferred_user )) && [[ -e $state_dir/target-user ]]; then
    IFS=: read -r recorded_user target_uid target_home target_shell recorded_token <"$state_dir/target-user"
    [[ $recorded_user == "$target_user" && $target_uid =~ ^[0-9]+$ && $target_home == "/home/$target_user" &&
      $target_shell == "/bin/bash" && $recorded_token == "$owner_token" ]] ||
      fail "The target user checkpoint is invalid"
  fi
elif (( ! deferred_user )) && getent passwd "$target_user" >/dev/null; then
  fail "User already exists outside this release installation: $target_user"
fi
(( deferred_user )) || tty </dev/tty >/dev/null 2>&1 || fail "A controlling terminal is required to set the user password"

backup_dir="/var/lib/omarchy/backups/fresh-$(date +%Y%m%d%H%M%S)"
install -d -m 0700 "$backup_dir"
cp -a /etc/pacman.conf /etc/pacman.d /etc/NetworkManager "$backup_dir/" 2>/dev/null || true
[[ ! -f /boot/grub/grub.cfg ]] || cp -a /boot/grub/grub.cfg "$backup_dir/grub.cfg"
pacman -Q >"$backup_dir/installed-packages.txt"
# The kernel image is protected by digest. GRUB's configuration is Omarchy's
# own output once the console leaf has regenerated it during system setup:
# a resume accepts the configuration recorded at the checkpoint, or one that
# boots the installed kernel; the end of the install requires the latter.
if [[ -d $state_dir ]]; then
  asahi_kernel_sha256=$(<"$state_dir/asahi-kernel.sha256")
  grub_sha256=$(<"$state_dir/grub.sha256")
  # A deferred install regenerates its boot files and checks those instead.
  if (( ! deferred_user )); then
    sha256sum --check --status <<<"$asahi_kernel_sha256" || fail "The Asahi kernel changed after the interrupted installation"
    if [[ -n $grub_sha256 ]]; then
      sha256sum --check --status <<<"$grub_sha256" || verify_grub_config
    else
      verify_grub_config
    fi
  fi
else
  asahi_kernel_sha256=$(sha256sum "/boot/vmlinuz-$kernel_package")
  grub_sha256=""
  [[ ! -f /boot/grub/grub.cfg ]] || grub_sha256=$(sha256sum /boot/grub/grub.cfg)
  owner_token=$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')
  install -d -m 0755 /var/lib/omarchy
  checkpoint_tmp=$(mktemp -d /var/lib/omarchy/.fresh-install.XXXXXX)
  chmod 0700 "$checkpoint_tmp"
  printf '%s\n' "$expected_state" >"$checkpoint_tmp/release"
  printf '%s\n' "$asahi_kernel_sha256" >"$checkpoint_tmp/asahi-kernel.sha256"
  printf '%s\n' "$grub_sha256" >"$checkpoint_tmp/grub.sha256"
  printf '%s\n' "$owner_token" >"$checkpoint_tmp/owner-token"
  mv -T "$checkpoint_tmp" "$state_dir"
fi

settings_archive=${archives[1]}
omarchy_archive=${archives[2]}
mapfile -t runtime_packages < <(
  bsdtar -xOf "$omarchy_archive" usr/share/omarchy/install/omarchy-base-asahi.packages |
    sed 's/#.*//' |
    awk 'NF == 1 { print $1 }' |
    grep -vE '^(omarchy-keyring|omarchy-settings-dev|omarchy-dev|omarchy-nvim|quickshell-git|ttf-jetbrains-mono-nerd-basic)$'
)
((${#runtime_packages[@]} > 0)) || fail "Could not read the Asahi runtime package manifest"

# Every remaining package is a repository binary: the signed [omarchy]
# repository carries the Omarchy-built packages for aarch64, so nothing is
# compiled on the target machine during installation.
# The manifest names a kernel family for the image builder; this install keeps
# the kernel the image booted with (checked above), so no kernel, headers or
# m1n1 of either family is a repository target here.
repo_packages=()
for package in "${runtime_packages[@]}"; do
  case $package in
    "$kernel_package" | "$kernel_package-headers" | "$m1n1_package" | \
      linux-aurora | linux-aurora-headers | m1n1-aurora | linux-asahi | linux-asahi-headers | m1n1)
      continue
      ;;
  esac
  repo_packages+=("$package")
done

configure_package_repository /etc/pacman.conf "$settings_archive" "$omarchy_archive"

echo "Installing the Omarchy 4 Apple Silicon package set"
if (( offline )); then
  local_siglevel=$(pacman-conf LocalFileSigLevel) ||
    offline_config_fail "Could not read LocalFileSigLevel"
  offline_local_file_siglevel_ok "$local_siglevel" ||
    offline_config_fail "LocalFileSigLevel must require package signatures (got ${local_siglevel//$'\n'/, })"
  printed=$(pacman -Sup --print-format '%l %h' --needed --noconfirm --ignore "$kernel_package,$kernel_package-headers,$m1n1_package" \
    base-devel sudo xdg-user-dirs "${repo_packages[@]}") ||
    offline_fail "Could not print the repository transaction"
  verify_offline_printed_archives <<<"$printed"
  # Apply transaction 1 to a disposable database copy before resolving transaction 2.
  [[ -d /var/lib/pacman/local ]] || offline_fail "The local package database is unavailable"
  offline_db=$(mktemp -d)
  trap 'rm -rf "$offline_db"' EXIT
  cp -a /var/lib/pacman/. "$offline_db/" || offline_fail "Could not copy the package database"
  pacman --dbpath "$offline_db" -Su --dbonly --needed --noconfirm --ignore "$kernel_package,$kernel_package-headers,$m1n1_package" \
    base-devel sudo xdg-user-dirs "${repo_packages[@]}" ||
    offline_fail "Could not simulate the repository transaction"
  printed=$(pacman --dbpath "$offline_db" -Up --print --print-format '%l %h' --needed --noconfirm "${archives[@]}") ||
    offline_fail "Could not print the six-package transaction"
  verify_offline_printed_archives <<<"$printed"
  rm -rf "$offline_db"
  trap - EXIT
  pacman -Su --needed --noconfirm --ignore "$kernel_package,$kernel_package-headers,$m1n1_package" \
    base-devel sudo xdg-user-dirs "${repo_packages[@]}"
else
  pacman -Syu --needed --noconfirm --ignore "$kernel_package,$kernel_package-headers,$m1n1_package" \
    base-devel sudo xdg-user-dirs "${repo_packages[@]}"
fi

echo "Installing the verified six-package Omarchy release"
pacman -U --needed --noconfirm "${archives[@]}"

if (( ! deferred_user )); then
  if ! getent passwd "$target_user" >/dev/null; then
    if [[ ! -f $state_dir/target-user ]]; then
      uid_min=$(awk '$1 == "UID_MIN" { print $2; exit }' /etc/login.defs)
      uid_max=$(awk '$1 == "UID_MAX" { print $2; exit }' /etc/login.defs)
      [[ $uid_min =~ ^[0-9]+$ && $uid_max =~ ^[0-9]+$ ]] || fail "Could not read the user ID range"
      target_uid=$uid_min
      while getent passwd "$target_uid" >/dev/null; do
        ((target_uid++))
        (( target_uid <= uid_max )) || fail "No user ID is available for $target_user"
      done
      target_home="/home/$target_user"
      target_shell=/bin/bash
      target_identity="$target_user:$target_uid:$target_home:$target_shell:$owner_token"
      printf '%s\n' "$target_identity" >"$state_dir/.target-user.tmp"
      mv "$state_dir/.target-user.tmp" "$state_dir/target-user"
    fi
    useradd --uid "$target_uid" --home-dir "$target_home" --create-home --groups wheel \
      --shell "$target_shell" --comment "$owner_token" "$target_user"
    record_target_home_owner
  fi
  install -Dm440 /dev/stdin /etc/sudoers.d/10-omarchy-wheel <<'EOF'
%wheel ALL=(ALL:ALL) ALL
EOF

  target_home=$(getent passwd "$target_user" | cut -d: -f6)

  echo "Set the password for $target_user"
  passwd "$target_user" </dev/tty

  # Seed SDDM's remembered user so the password-only greeter has a username to
  # authenticate on first boot. state.conf is otherwise empty until a login
  # succeeds, and the omarchy theme then passes an empty user to PAM, which
  # rejects every password as "user unknown".
  install -d -m 0755 -o sddm -g sddm /var/lib/sddm 2>/dev/null || install -d -m 0755 /var/lib/sddm
  # omarchy:heredoc-expands paths=none -- $target_user is validated against a strict username pattern above
  cat > /var/lib/sddm/state.conf <<EOF
[Last]
Session=omarchy.desktop
User=$target_user
EOF
  chown sddm:sddm /var/lib/sddm /var/lib/sddm/state.conf 2>/dev/null || true
fi

if [[ ${OMARCHY_MAC_IMAGE_BUILD:-} == 1 ]]; then
  OMARCHY_PATH=/usr/share/omarchy
  OMARCHY_INSTALL="$OMARCHY_PATH/install"
  source "$OMARCHY_INSTALL/helpers/mac-image-build.sh"
  omarchy_mac_export_image_identity
  export OMARCHY_MAC_DEFERRED_STEPS=/var/lib/omarchy/mac-first-boot/deferred-steps
fi

if (( deferred_user )); then
  # Group grants are recorded for the owner omarchy-provision-owner creates.
  OMARCHY_PATH=/usr/share/omarchy \
    OMARCHY_INSTALL=/usr/share/omarchy/install \
    omarchy-apply-system --defer-provisioning --first-install
else
  OMARCHY_PATH=/usr/share/omarchy \
    OMARCHY_INSTALL=/usr/share/omarchy/install \
    omarchy-apply-system --install-user "$target_user" --first-install
fi

if [[ ${OMARCHY_MAC_IMAGE_BUILD:-} == 1 ]]; then
  apply_static_boot_prerequisites
fi

echo "Rebuilding the initramfs with the Apple HID drivers"
mkinitcpio -P
install -Dm644 /dev/null /var/lib/omarchy/apple-hid-initramfs-ready

if (( deferred_user )); then
  echo "Regenerating the boot files"
  regenerate_boot_files
else
  runuser -u "$target_user" -- env \
    HOME="$target_home" \
    USER="$target_user" \
    LOGNAME="$target_user" \
    OMARCHY_PATH=/usr/share/omarchy \
    OMARCHY_INSTALL=/usr/share/omarchy/install \
    OMARCHY_SETUP_CONTEXT=fresh-install \
    PATH="/usr/share/omarchy/bin:/usr/local/sbin:/usr/local/bin:/usr/bin" \
    omarchy-provision-user --force --first-install
fi

ln -sfn /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf

pacman -Q omarchy-dev omarchy-settings-dev "$kernel_package" "$kernel_package-headers" "$m1n1_package" networkmanager iwd >/dev/null
[[ $(cat /usr/share/omarchy/version) == 4.* ]] || fail "Installed Omarchy version is not 4.x"
if [[ ${OMARCHY_MAC_IMAGE_BUILD:-} != 1 ]]; then
  NetworkManager --print-config 2>/dev/null | grep -Fxq 'wifi.backend=iwd' || fail "NetworkManager iwd backend was not configured"
fi
grep -Eqi '^[[:space:]]*LANG[[:space:]]*=[[:space:]]*"?[^"[:space:]#]*\.utf-?8(@[^"[:space:]#]+)?"?([[:space:]]*(#.*)?)?$' /etc/locale.conf || fail "The system locale is not UTF-8"
if (( deferred_user )); then
  verify_boot_files
else
  sha256sum --check --status <<<"$asahi_kernel_sha256" || fail "The Asahi kernel changed unexpectedly"
  verify_grub_config
  # A Limine Mac has no grub.cfg to compare; its menu, UKI, command line and
  # the ESP's Limine are what make it bootable.
  ! limine_mac || verify_boot_chain
fi

# The stock Alarm account is also a wheel administrator. Retire it only after
# finalization has succeeded and, unless the owner is created on first boot,
# the replacement administrator has a password.
if [[ $target_user != "alarm" ]] && getent passwd alarm >/dev/null 2>&1; then
  [[ " $(id -nG alarm) " != *" wheel "* ]] || gpasswd -d alarm wheel
  usermod -L alarm
fi

install -d -m 0755 /var/lib/omarchy
# omarchy:heredoc-expands paths=none -- the release identity values are pattern-validated at startup
cat >"$state_dir/asahi-quattro-release.tmp" <<EOF
format=1
sequence=$release_sequence
tag=$release_tag
source_commit=$release_source
package_source_commit=$OMARCHY_ASAHI_PACKAGE_SOURCE
EOF
chown root:root "$state_dir/asahi-quattro-release.tmp"
chmod 0644 "$state_dir/asahi-quattro-release.tmp"
mv "$state_dir/asahi-quattro-release.tmp" /var/lib/omarchy/asahi-quattro-release
touch "$state_dir/completing"
if (( ! deferred_user )); then
  usermod --comment "" "$target_user"
  rm -f "$target_home/.omarchy-fresh-install-owner"
fi
rm -rf "$state_dir"

echo "Fresh Omarchy 4 installation complete (backup: $backup_dir)"
(( deferred_user )) || echo "Reboot, then sign in as $target_user"
