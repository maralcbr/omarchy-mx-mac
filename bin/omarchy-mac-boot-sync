#!/bin/bash

# omarchy:summary=Keep /boot's GRUB kernel in step with the running root of a Limine Mac
# omarchy:requires-sudo=true
# omarchy:hidden=true

# limine-snapper-restore swaps the root subvolume and puts the snapshot's UKI
# back on the ESP, but the ext4 /boot that GRUB (the recovery entry) boots
# from stays as it was: its kernel and initramfs may no longer match the
# modules in the restored root. omarchy-mac-boot-sync.service runs this on
# every boot of a Limine Mac: when /boot's kernel has no modules in this
# root, the running kernel is copied back, the initramfs rebuilt, and both
# loaders regenerated.
# A snapshot boot (read-only history under a tmpfs overlay) writes nothing.

set -uo pipefail

boot_dir=${OMARCHY_BOOT_DIR:-/boot}
modules_dir=${OMARCHY_MODULES_DIR:-/usr/lib/modules}
snapshot_marker=${OMARCHY_SNAPSHOT_BOOT_MARKER:-/run/omarchy-snapshot-boot}
cmdline=${OMARCHY_CMDLINE:-/proc/cmdline}
running=${OMARCHY_RUNNING_KERNEL:-$(uname -r)}

omarchy-mac-limine-active || exit 0
[[ ! -e $snapshot_marker ]] || exit 0
case " $(<"$cmdline") " in
  *"/.snapshots/"*) exit 0 ;;
esac

kernel=$(omarchy-hw-apple-kernel) || exit 1
modules=$modules_dir/$running
[[ -f $modules/vmlinuz && -f $modules/pkgbase && $(<"$modules/pkgbase") == "$kernel" ]] || exit 0
# /boot is consistent while its kernel has its modules in this root: that
# covers the running kernel and a newer one installed with a reboot pending
# (kernel-modules-hook keeps the old modules alongside).
for dir in "$modules_dir"/*/; do
  [[ -f $dir/pkgbase && $(<"$dir/pkgbase") == "$kernel" && -f $dir/vmlinuz ]] || continue
  cmp -s "$dir/vmlinuz" "$boot_dir/vmlinuz-$kernel" && exit 0
done

echo "omarchy-mac-boot-sync: $boot_dir/vmlinuz-$kernel has no modules in this root; rebuilding /boot from the running $running for GRUB"
install -m644 "$modules/vmlinuz" "$boot_dir/vmlinuz-$kernel" || exit 1
# /usr/bin: the limine-mkinitcpio-hook wrapper on PATH would run a UKI
# rebuild whose success hides a failed initramfs.
"${OMARCHY_MKINITCPIO:-/usr/bin/mkinitcpio}" -P </dev/null || exit 1
omarchy-mac-boot-update || exit 1
omarchy-mac-snapshot-menu refresh >/dev/null 2>&1 || true
