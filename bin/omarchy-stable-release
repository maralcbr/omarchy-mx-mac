#!/bin/bash

# omarchy:summary=Resolve and verify the latest stable Omarchy Mac release
# omarchy:args=[field]

set -euo pipefail

release_base_url="${OMARCHY_RELEASE_BASE_URL:-https://github.com/maralcbr/omarchy-mx-mac/releases/latest/download}"
release_keyring="${OMARCHY_RELEASE_KEYRING:-/usr/share/pacman/keyrings/omarchy.gpg}"
expected_fingerprint=40DFB630FF42BCFFB047046CF0134EE680CAC571
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/releases"
descriptor_name=omarchy-mx-mac-release
work_dir=$(mktemp -d "${TMPDIR:-/tmp}/omarchy-release.XXXXXXXX")
trap 'rm -rf "$work_dir"' EXIT

fail() {
  echo "Error: $*" >&2
  exit 1
}

for command_name in curl gpg gpgv; do
  command -v "$command_name" >/dev/null 2>&1 || fail "Required command is unavailable: $command_name"
done
[[ -r $release_keyring ]] || fail "Omarchy release keyring is unavailable: $release_keyring"
actual_fingerprint=$(gpg --show-keys --with-colons "$release_keyring" 2>/dev/null |
  awk -F: '$1 == "fpr" { print $10; exit }')
[[ $actual_fingerprint == "$expected_fingerprint" ]] || fail "Omarchy release key fingerprint mismatch"

curl --proto '=https' --tlsv1.2 --fail --location --retry 3 \
  --output "$work_dir/$descriptor_name" "$release_base_url/$descriptor_name"
curl --proto '=https' --tlsv1.2 --fail --location --retry 3 \
  --output "$work_dir/$descriptor_name.sig" "$release_base_url/$descriptor_name.sig"
gpgv --keyring "$release_keyring" "$work_dir/$descriptor_name.sig" "$work_dir/$descriptor_name" >/dev/null 2>&1 ||
  fail "Stable release signature verification failed"

declare -A release=()
while IFS='=' read -r key value; do
  [[ -n $key && -n $value && -z ${release[$key]:-} ]] || fail "Malformed stable release descriptor"
  case "$key" in
    format|track|sequence|version|source_tag|source_commit|minimum_updater_version) release[$key]="$value" ;;
    *) fail "Unknown stable release field: $key" ;;
  esac
done <"$work_dir/$descriptor_name"

[[ ${release[format]:-} == "1" ]] || fail "Unsupported stable release descriptor format"
[[ ${release[track]:-} == "stable-mac" ]] || fail "Release descriptor is not for stable Omarchy Mac"
[[ ${release[sequence]:-} =~ ^[1-9][0-9]*$ ]] || fail "Invalid stable release sequence"
[[ ${release[version]:-} =~ ^[0-9]+\.[0-9]+\.[0-9]+-mac\.[0-9]+$ ]] || fail "Invalid stable release version"
[[ ${release[source_tag]:-} == "v${release[version]}" ]] || fail "Stable release tag and version do not match"
[[ ${release[source_commit]:-} =~ ^[0-9a-f]{40}$ ]] || fail "Invalid stable release source commit"
[[ ${release[minimum_updater_version]:-} =~ ^[1-9][0-9]*$ ]] || fail "Invalid minimum updater version"
(( release[minimum_updater_version] <= 1 )) || fail "This release requires a newer updater"

if [[ -f $state_dir/stable-mac ]]; then
  accepted_sequence=$(sed -n 's/^sequence=//p' "$state_dir/stable-mac")
  [[ $accepted_sequence =~ ^[1-9][0-9]*$ ]] || fail "Installed stable release state is invalid"
  (( release[sequence] >= accepted_sequence )) || fail "Refusing stable release rollback"
fi

if (($#)); then
  [[ -n ${release[$1]:-} ]] || fail "Unknown stable release field: $1"
  printf '%s\n' "${release[$1]}"
else
  cat "$work_dir/$descriptor_name"
fi
