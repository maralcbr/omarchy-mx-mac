#!/bin/bash

# omarchy:summary=Regenerate the boot loader files of an Apple Silicon Mac (GRUB, and Limine when it boots the Mac)
# omarchy:requires-sudo=true
# omarchy:hidden=true

# Every flow that changes the kernel command line or the initramfs (the
# encrypt flow, the owner's re-key, a fresh install, the factory reset) calls
# this instead of update-grub. A Limine Mac gets its command line re-derived
# from GRUB's defaults file, its UKI and entries rebuilt, and the packaged
# Limine on the ESP; a GRUB Mac regenerates GRUB.

set -uo pipefail

if ! omarchy-mac-limine-active; then
  update-grub || { echo "omarchy-mac-boot-update: update-grub failed" >&2; exit 1; }
  exit 0
fi
omarchy-mac-limine-cmdline || { echo "omarchy-mac-boot-update: could not derive the Limine command line" >&2; exit 1; }
limine-update || { echo "omarchy-mac-boot-update: limine-update failed" >&2; exit 1; }
omarchy-mac-limine-deploy || exit 1
