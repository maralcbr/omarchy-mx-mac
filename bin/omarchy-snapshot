#!/bin/bash

# omarchy:summary=Create or restore system snapshots with snapper
# omarchy:args=<create|restore [number]|prune-previous>
# omarchy:requires-sudo=true

set -e

COMMAND="$1"

if [[ -z $COMMAND ]]; then
  echo "Usage: omarchy-snapshot <create|restore [number]|prune-previous>" >&2
  exit 1
fi

if omarchy-cmd-missing snapper; then
  exit 127 # omarchy-update can use this to just ignore if snapper is not available
fi

apple_silicon() {
  ! omarchy-cmd-missing omarchy-hw-apple-silicon && omarchy-hw-apple-silicon
}

# An Apple Silicon Mac that boots Limine (install/hardware/apple/limine-boot.sh)
# has the x86 snapshot tooling: the snapper plugin writes its entries and
# limine-snapper-restore restores. GRUB Macs use the Mac tools.
apple_limine() {
  apple_silicon && ! omarchy-cmd-missing omarchy-mac-limine-active && omarchy-mac-limine-active
}

case "$COMMAND" in
create)
  # The description is just a label, so never let it abort the snapshot.
  DESC="$(omarchy-version 2>/dev/null || echo unknown)"

  # Get existing snapper config names from CSV output
  mapfile -t CONFIGS < <(sudo snapper --csvout list-configs | awk -F, 'NR>1 {print $1}')

  # Snapper installed but unconfigured snapshots nothing. Staying quiet here
  # reads as a successful snapshot, so the next update looks recoverable when
  # nothing has ever been captured.
  if (( ${#CONFIGS[@]} == 0 )); then
    echo -e "\e[33mNo Snapper configs found, so no snapshot was created.\e[0m" >&2
    echo "Configure Snapper with: sudo bash -euo pipefail \"$OMARCHY_PATH/install/config/snapper.sh\"" >&2
    exit 1
  fi

  echo -e "\e[32mCreate system snapshot\e[0m"

  for config in "${CONFIGS[@]}"; do
    sudo snapper -c "$config" create -c number -d "$DESC"
    sudo snapper -c "$config" cleanup number
  done

  if apple_silicon && ! apple_limine; then
    # Bootable entries come from grub-btrfs, refreshed here; 127 means the
    # package is not installed yet, which is not a failed snapshot.
    sudo omarchy-mac-snapshot-menu refresh || (($? == 127)) ||
      echo -e "\e[33mThe GRUB snapshot menu could not be refreshed; the snapshot itself was created.\e[0m" >&2
  fi
  echo "Snapshots can be selected during boot."
  ;;
restore)
  # A GRUB Mac restores by swapping the root subvolume from the running
  # system and rebooting; a Limine Mac restores as x86 does.
  if apple_silicon && ! apple_limine; then
    sudo omarchy-mac-snapshot-restore "${@:2}"
  else
    if (( $# > 1 )); then
      echo "limine-snapper-restore picks the snapshot itself; run omarchy-snapshot restore without a number." >&2
      exit 64
    fi
    sudo limine-snapper-restore
  fi
  ;;
prune-previous)
  if apple_silicon && ! apple_limine; then
    sudo omarchy-mac-snapshot-restore --prune-previous
  elif apple_silicon; then
    echo "A Limine restore keeps the previous root as a snapper snapshot; remove it with snapper delete." >&2
    exit 1
  else
    echo "prune-previous applies to Apple Silicon GRUB restores only." >&2
    exit 1
  fi
  ;;
esac
