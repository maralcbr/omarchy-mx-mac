#!/bin/bash
# omarchy:summary=Reinstall the Omarchy source directory from git
set -e

# Reinstall the Omarchy configuration directory from the git source.

repo_url="${OMARCHY_REPO_URL:-$(git -C "$OMARCHY_PATH" remote get-url origin)}"
branch="${OMARCHY_REF:-$(git -C "$OMARCHY_PATH" branch --show-current)}"

git clone --depth=1 --branch "$branch" "$repo_url" ~/.local/share/omarchy-new >/dev/null
mv "$OMARCHY_PATH" ~/.local/share/omarchy-old
mv ~/.local/share/omarchy-new "$OMARCHY_PATH"
