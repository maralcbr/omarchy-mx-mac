#!/bin/bash

# omarchy:summary=Update Omarchy and system packages
# omarchy:args=[-y]
# omarchy:examples=omarchy update | omarchy update -y
# omarchy:requires-sudo=true

set -e

if [[ -z ${OMARCHY_UPDATE_LOGGED:-} ]]; then
  script_command=$(printf '%q ' "$0" "$@")
  exec env OMARCHY_UPDATE_LOGGED=1 script -qefc "$script_command" "/tmp/omarchy-update.log"
fi

if ! omarchy-update-lock held; then
  exec omarchy-update-lock run "$0" "$@"
fi

trap 'echo ""; echo -e "\033[0;31mSomething went wrong during the update!\n\nPlease review the output above carefully, correct the error, and retry the update.\n\nIf you need assistance, get help from the community at https://omarchy.org/discord\033[0m"' ERR
cleanup_update() {
  local status=$?

  trap - EXIT
  omarchy-update-stay-awake stop || true
  exit "$status"
}

trap cleanup_update EXIT

omarchy-update-requires-free-space

# -y is a promise not to ask anything. Steps that would need an answer report
# and move on instead of waiting on a prompt nobody is here to give.
[[ ${1:-} != "-y" ]] || export OMARCHY_UPDATE_UNATTENDED=1

if [[ ${1:-} == "-y" ]] || omarchy-update-confirm; then
  # Before the snapshot, so the pruned cache is not what the snapshot records.
  # The cache lives on its own @pkg subvolume outside the snapshot on every
  # layout; the order is kept so a snapshot never captures a half-pruned cache.
  omarchy-update-pkg-prune

  # 127 means Snapper is deliberately absent. Any other failure already said
  # what went wrong, and a missing snapshot is not worth blocking an update
  # over, but it must not pass for one either.
  omarchy-snapshot create || (($? == 127)) ||
    echo -e "\e[33mContinuing the update without a snapshot.\e[0m" >&2

  omarchy-update-stay-awake start

  omarchy-update-dev
  if omarchy-hw-apple-silicon; then
    # set +e does not stop the ERR banner; a status taken with || does, so only a real failure shows it.
    bundle_status=0
    omarchy-update-asahi-bundle --yes || bundle_status=$?
    if (( bundle_status == 3 )); then
      echo "Apple Silicon bundle update deferred because its release channel is unavailable." >&2
    else
      (( bundle_status == 0 )) || (exit "$bundle_status")
    fi
    # The [omarchy] repository the ISO pinned stays on its install-time snapshot
    # otherwise; move it to the newest promoted snapshot before the package sync
    # so the system upgrade below reads current packages.
    repository_status=0
    omarchy-update-asahi-repository --yes || repository_status=$?
    # A repoint that fails leaves the previous signed snapshot pinned, which is
    # still a valid repository, so the system upgrade below carries on rather
    # than taking the whole update down with it.
    if (( repository_status == 3 )); then
      echo "Apple Silicon package repository update deferred because its release listing is unavailable." >&2
    elif (( repository_status != 0 )); then
      echo "Apple Silicon package repository update failed; continuing with the pinned snapshot." >&2
    fi
  fi
  omarchy-update-keyring

  # Migrations ship with the packages installed here and are written against
  # them, so everything below waits on this finishing. An upgrade that stopped
  # takes the update with it rather than migrating against what is still on disk.
  # 3 is a repository mid-transition: the step has already said to try again
  # later, and the failure banner would contradict it.
  packages_status=0
  omarchy-update-system-pkgs || packages_status=$?
  if (( packages_status == 3 )); then trap - ERR; fi
  (( packages_status == 0 )) || (exit "$packages_status")
  omarchy-migrate
  # Completion before migrations can fail on leftover linux-asahi-headers; that
  # failure is swallowed so this migrate can swap them. Prove the switch again
  # now so the same update can finish.
  reboot_blocked=${OMARCHY_REBOOT_BLOCKED:-/run/omarchy-reboot-blocked}
  aurora_unverified=0
  if omarchy-hw-apple-silicon; then
    aurora_complete_status=0
    omarchy-update-aurora-repository --complete || aurora_complete_status=$?
    if (( aurora_complete_status != 0 )); then
      aurora_unverified=1
      [[ -e $reboot_blocked ]] ||
        sudo tee "$reboot_blocked" >/dev/null <<<"the Aurora kernel switch could not be verified" || true
    fi
  fi
  omarchy-hook post-update
  if omarchy-hw-apple-silicon && [[ -f /var/lib/omarchy/asahi-quattro-release.pending ]]; then
    sudo mv /var/lib/omarchy/asahi-quattro-release.pending /var/lib/omarchy/asahi-quattro-release
  fi
  omarchy-update-aur-pkgs
  omarchy-update-mise
  omarchy-update-orphan-pkgs

  omarchy-update-analyze-logs
  omarchy-update-status

  # Release update-owned inhibitors before offering a reboot. A confirmed
  # reboot can terminate this process before its EXIT trap gets a chance to
  # remove the persistent Stay Awake marker.
  omarchy-update-stay-awake stop
  trap - EXIT

  (( aurora_unverified )) || omarchy-update-restart
  # An unverified kernel switch is not a finished update, even when the
  # reboot-block marker could not be written.
  if (( aurora_unverified )) || [[ -e $reboot_blocked ]]; then
    if [[ -e $reboot_blocked ]]; then
      echo -e "\e[31mThe update is not finished: $(head -n 1 "$reboot_blocked").\e[0m" >&2
    else
      echo -e "\e[31mThe update is not finished: the Aurora kernel switch could not be verified.\e[0m" >&2
    fi
    exit 1
  fi
fi
