#!/bin/bash

# omarchy:summary=Pull the latest Omarchy git changes

set -e

echo -e "\e[32mUpdate Omarchy\e[0m"

omarchy-update-time

# Suppress Hyprland config errors while git updates default config files mid-pull
hyprctl keyword debug:suppress_errors true &>/dev/null || true

git -C "$OMARCHY_PATH" fetch origin --prune --no-tags
git -C "$OMARCHY_PATH" pull --autostash
git -C "$OMARCHY_PATH" --no-pager diff --check || git -C "$OMARCHY_PATH" reset --merge

hyprctl reload &>/dev/null || true

# Update version file from latest Mac release tag. Official Omarchy tags can
# point at different commits in this fork, so only use the -mac tag namespace.
latest_tag=""
while IFS= read -r tag; do
  latest_tag="$tag"
  break
done < <(git -C "$OMARCHY_PATH" tag --merged HEAD --list "v*-mac.*" --sort=-version:refname)

if [[ -n $latest_tag ]]; then
  echo "${latest_tag#v}" > "$OMARCHY_PATH/version"
fi
