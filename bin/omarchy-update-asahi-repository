#!/bin/bash

# omarchy:summary=Repoint the Apple Silicon package repository at the newest signed stable snapshot
# omarchy:args=[--check] [--yes] [--bootstrap]
# omarchy:hidden=true
# omarchy:requires-sudo=true

# The ISO bakes an immutable asahi-packages-stable-<commit> snapshot into the
# [omarchy] Server line of /etc/pacman.conf and nothing revisits it. This
# follows the signed package channel instead: asahi-packages-channel-<S>, found
# through an R2 pointer, names the promoted stable snapshot, the digest of its
# descriptor, and every older stable commit it supersedes. The Server moves only
# from one of those superseded snapshots, after the descriptor is proven to come
# from the shipped Omarchy ARM repository subkey for that exact source commit;
# any other Server is left alone. Only the Server line of the existing [omarchy]
# block changes. Every other repository, boot, GRUB, mkinitcpio, and
# NetworkManager path stays untouched.
#
# --bootstrap (with --yes) is the fresh installer's first step on a clean Asahi
# Arch system, before its first package transaction. Every check above still
# runs, and so do the database checks an up-to-date or preserved pin normally
# skips. With no [omarchy] section it writes one for the channel's snapshot
# before the first repository. With one section and one Server it keeps that
# Server, moves the section before the first repository, repairs its SigLevel,
# trusts both Omarchy keys, and then applies the ordinary move rules. Several
# sections or Servers are refused untouched.

set -euo pipefail

repo="${OMARCHY_ASAHI_REPOSITORY_REPO:-maralcbr/omarchy-pkgs}"
state_file="${OMARCHY_ASAHI_REPOSITORY_STATE:-/var/lib/omarchy/asahi-package-repository}"
trusted_key=C81AC3E2A99556F9B21D5FEA3DD49BC9F8360BDC
trusted_subkey=CAB18E175BFB9ACCE185234474DE0C737AC186E4
trusted_key_file="${OMARCHY_ASAHI_PACKAGE_KEY_FILE:-/usr/share/omarchy/default/omarchy-arm-repository.asc}"
release_trusted_key=5983B1CA32CB778F4D74D24ECFF35022CA5B5959
release_trusted_key_file="${OMARCHY_ASAHI_KEY_FILE:-/usr/share/omarchy/default/omarchy-release.gpg}"
channel_size_limit=131072
channel_entry_limit=2048
mode=update
yes=0
bootstrap=0

fail() {
  echo "Apple Silicon package repository update: $*" >&2
  exit 2
}

while (($#)); do
  case "$1" in
    --check) mode=check ;;
    -y|--yes) yes=1 ;;
    --bootstrap) bootstrap=1 ;;
    -h|--help)
      echo "Usage: omarchy-update-asahi-repository [--check] [--yes] [--bootstrap]"
      exit 0
      ;;
    *) fail "unknown option '$1'" ;;
  esac
  shift
done
if (( bootstrap )); then
  [[ $mode != "check" ]] || fail "--bootstrap cannot be combined with --check"
  (( yes )) || fail "--bootstrap requires --yes"
fi

omarchy-hw-apple-silicon || exit 1

root_path() {
  printf '%s%s\n' "${OMARCHY_ASAHI_ROOT:-}" "$1"
}

required_commands=(curl gpg jq sha256sum)
(( ! bootstrap )) || required_commands+=(pacman-conf)
for command in "${required_commands[@]}"; do
  omarchy-cmd-present "$command" || fail "$command is required"
done

workdir=$(mktemp -d)
trap 'rm -rf "$workdir"' EXIT
gnupg_dir="$workdir/gnupg"
release_gnupg_dir="$workdir/release-gnupg"
mkdir -m 0700 "$gnupg_dir" "$release_gnupg_dir"
[[ -r $trusted_key_file ]] || fail "trusted Omarchy ARM repository key is not installed"
actual_fingerprint=$(gpg --batch --show-keys --with-colons "$trusted_key_file" 2>/dev/null |
  awk -F: '$1 == "fpr" { print $10; exit }')
[[ $actual_fingerprint == "$trusted_key" ]] || fail "trusted Omarchy ARM repository key fingerprint does not match"
gpg --batch --homedir "$gnupg_dir" --import "$trusted_key_file" >/dev/null 2>&1 || fail "could not load the trusted Omarchy ARM repository key"
subkey_kind=$(gpg --batch --homedir "$gnupg_dir" --with-colons --list-keys 2>/dev/null |
  awk -F: -v wanted="$trusted_subkey" '
    $1 == "pub" || $1 == "sub" { kind=$1; next }
    $1 == "fpr" && $10 == wanted { print kind; exit }
  ')
[[ $subkey_kind == "sub" ]] || fail "trusted Omarchy ARM repository key does not carry the signing subkey"
[[ -r $release_trusted_key_file ]] || fail "trusted Omarchy release signing key is not installed"
actual_fingerprint=$(gpg --batch --show-keys --with-colons "$release_trusted_key_file" 2>/dev/null |
  awk -F: '$1 == "fpr" { print $10; exit }')
[[ $actual_fingerprint == "$release_trusted_key" ]] || fail "trusted Omarchy release signing key fingerprint does not match"
gpg --batch --homedir "$release_gnupg_dir" --import "$release_trusted_key_file" >/dev/null 2>&1 || fail "could not load the trusted Omarchy release signing key"

download() {
  curl --fail --location --silent --show-error --proto '=https' --tlsv1.2 "$1" --output "$2" || {
    echo "Apple Silicon package repository update: ${3:-could not download $1}" >&2
    exit 3
  }
}

verify_signature() {
  local file="$1" signature="$2" status
  [[ -s $file && -s $signature ]] || fail "missing signed asset $(basename "$file")"
  status=$(gpg --batch --homedir "$gnupg_dir" --status-fd 1 --verify "$signature" "$file" 2>/dev/null) ||
    fail "signature verification failed for $(basename "$file")"
  awk -v key="$trusted_subkey" '$2 == "VALIDSIG" && $3 == key { valid=1 } END { exit !valid }' <<<"$status" ||
    fail "$(basename "$file") was not signed by the Omarchy ARM repository signing subkey"
}

verify_release_signature() {
  local file="$1" signature="$2" status
  [[ -s $file && -s $signature ]] || fail "missing signed asset $(basename "$file")"
  status=$(gpg --batch --homedir "$release_gnupg_dir" --status-fd 1 --verify "$signature" "$file" 2>/dev/null) ||
    fail "signature verification failed for $(basename "$file")"
  awk -v key="$release_trusted_key" '$2 == "VALIDSIG" && ($3 == key || $NF == key) { valid=1 } END { exit !valid }' <<<"$status" ||
    fail "$(basename "$file") was not signed by the trusted Omarchy release key"
}

# Compare raw bytes with the canonical body so newline stripping cannot hide trailing junk, CRs or NULs.
read_pointer_sequence() {
  local file="$1" body="" size sequence canonical
  local pattern=$'^format=1\nsequence=([1-9][0-9]{0,8})\n'
  [[ -f $file ]] && size=$(wc -c <"$file") || return 1
  (( size <= 256 )) || return 1
  IFS= read -r -d '' body <"$file" || true
  [[ $body =~ $pattern ]] || return 1
  sequence=${BASH_REMATCH[1]}
  printf -v canonical 'format=1\nsequence=%s\ntag=asahi-packages-channel-%s\n' "$sequence" "$sequence"
  [[ $body == "$canonical" ]] && (( size == ${#canonical} )) || return 1
  printf '%s\n' "$sequence"
}

declare -A superseded=()
# The C locale keeps byte counts and the sort-order check independent of the user's locale.
read_channel() {
  local file="$1" body="" size entries=() entry previous="" LC_ALL=C
  local pattern=$'^format=1\nchannel=asahi-packages\nsequence=([1-9][0-9]{0,8})\nstable_tag=asahi-packages-stable-([0-9a-f]{40})\ndescriptor_sha256=([0-9a-f]{64})\nsupersedes=([0-9a-f,]*)\n$'
  size=$(wc -c <"$file")
  (( size <= channel_size_limit )) || fail "the signed package channel is larger than 128 KiB"
  IFS= read -r -d '' body <"$file" || true
  [[ $body =~ $pattern ]] && (( size == ${#body} )) || fail "the signed package channel is malformed"
  channel_sequence=${BASH_REMATCH[1]}
  stable_commit=${BASH_REMATCH[2]}
  channel_descriptor=${BASH_REMATCH[3]}
  local field=${BASH_REMATCH[4]}
  [[ -n $field ]] || return 0
  IFS=, read -r -a entries <<<"$field"
  (( ${#entries[@]} <= channel_entry_limit )) || fail "the signed package channel supersedes more than $channel_entry_limit snapshots"
  # read drops a trailing empty field, so only the joined length exposes a stray comma.
  (( ${#entries[@]} * 41 - 1 == ${#field} )) || fail "the signed package channel has a malformed supersedes list"
  for entry in "${entries[@]}"; do
    [[ $entry =~ ^[0-9a-f]{40}$ ]] || fail "the signed package channel has a malformed supersedes list"
    [[ -z $previous || $previous < $entry ]] || fail "the signed package channel supersedes list is not sorted and unique"
    [[ $entry != "$stable_commit" ]] || fail "the signed package channel supersedes its own snapshot"
    superseded[$entry]=1
    previous=$entry
  done
}

# Preserved pins and older channels are not updates, and nothing is written for them.
leave() {
  # A check's stdout is the update list, so a pin that is not moving explains itself on stderr there.
  if [[ $mode == "check" ]]; then
    echo "Apple Silicon package repository: $*" >&2
    exit 1
  fi
  echo "Apple Silicon package repository: $*"
  exit 0
}

installed_tag="" installed_source="" installed_descriptor="" installed_sequence=0
if [[ -e $state_file ]]; then
  if [[ ${OMARCHY_ASAHI_TESTING:-0} != 1 ]]; then
    permissions=$(stat -c '%a' "$state_file")
    [[ $(stat -c '%u' "$state_file") == 0 ]] || fail "repository state is not root-owned"
    (( (8#$permissions & 8#022) == 0 )) || fail "repository state is writable by non-root users"
  fi
  state_format="" state_run="" state_sequence="" state_has_sequence=0
  while IFS= read -r line; do
    case "$line" in
      format=*) state_format=${line#format=} ;;
      tag=*) installed_tag=${line#tag=} ;;
      source_commit=*) installed_source=${line#source_commit=} ;;
      workflow_run=*) state_run=${line#workflow_run=} ;;
      descriptor_sha256=*) installed_descriptor=${line#descriptor_sha256=} ;;
      channel_sequence=*) state_sequence=${line#channel_sequence=} state_has_sequence=1 ;;
      "") ;;
      *) fail "repository state is malformed" ;;
    esac
  done <"$state_file"
  [[ $state_format == "1" && $installed_tag =~ ^asahi-packages-stable-[0-9a-f]{40}$ ]] || fail "repository state is malformed"
  [[ $installed_source =~ ^[0-9a-f]{40}$ && $state_run =~ ^[1-9][0-9]*$ && $installed_descriptor =~ ^[0-9a-f]{64}$ ]] ||
    fail "repository state is malformed"
  # State written before the package channel existed has no channel_sequence.
  if (( state_has_sequence )); then
    [[ $state_sequence =~ ^[1-9][0-9]{0,8}$ ]] || fail "repository state is malformed"
    installed_sequence=$state_sequence
  fi
fi

pacman_conf=$(root_path /etc/pacman.conf)
[[ -r $pacman_conf ]] || fail "pacman configuration is missing"
for repository in asahi-alarm core extra alarm aur; do
  grep -Eq "^[[:space:]]*\[$repository\][[:space:]]*$" "$pacman_conf" || fail "required [$repository] repository is missing"
done
block_count=$(grep -Ec '^[[:space:]]*\[omarchy\][[:space:]]*$' "$pacman_conf" || true)
current_server=""
if (( ! bootstrap || block_count != 0 )); then
  (( block_count == 1 )) || fail "pacman configuration must contain exactly one [omarchy] repository"
  current_servers=$(awk '
    /^[[:space:]]*\[omarchy\][[:space:]]*$/ { inside = 1; next }
    inside && /^[[:space:]]*\[[^]]+\][[:space:]]*$/ { inside = 0 }
    inside && /^[[:space:]]*Server[[:space:]]*=/ { sub(/^[[:space:]]*Server[[:space:]]*=[[:space:]]*/, ""); sub(/[[:space:]]+$/, ""); print }
  ' "$pacman_conf")
  # Byte-identical copies are one Server to install/hardware/pacman.sh, and the repair collapses them.
  (( ! bootstrap )) || current_servers=$(sort -u <<<"$current_servers")
  [[ -n $current_servers ]] || fail "[omarchy] repository must have exactly one Server"
  if (( $(wc -l <<<"$current_servers") != 1 )); then
    if (( bootstrap )); then
      echo "Apple Silicon package repository update: [omarchy] lists several Servers; keep one and try again:" >&2
      while IFS= read -r listed_server; do
        printf '  %s\n' "$listed_server" >&2
      done <<<"$current_servers"
    fi
    fail "[omarchy] repository must have exactly one Server"
  fi
  current_server=$current_servers
fi
stable_prefix="https://github.com/$repo/releases/download/asahi-packages-stable-"
# install/hardware/pacman.sh pins the legacy asahi-packages-<commit> release; candidate and channel tags never match 40 hex.
legacy_prefix="https://github.com/$repo/releases/download/asahi-packages-"
current_commit=""
if [[ $current_server == "$stable_prefix"* && ${current_server#"$stable_prefix"} =~ ^[0-9a-f]{40}$ ]]; then
  current_commit=${current_server#"$stable_prefix"}
elif [[ $current_server == "$legacy_prefix"* && ${current_server#"$legacy_prefix"} =~ ^[0-9a-f]{40}$ ]]; then
  current_commit=${current_server#"$legacy_prefix"}
fi

channel_tag=""
if [[ -n ${OMARCHY_ASAHI_PACKAGES_CHANNEL_URL:-} ]]; then
  channel_url=$OMARCHY_ASAHI_PACKAGES_CHANNEL_URL
  channel_signature_url="${OMARCHY_ASAHI_PACKAGES_CHANNEL_SIGNATURE_URL:-$channel_url.sig}"
else
  pointer_url="${OMARCHY_ASAHI_PACKAGES_POINTER_URL:-https://downloads.aicodelabs.com.au/pointers/asahi-packages-channel}"
  listing_failure="" pointer_status=0
  # The unsigned pointer only picks which signed channel to fetch; every check below still applies.
  curl --fail --location --silent --proto '=https' --tlsv1.2 --max-time 20 --max-filesize 256 \
    "$pointer_url" --output "$workdir/pointer" || pointer_status=$?
  # curl exits 63 when the body exceeds --max-filesize: the server answered, so that is malformed, not unreachable.
  if (( pointer_status == 0 )) && pointer_sequence=$(read_pointer_sequence "$workdir/pointer"); then
    if (( pointer_sequence >= installed_sequence )); then
      channel_tag="asahi-packages-channel-$pointer_sequence"
    else
      echo "Apple Silicon package repository update: package channel pointer ($pointer_sequence) is behind this Mac ($installed_sequence)" >&2
      listing_failure="package channel pointer is behind this Mac and the GitHub release listing is unavailable; nothing changed"
    fi
  elif (( pointer_status == 0 || pointer_status == 63 )); then
    echo "Apple Silicon package repository update: package channel pointer is malformed; using the GitHub release listing" >&2
  fi

  if [[ -z $channel_tag ]]; then
    releases_api_url="${OMARCHY_ASAHI_RELEASES_API_URL:-https://api.github.com/repos/$repo/releases?per_page=100}"
    # Releases come back newest first and channels are published one at a time,
    # so the highest channel is on the first page that holds any channel. Keep
    # paging only while a page is full and held none.
    for page in 1 2 3 4 5; do
      page_url=$releases_api_url
      (( page > 1 )) && page_url="$releases_api_url&page=$page"
      download "$page_url" "$workdir/releases.json" "$listing_failure"
      channel_tag=$(jq -er '
        [
          .[]
          | select(.draft == false and .prerelease == false)
          | select(.tag_name | test("^asahi-packages-channel-[1-9][0-9]{0,8}$"))
          | { tag: .tag_name, sequence: (.tag_name | sub("^asahi-packages-channel-"; "") | tonumber) }
        ]
        | max_by(.sequence).tag
      ' "$workdir/releases.json" 2>/dev/null) && [[ -n $channel_tag ]] && break
      channel_tag=""
      (( $(jq -r 'length' "$workdir/releases.json" 2>/dev/null || echo 0) == 100 )) || break
    done
    if [[ -z $channel_tag ]]; then
      echo "Apple Silicon package repository update: could not discover a signed Apple Silicon package channel" >&2
      exit 3
    fi
  fi
  channel_url="https://github.com/$repo/releases/download/$channel_tag/asahi-packages-channel"
  channel_signature_url="$channel_url.sig"
fi

channel_file="$workdir/asahi-packages-channel"
channel_status=0
curl --fail --location --silent --show-error --proto '=https' --tlsv1.2 --max-filesize "$channel_size_limit" \
  "$channel_url" --output "$channel_file" || channel_status=$?
(( channel_status != 63 )) || fail "the signed package channel is larger than 128 KiB"
if (( channel_status != 0 )); then
  echo "Apple Silicon package repository update: could not download $channel_url" >&2
  exit 3
fi
download "$channel_signature_url" "$channel_file.sig"
verify_release_signature "$channel_file" "$channel_file.sig"
read_channel "$channel_file"
[[ -z $channel_tag || $channel_sequence == "${channel_tag#asahi-packages-channel-}" ]] ||
  fail "channel release $channel_tag carries sequence $channel_sequence"

tag="asahi-packages-stable-$stable_commit"
source_commit=$stable_commit
server="$stable_prefix$stable_commit"

if [[ -n $installed_tag ]]; then
  [[ $installed_tag != "$tag" || $installed_descriptor == "$channel_descriptor" ]] ||
    fail "repository state contradicts the signed channel: $tag has a different descriptor"
  (( installed_sequence != channel_sequence )) || [[ $installed_tag == "$tag" ]] ||
    fail "repository state contradicts the signed channel: sequence $channel_sequence names $tag"
fi

# Why the current Server stays. A normal run stops there; a bootstrap still
# verifies the target and repairs the section around the kept Server.
keep_reason=""
# Runs before the move rules: a superseded pin still must not follow a channel below this Mac's.
if (( channel_sequence < installed_sequence )); then
  [[ -n $current_server ]] ||
    fail "package channel $channel_sequence is older than channel $installed_sequence recorded on this Mac; nothing changed"
  keep_reason="package channel $channel_sequence is older than channel $installed_sequence on this Mac; leaving [omarchy] unchanged"
elif [[ -n $current_server && $current_server != "$server" ]]; then
  if [[ -z $current_commit ]]; then
    keep_reason="unrecognised [omarchy] Server; not moving it"
  # A legacy pin on the target's own commit is still moved, onto the stable release of that commit.
  elif [[ -z ${superseded[$current_commit]:-} && $current_commit != "$stable_commit" ]]; then
    keep_reason="the pinned package set ${current_commit:0:8} is not older than channel $channel_sequence (${stable_commit:0:8}); leaving it"
  fi
fi
[[ -z $keep_reason ]] || (( bootstrap )) || leave "$keep_reason"
final_server=$server
[[ -z $keep_reason ]] || final_server=$current_server

base="${OMARCHY_ASAHI_RELEASE_BASE_URL:-$server}"
base=${base%/}
download "$base/CANDIDATE" "$workdir/CANDIDATE"
download "$base/CANDIDATE.sig" "$workdir/CANDIDATE.sig"
descriptor_sha256=$(sha256sum "$workdir/CANDIDATE" | cut -d' ' -f1)
[[ $descriptor_sha256 == "$channel_descriptor" ]] || fail "the CANDIDATE of $tag does not match the signed package channel"
verify_signature "$workdir/CANDIDATE" "$workdir/CANDIDATE.sig"

format="" channel="" release_tag="" descriptor_source="" workflow_run="" runner_arch=""
signing_fingerprint="" package_count="" package_records=0
declare -A seen_headers=() assets=()
set_header() {
  local name=$1 value=$2
  [[ -z ${seen_headers[$name]:-} ]] || fail "duplicate descriptor header '$name'"
  printf -v "$name" '%s' "$value"
  seen_headers[$name]=1
}
while IFS= read -r line; do
  case "$line" in
    format=*) set_header format "${line#format=}" ;;
    channel=*) set_header channel "${line#channel=}" ;;
    release_tag=*) set_header release_tag "${line#release_tag=}" ;;
    source_commit=*) set_header descriptor_source "${line#source_commit=}" ;;
    workflow_run=*) set_header workflow_run "${line#workflow_run=}" ;;
    runner_arch=*) set_header runner_arch "${line#runner_arch=}" ;;
    signing_fingerprint=*) set_header signing_fingerprint "${line#signing_fingerprint=}" ;;
    package_count=*) set_header package_count "${line#package_count=}" ;;
    package=*)
      IFS='|' read -r index package version architecture filename archive_sha signature_filename signature_sha extra <<<"${line#package=}"
      [[ -z $extra && $index =~ ^[1-9][0-9]*$ ]] || fail "invalid package record index"
      (( index == package_records + 1 )) || fail "invalid package record index"
      [[ $package =~ ^[a-z0-9@._+-]+$ && -n $version && $architecture =~ ^(aarch64|any)$ ]] || fail "invalid package record"
      [[ $filename =~ ^[A-Za-z0-9._+@-]+\.pkg\.tar\.[A-Za-z0-9.]+$ && $signature_filename == "$filename.sig" ]] || fail "invalid package filename"
      [[ $archive_sha =~ ^[0-9a-f]{64}$ && $signature_sha =~ ^[0-9a-f]{64}$ ]] || fail "invalid package checksum"
      ((package_records += 1))
      ;;
    asset=*)
      IFS='|' read -r filename asset_sha extra <<<"${line#asset=}"
      [[ -z $extra && $filename =~ ^[A-Za-z0-9._-]+$ && $asset_sha =~ ^[0-9a-f]{64}$ ]] || fail "invalid asset record"
      [[ -z ${assets[$filename]:-} ]] || fail "duplicate asset record"
      assets[$filename]=$asset_sha
      ;;
    "") ;;
    *) fail "unknown descriptor entry" ;;
  esac
done <"$workdir/CANDIDATE"

[[ $format == "1" && $channel == "candidate" ]] || fail "unsupported release descriptor"
[[ $release_tag == "asahi-packages-candidate-$source_commit" ]] || fail "release descriptor was not promoted from the candidate for $source_commit"
[[ $descriptor_source == "$source_commit" ]] || fail "release descriptor source commit does not match the stable tag"
[[ $workflow_run =~ ^[1-9][0-9]*$ && $runner_arch == "aarch64" ]] || fail "invalid build identity"
[[ $signing_fingerprint == "$trusted_subkey" ]] || fail "release descriptor names a different signing subkey"
[[ $package_count =~ ^[1-9][0-9]*$ ]] || fail "release descriptor package count is invalid"
(( package_records == package_count )) || fail "release descriptor package count is invalid"
for asset in omarchy.db omarchy.db.sig omarchy.files omarchy.files.sig; do
  [[ -n ${assets[$asset]:-} ]] || fail "release descriptor is missing $asset"
done

write_state() {
  printf 'format=1\ntag=%s\nsource_commit=%s\nworkflow_run=%s\ndescriptor_sha256=%s\nchannel_sequence=%s\n' \
    "$tag" "$source_commit" "$workflow_run" "$descriptor_sha256" "$channel_sequence" >"$workdir/state"
  sudo install -D -o root -g root -m 0644 "$workdir/state" "$state_file"
}

if [[ $current_server == "$server" ]] && (( ! bootstrap )); then
  [[ $mode != "check" ]] || exit 1
  # Also completes a switch interrupted between the pacman.conf write and the state write.
  if [[ $installed_tag != "$tag" ]] || (( installed_sequence < channel_sequence )); then
    write_state
  fi
  echo "Apple Silicon package repository is up to date"
  exit 0
fi

if [[ $mode == "check" ]]; then
  echo "Apple Silicon package repository $tag is available"
  exit 0
fi

download "$base/omarchy.db" "$workdir/omarchy.db"
download "$base/omarchy.db.sig" "$workdir/omarchy.db.sig"
[[ $(sha256sum "$workdir/omarchy.db" | cut -d' ' -f1) == "${assets[omarchy.db]}" ]] || fail "omarchy.db does not match the signed descriptor"
[[ $(sha256sum "$workdir/omarchy.db.sig" | cut -d' ' -f1) == "${assets[omarchy.db.sig]}" ]] || fail "omarchy.db.sig does not match the signed descriptor"
verify_signature "$workdir/omarchy.db" "$workdir/omarchy.db.sig"

if (( ! yes )); then
  gum confirm "Switch the Apple Silicon package repository to $tag?" </dev/tty || exit 0
fi

backup="$(root_path /var/lib/omarchy/backups)/asahi-repository-$(date +%Y%m%d%H%M%S)"
backup_tmp=$(mktemp -d)
cp "$pacman_conf" "$backup_tmp/pacman.conf"
config_paths=("$pacman_conf")
[[ ! -d $(root_path /etc/pacman.d) ]] || config_paths+=("$(root_path /etc/pacman.d)")
sudo find "${config_paths[@]}" -type f -exec sha256sum {} + >"$backup_tmp/config-sha256.txt"
sudo install -d -o root -g root -m 0700 "$backup"
sudo cp -a "$backup_tmp"/. "$backup/"
rm -rf "$backup_tmp"

if (( bootstrap )); then
  # A fresh system trusts neither key: legacy and candidate releases are signed
  # by the release key, stable snapshots by the ARM repository subkey. Both
  # files passed their fingerprint checks above.
  trust_key() {
    sudo pacman-key --finger "$1" >/dev/null 2>&1 || sudo pacman-key --add "$2"
    sudo pacman-key --lsign-key "$1"
  }
  trust_key "$release_trusted_key" "$release_trusted_key_file"
  trust_key "$trusted_key" "$trusted_key_file"
elif ! sudo pacman-key --finger "$trusted_key" >/dev/null 2>&1; then
  sudo pacman-key --add "$trusted_key_file"
  sudo pacman-key --lsign-key "$trusted_key"
fi

if (( bootstrap )); then
  first_repository=$(awk '
    /^[[:space:]]*\[[^]]+\][[:space:]]*$/ && !/^[[:space:]]*\[options\][[:space:]]*$/ {
      sub(/^[[:space:]]*\[/, ""); sub(/\][[:space:]]*$/, ""); print; exit
    }
  ' "$pacman_conf")
  relocate=0
  [[ $first_repository == "omarchy" ]] || relocate=1
  # The section holds exactly SigLevel and Server. It is rewritten where it
  # stands when it already leads the repositories and otherwise placed before
  # the first one, so the Omarchy Hyprland stack wins over Arch Linux ARM's.
  # Comments stay where they were; every other line is copied.
  awk -v server="$final_server" -v relocate="$relocate" '
    function section() { return $0 ~ /^[[:space:]]*\[[^]]+\][[:space:]]*$/ }
    function emit() {
      print "[omarchy]"
      print "SigLevel = Required DatabaseOptional"
      print "Server = " server
    }
    section() { inside = 0 }
    /^[[:space:]]*\[omarchy\][[:space:]]*$/ { inside = 1; if (!relocate) emit(); next }
    relocate && !placed && section() && !/^[[:space:]]*\[options\][[:space:]]*$/ { emit(); print ""; placed = 1 }
    inside && /^[[:space:]]*[^#[:space:]]/ { next }
    inside && relocate && /^[[:space:]]*$/ { next }
    { print }
  ' "$pacman_conf" >"$workdir/pacman.conf"
else
  # Only the Server line inside [omarchy] changes; every other byte is copied.
  awk -v server="$server" '
    /^[[:space:]]*\[omarchy\][[:space:]]*$/ { inside = 1; print; next }
    inside && /^[[:space:]]*\[[^]]+\][[:space:]]*$/ { inside = 0 }
    inside && /^[[:space:]]*Server[[:space:]]*=/ { print "Server = " server; next }
    { print }
  ' "$pacman_conf" >"$workdir/pacman.conf"
fi

# Every tag's database has the same name and GitHub does not order upload
# times by tag, so a cached database from the previous Server can survive a
# repoint and be rejected against the new tag's signature.
if [[ $final_server != "$current_server" ]]; then
  db_path=$(awk -F= '/^[[:space:]]*DBPath[[:space:]]*=/ { gsub(/[[:space:]]/, "", $2); print $2; exit }' "$pacman_conf")
  sync_dir="$(root_path "${db_path:-/var/lib/pacman}")/sync"
  sudo rm -f "$sync_dir/omarchy.db" "$sync_dir/omarchy.db.sig" ||
    fail "could not remove the cached Omarchy database in $sync_dir; pacman.conf is unchanged"
fi

restore() {
  sudo install -o root -g root -m 0644 "$backup/pacman.conf" "$pacman_conf" ||
    fail "$1; could not restore $pacman_conf from $backup"
  # A sync that succeeded before the failure cached the new Server's database under the same name.
  if [[ $final_server != "$current_server" ]]; then
    sudo rm -f "$sync_dir/omarchy.db" "$sync_dir/omarchy.db.sig" ||
      fail "$1; restored $pacman_conf but could not remove the cached Omarchy database in $sync_dir"
  fi
  fail "$1; restored the previous repository (backup: $backup)"
}

sudo install -o root -g root -m 0644 "$workdir/pacman.conf" "$pacman_conf"

final_name=$tag
[[ $final_server == "$server" ]] || final_name=$final_server
sudo env OMARCHY_UPDATE_PACMAN=1 pacman -Sy --noconfirm || restore "pacman could not read $final_name"

if (( bootstrap )); then
  # Include files can define repositories too, so ask pacman for the order it will actually use.
  repository_list=$(pacman-conf --config "$pacman_conf" --repo-list) || restore "pacman-conf could not read $pacman_conf"
  [[ ${repository_list%%$'\n'*} == "omarchy" ]] || restore "[omarchy] does not come before every other repository"
  if [[ -n $keep_reason ]]; then
    echo "Apple Silicon package repository: $keep_reason"
    echo "Kept the Apple Silicon package repository on $final_server and repaired its section (backup: $backup)"
    exit 0
  fi
  write_state
  echo "Configured the Apple Silicon package repository on $tag (backup: $backup)"
  exit 0
fi

write_state
echo "Switched the Apple Silicon package repository to $tag (backup: $backup)"
