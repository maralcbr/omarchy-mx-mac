#!/bin/bash

# omarchy:summary=Retire the running kernel's saved modules after a kernel downgrade
# omarchy:args=<linux-aurora|linux-asahi>
# omarchy:hidden=true
# omarchy:requires-sudo=true

# After a kernel downgrade, kernel-modules-hook's copy of the running kernel's
# modules is the newest -ARCH directory until linux-modules-cleanup moves it to
# /usr/lib/modules/.old at boot, so update-m1n1's ALARM default takes its device
# trees. Exactly then, this does that move now, under pacman's lock, and
# rebuilds m1n1, so every update-m1n1 before the reboot takes the installed
# kernel's. Anything else is left for the boot check to judge.

set -euo pipefail

modules=/usr/lib/modules

fail() {
  echo "Apple Silicon saved modules: $*" >&2
  exit 1
}

case "${1:-}" in
  linux-aurora | linux-asahi) kernel=$1 ;;
  -h | --help)
    echo "Usage: omarchy-apple-silicon-retire-saved-modules <linux-aurora|linux-asahi>"
    exit 0
    ;;
  *) fail "names linux-aurora or linux-asahi" ;;
esac
(( $# == 1 )) || fail "takes one kernel"

# An alternate root is for tests: pacman, its lock and every path follow it, and OMARCHY_SAVED_MODULES_REBUILD replaces update-m1n1.
root=${OMARCHY_SAVED_MODULES_ROOT:-}
root=${root%/}
pacman_args=() rebuild=(update-m1n1)
if [[ -n $root ]]; then
  [[ -n ${OMARCHY_SAVED_MODULES_REBUILD:-} ]] || fail "an alternate root needs OMARCHY_SAVED_MODULES_REBUILD in place of update-m1n1"
  dbpath=$root/var/lib/pacman/
  pacman_args=(--root "$root" --dbpath "$dbpath")
  rebuild=("$OMARCHY_SAVED_MODULES_REBUILD")
else
  dbpath=$(pacman-conf DBPath 2>/dev/null) || dbpath=""
  [[ $dbpath == /* ]] || dbpath=/var/lib/pacman/
fi
lock=${dbpath%/}/db.lck

# Every condition, read afresh: once to leave the usual case alone, and again
# under pacman's lock before anything moves.
eligible() {
  local installed file owner script config configured match
  running=$(uname -r) || return 1
  [[ $running =~ ^[A-Za-z0-9._+-]+$ ]] || return 1
  installed=$(pacman "${pacman_args[@]}" -Qq 2>/dev/null) || return 1
  grep -Fxq kernel-modules-hook <<<"$installed" || return 1
  kver=""
  while IFS= read -r file; do
    file=${file#"$root"}
    [[ $file =~ ^/usr/lib/modules/([^/]+)/vmlinuz$ ]] || continue
    [[ -z $kver ]] || return 1
    kver=${BASH_REMATCH[1]}
  done < <(pacman "${pacman_args[@]}" -Qlq "$kernel" 2>/dev/null)
  [[ -n $kver && $kver != "$running" ]] || return 1

  # The directory update-m1n1's default picks is the running kernel's, and the
  # installed kernel's is the one it picks once that is gone.
  mapfile -t newest < <(
    for match in "$root$modules"/*-ARCH; do
      [[ ! -e $match && ! -L $match ]] || printf '%s\n' "${match##*/}"
    done | sort -rV
  )
  (( ${#newest[@]} >= 2 )) && [[ ${newest[0]} == "$running" && ${newest[1]} == "$kver" ]] || return 1
  saved=$modules/$running
  [[ -d $root$saved && ! -L $root$saved ]] || return 1
  owner=$(LC_ALL=C pacman "${pacman_args[@]}" -Qqo "$root$saved" 2>&1) && return 1
  [[ $owner == *"No package owns"* ]] || return 1

  # Only when update-m1n1 takes its device trees from that default.
  script=$root/usr/bin/update-m1n1
  [[ -r $script ]] && grep -Eq '^[[:space:]]*:[[:space:]]+\$\{DTBS:=.*/modules/\*-ARCH' "$script" || return 1
  config=$root/etc/default/update-m1n1
  [[ -e $config ]] || return 0
  configured=$(env -i PATH=/usr/bin:/bin bash --noprofile --norc -c '
    unset DTBS M1N1_UPDATE_DISABLED
    . "$1" >/dev/null 2>&1 || exit 1
    printf "%s" "${DTBS-}${M1N1_UPDATE_DISABLED-}"
  ' _ "$config") || return 1
  [[ -z $configured ]]
}

# pacman's own exclusion: db.lck created only if absent, as libalpm creates it.
# Only a lock this created is ever removed.
locked=0
release() {
  (( locked )) || return 0
  sudo rm -f "$lock" && locked=0
}
trap release EXIT

eligible || exit 0
# INT, TERM and HUP wait until the move is done, so the lock never goes while rsync or rm runs; SIGKILL leaves a stale db.lck, which pacman refuses safely.
trap '' INT TERM HUP
sudo bash -c 'set -C; : >"$1"' _ "$lock" 2>/dev/null ||
  fail "pacman's database is locked ($lock), so a package transaction may be running; run omarchy update again once it has finished"
locked=1
eligible || exit 0

echo "Moving the running kernel's saved modules ($running) to $modules/.old, as linux-modules-cleanup does at boot, so m1n1 carries $kernel $kver's device trees. Reboot soon: until then the running kernel cannot load new modules."
sudo rsync -AHXal "$root$saved" "$root$modules/.old/" || fail "could not copy $saved to $modules/.old; nothing was removed"
sudo rm -rf "$root$saved" || fail "could not remove $saved; m1n1 was not rebuilt"
release || fail "could not remove pacman's lock $lock"
trap - INT TERM HUP
sudo env -u TARGET -u DTBS -u SOURCE -u M1N1 -u U_BOOT -u CONFIG -u M1N1_UPDATE_DISABLED "${rebuild[@]}" </dev/null ||
  fail "update-m1n1 failed after $saved was moved to $modules/.old; run sudo update-m1n1, then omarchy update"
