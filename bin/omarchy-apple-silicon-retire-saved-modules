#!/bin/bash

# omarchy:summary=Retire the running kernel's saved modules after a kernel downgrade
# omarchy:args=<linux-aurora|linux-asahi>
# omarchy:hidden=true
# omarchy:requires-sudo=true

# After a kernel downgrade, kernel-modules-hook's copy of the running kernel's
# modules is the newest -ARCH directory until linux-modules-cleanup moves it to
# /usr/lib/modules/.old at boot, so update-m1n1's ALARM default takes its device
# trees. Exactly then, this does that move now and rebuilds m1n1, so every
# update-m1n1 before the reboot takes the installed kernel's. Anything else is
# left for the boot check to judge.

set -euo pipefail

root=${OMARCHY_SAVED_MODULES_ROOT:-}
modules=/usr/lib/modules

fail() {
  echo "Apple Silicon saved modules: $*" >&2
  exit 1
}

case "${1:-}" in
  linux-aurora | linux-asahi) kernel=$1 ;;
  -h | --help)
    echo "Usage: omarchy-apple-silicon-retire-saved-modules <linux-aurora|linux-asahi>"
    exit 0
    ;;
  *) fail "names linux-aurora or linux-asahi" ;;
esac
(( $# == 1 )) || fail "takes one kernel"

running=$(uname -r)
[[ $running =~ ^[A-Za-z0-9._+-]+$ ]] || exit 0
installed=$(pacman -Qq 2>/dev/null) || exit 0
grep -Fxq kernel-modules-hook <<<"$installed" || exit 0
kver=$(pacman -Qlq "$kernel" 2>/dev/null | sed -n "s|^$modules/\([^/]*\)/vmlinuz\$|\1|p") || exit 0
[[ -n $kver && $kver != *$'\n'* && $kver != "$running" ]] || exit 0

# The directory update-m1n1's default picks is the running kernel's, and the
# installed kernel's is the one it picks once that is gone.
mapfile -t newest < <(
  for match in "$root$modules"/*-ARCH; do
    [[ ! -e $match && ! -L $match ]] || printf '%s\n' "${match##*/}"
  done | sort -rV
)
(( ${#newest[@]} >= 2 )) && [[ ${newest[0]} == "$running" && ${newest[1]} == "$kver" ]] || exit 0
saved=$modules/$running
[[ -d $root$saved && ! -L $root$saved ]] || exit 0
owner=$(LC_ALL=C pacman -Qqo "$saved" 2>&1) && exit 0
[[ $owner == *"No package owns"* ]] || exit 0

# Only when update-m1n1 takes its device trees from that default.
script=$root/usr/bin/update-m1n1
[[ -r $script ]] && grep -Eq '^[[:space:]]*:[[:space:]]+\$\{DTBS:=.*/modules/\*-ARCH' "$script" || exit 0
config=$root/etc/default/update-m1n1
if [[ -e $config ]]; then
  configured=$(env -i PATH=/usr/bin:/bin bash --noprofile --norc -c '
    unset DTBS M1N1_UPDATE_DISABLED
    . "$1" >/dev/null 2>&1 || exit 1
    printf "%s" "${DTBS-}${M1N1_UPDATE_DISABLED-}"
  ' _ "$config") || exit 0
  [[ -z $configured ]] || exit 0
fi

echo "Moving the running kernel's saved modules ($running) to $modules/.old, as linux-modules-cleanup does at boot, so m1n1 carries $kernel $kver's device trees. Reboot soon: until then the running kernel cannot load new modules."
sudo rsync -AHXal "$root$saved" "$root$modules/.old/" || fail "could not copy $saved to $modules/.old"
sudo rm -rf "$root$saved" || fail "could not remove $saved"
sudo env -u TARGET -u DTBS -u SOURCE -u M1N1 -u U_BOOT -u CONFIG -u M1N1_UPDATE_DISABLED update-m1n1 </dev/null ||
  fail "update-m1n1 failed after $saved was moved to $modules/.old; run sudo update-m1n1, then omarchy update"
