#!/bin/bash

# omarchy:summary=Run hardware setup deferred from a Mac image build
# omarchy:hidden=true
# omarchy:requires-sudo=true

# First boot calls this once the image is on real hardware. Each remaining
# line in /var/lib/omarchy/mac-first-boot/deferred-steps is a path relative
# to $OMARCHY_PATH; a successful step is dropped so a rerun resumes. Steps
# run with the installer's environment: OMARCHY_PATH, sourced helpers, and
# OMARCHY_MAC_TARGET unset so they probe this Mac. The initramfs is rebuilt
# once at the end if a HID or btrfs leaf ran.

set -euo pipefail

deferred_file="${OMARCHY_MAC_DEFERRED_STEPS:-/var/lib/omarchy/mac-first-boot/deferred-steps}"
log_file="${OMARCHY_MAC_FIRST_BOOT_LOG:-/var/log/omarchy/mac-first-boot.log}"
rebuild_marker="${OMARCHY_MAC_INITRAMFS_REBUILD:-$(dirname "$deferred_file")/rebuild-initramfs}"

fail() {
  echo "Error: $*" >&2
  exit 1
}

log() {
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$log_file"
}

(( EUID == 0 )) || fail "Run omarchy-mac-run-deferred-steps as root"
[[ -n ${OMARCHY_PATH:-} && $OMARCHY_PATH == /* ]] || fail "OMARCHY_PATH is unset"
export OMARCHY_INSTALL="${OMARCHY_INSTALL:-$OMARCHY_PATH/install}"
export PATH="$OMARCHY_PATH/bin:$PATH"
export OMARCHY_INSTALL_LOG_FILE="${OMARCHY_INSTALL_LOG_FILE:-$log_file}"
unset OMARCHY_MAC_TARGET
unset OMARCHY_MAC_IMAGE_BUILD

[[ -f $OMARCHY_INSTALL/helpers/logging.sh && -f $OMARCHY_INSTALL/helpers/mac-image-build.sh ]] ||
  fail "Install helpers are missing under $OMARCHY_INSTALL/helpers"
source "$OMARCHY_INSTALL/helpers/logging.sh"
source "$OMARCHY_INSTALL/helpers/mac-image-build.sh"

if [[ ! -e $deferred_file && ! -e $rebuild_marker ]]; then
  exit 0
fi
if [[ -e $deferred_file ]]; then
  [[ -f $deferred_file && ! -L $deferred_file ]] || fail "$deferred_file is not a regular file"
fi

install -d -m 0755 "$(dirname "$log_file")"
touch "$log_file"
chmod 0644 "$log_file" 2>/dev/null || true

remaining=()
if [[ -f $deferred_file ]]; then
  mapfile -t steps <"$deferred_file"
  for step in "${steps[@]}"; do
    [[ -n $step ]] && remaining+=("$step")
  done
fi

write_remaining() {
  local tmp
  [[ -f $deferred_file ]] || return 0
  tmp=$(mktemp "$(dirname "$deferred_file")/.deferred-steps.XXXXXX")
  if ((${#remaining[@]})); then
    printf '%s\n' "${remaining[@]}" >"$tmp"
  else
    : >"$tmp"
  fi
  chmod 0644 "$tmp"
  mv "$tmp" "$deferred_file"
}

mark_initramfs_rebuild() {
  install -d -m 0755 "$(dirname "$rebuild_marker")"
  : >"$rebuild_marker"
  chmod 0644 "$rebuild_marker"
}

run_step() {
  local relative=$1 script

  [[ $relative != /* && $relative != *..* && $relative == install/* ]] ||
    fail "Deferred step is not a packaged install path: $relative"
  script="$OMARCHY_PATH/$relative"
  [[ -f $script && ! -L $script ]] || fail "Deferred step is missing: $relative"
  run_logged "$script"
}

log "Starting deferred hardware steps ($deferred_file)"
while ((${#remaining[@]})); do
  step=${remaining[0]}
  log "Running $step"
  if ! run_step "$step"; then
    log "Failed $step"
    fail "Deferred step failed: $step"
  fi
  if omarchy_mac_deferred_step_rebuilds_initramfs "$step"; then
    mark_initramfs_rebuild
  fi
  remaining=("${remaining[@]:1}")
  write_remaining
  log "Completed $step"
done
log "Deferred hardware steps finished"

if [[ -f $rebuild_marker && ! -L $rebuild_marker ]]; then
  log "Rebuilding the initramfs"
  mkinitcpio -P </dev/null || fail "Initramfs rebuild failed"
  rm -f "$rebuild_marker"
  log "Rebuilt the initramfs"
fi
