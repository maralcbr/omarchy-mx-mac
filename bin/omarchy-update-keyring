#!/bin/bash

# omarchy:summary=Ensure the Omarchy and Arch keyring packages are installed and populated
# omarchy:requires-sudo=true

set -euo pipefail

trusted_key=40DFB630FF42BCFFB047046CF0134EE680CAC571
platform_keyring=archlinux-keyring
platform_ring=archlinux
if omarchy-hw-apple-silicon; then
  platform_keyring=archlinuxarm-keyring
  platform_ring=archlinuxarm
fi

# Restore installed trust and revocation metadata before fetching updates.
sudo pacman-key --populate "$platform_ring"
if ! omarchy-pkg-missing omarchy-keyring; then
  sudo pacman-key --populate omarchy
fi

if ! sudo pacman-key --list-keys "$trusted_key" >/dev/null 2>&1; then
  sudo pacman-key --recv-keys "$trusted_key" --keyserver keys.openpgp.org
fi
fingerprint=$(sudo gpg --homedir /etc/pacman.d/gnupg --batch --with-colons --fingerprint "$trusted_key" |
  awk -F: '$1 == "pub" { primary=1; next } primary && $1 == "fpr" { print $10; exit }')
if [[ $fingerprint != "$trusted_key" ]]; then
  echo "Error: Omarchy signing key does not match $trusted_key" >&2
  exit 1
fi
sudo pacman-key --lsign-key "$trusted_key"

# Keyring refresh precedes the full system upgrade. Reinstall even when the
# version is unchanged, since key material can change without a version bump.
echo "Update signing keys"
sudo pacman -Sy --noconfirm omarchy-keyring "$platform_keyring"
sudo pacman-key --populate omarchy "$platform_ring"
sudo pacman-key --list-keys "$trusted_key" >/dev/null
echo "Keys are correct"
