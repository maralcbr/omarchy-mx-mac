#!/bin/bash

# omarchy:summary=Ensure the Omarchy and Arch keyring packages are installed and populated
# omarchy:requires-sudo=true

trusted_key=40DFB630FF42BCFFB047046CF0134EE680CAC571

if omarchy-hw-apple-silicon; then
  if omarchy-pkg-missing omarchy-keyring; then
    echo "The trusted Omarchy keyring must be installed by the signed Apple Silicon bundle." >&2
    exit 1
  fi
  installed_fingerprint=$(GNUPGHOME=/etc/pacman.d/gnupg gpg --batch --with-colons --fingerprint "$trusted_key" 2>/dev/null |
    awk -F: '$1 == "fpr" { print $10; exit }')
  if [[ $installed_fingerprint != "$trusted_key" ]]; then
    # A Mac image builds its pacman keyring on first boot from the ARM keyrings
    # alone, so the key the installed omarchy-keyring ships is not trusted yet.
    # Populating from that package is the only source used; no keyserver. A
    # populate that fails part way can leave the key imported but unsigned, so
    # its exit status counts, not just the fingerprint afterwards.
    echo "Trusting the Omarchy keyring shipped by omarchy-keyring"
    if ! sudo pacman-key --populate omarchy; then
      echo "pacman-key --populate omarchy failed; the Omarchy keyring is not trusted." >&2
      echo "The trusted Omarchy keyring must be installed by the signed Apple Silicon bundle." >&2
      exit 1
    fi
    installed_fingerprint=$(GNUPGHOME=/etc/pacman.d/gnupg gpg --batch --with-colons --fingerprint "$trusted_key" 2>/dev/null |
      awk -F: '$1 == "fpr" { print $10; exit }')
    if [[ $installed_fingerprint != "$trusted_key" ]]; then
      echo "The trusted Omarchy keyring must be installed by the signed Apple Silicon bundle." >&2
      exit 1
    fi
  fi
elif omarchy-pkg-missing omarchy-keyring || ! sudo pacman-key --list-keys "$trusted_key" &>/dev/null; then
  sudo pacman-key --recv-keys "$trusted_key" --keyserver keys.openpgp.org
  sudo pacman-key --lsign-key "$trusted_key"

  # This is generally not a good idea, but this is a special case because we're going to be updating
  # the full set of packages in omarchy-update-system-pkgs right after this (and it needs latest keyring)!
  sudo pacman -Sy
  omarchy-pkg-add omarchy-keyring

  sudo pacman-key --list-keys "$trusted_key"
fi

# Ensure we have the platform keyring, which can change without a package
# version bump. Arch Linux ARM uses its own signing keys on Apple Silicon.
platform_keyring=archlinux-keyring
if omarchy-hw-apple-silicon; then
  platform_keyring=archlinuxarm-keyring
fi
echo -e "\e[32m\nUpdate Arch signing keys\e[0m"
sudo pacman -Sy --noconfirm "$platform_keyring" >/dev/null 2> >(grep -vE "^warning: ${platform_keyring}-[^ ]+ is up to date -- reinstalling$" >&2)
echo "Keys are correct"
