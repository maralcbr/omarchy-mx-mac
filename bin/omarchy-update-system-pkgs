#!/bin/bash

# omarchy:summary=Update system packages with pacman
# omarchy:requires-sudo=true

set -e

# Aurora Macs take their kernel from [omarchy-aurora], which only this step
# pins. It runs ahead of every upgrade below, retries included, and a release it
# cannot prove stops the update: upgrading against the wrong pin would move the
# kernel. Elsewhere it does nothing. 3 is edge that could not be followed this
# time, and the upgrade goes on against the pin it has; any other failure is its
# own, since 3 from here would read as a repository mid-transition.
aurora_targets_file=$(mktemp)
aurora_status=0
OMARCHY_AURORA_TARGETS=$aurora_targets_file omarchy-update-aurora-repository || aurora_status=$?
mapfile -t aurora_targets <"$aurora_targets_file"
rm -f "$aurora_targets_file"
case $aurora_status in
  0) ;;
  3) aurora_targets=() ;;
  *) exit 1 ;;
esac
for target in "${aurora_targets[@]}"; do
  case "$target" in
    omarchy-aurora/linux-aurora | omarchy-aurora/linux-aurora-headers | omarchy-aurora/m1n1-aurora) ;;
    *) echo "Unexpected Aurora upgrade target: $target" >&2; exit 1 ;;
  esac
done

# The boot files an Apple Silicon image wrote are adopted by naming their package in this same upgrade, retries included.
pacman_targets=()
boot_admission=""
if omarchy-hw-apple-silicon && [[ -z ${OMARCHY_APPLE_BOOT_UNAVAILABLE:-} ]]; then
  boot_admission=$(omarchy-update-apple-boot-admission 2>/dev/null) || boot_admission="skip: its boot files could not be checked"
  if [[ $boot_admission == adopt ]]; then
    pacman_targets+=(--needed omarchy-apple-boot)
  fi
fi
# A kernel switch names its repository's packages, so pacman installs that
# release's versions even where they are older than the installed ones.
if ((${#aurora_targets[@]})); then
  [[ " ${pacman_targets[*]} " == *" --needed "* ]] || pacman_targets+=(--needed)
  pacman_targets+=("${aurora_targets[@]}")
fi

# pacman exits 0 even when a hook after the transaction failed, so the switch
# is finished only by proving what it installed boots. Until then the reboot
# the update would offer stays blocked.
reboot_blocked=${OMARCHY_REBOOT_BLOCKED:-/run/omarchy-reboot-blocked}
finish_aurora_switch() {
  ((${#aurora_targets[@]})) || return 0
  omarchy-update-aurora-repository --complete && return 0
  [[ -e $reboot_blocked ]] ||
    sudo tee "$reboot_blocked" >/dev/null <<<"the Aurora kernel switch could not be verified" || true
}

# The conflict handler's last resort: pacman puts its questions to the person
# running the update instead of answering them itself. Nothing here may capture
# a stream, because an upgrade without --noconfirm prompts on stderr. The
# handler has already said why, so no heading here either.
if [[ ${OMARCHY_UPDATE_CONFLICT:-} == 1 && ${OMARCHY_UPDATE_INTERACTIVE:-} == 1 ]]; then
  sudo env OMARCHY_UPDATE_PACMAN=1 pacman -Syu --overwrite '/usr/share/omarchy/*' "${pacman_targets[@]}" || exit
  finish_aurora_switch
  exit 0
fi

echo -e "\e[32m\nUpdate system packages\e[0m"

case $boot_admission in
  "" | adopt | owned | "skip: no image-written boot files") ;;
  *) echo -e "\e[33mApple Silicon boot files stay unmanaged: ${boot_admission#skip: }\e[0m" ;;
esac

errors=$(mktemp)
trap 'rm -f "$errors"' EXIT

pacman_args=()
if omarchy-hw-apple-silicon; then
  pacman_args+=(--ignore omarchy-keyring,omarchy-settings-dev,omarchy-dev,omarchy-nvim,quickshell-git,ttf-jetbrains-mono-nerd-basic)
fi

# /usr/share/omarchy is wholly Omarchy's; files can land there unowned and would
# otherwise abort the upgrade. Packaged content wins there.
# Progress bars stay on stdout. Errors are on stderr, kept for the conflict
# handler below; LC_ALL=C is what keeps them parseable in any locale.
if sudo env LC_ALL=C OMARCHY_UPDATE_PACMAN=1 pacman -Syu --noconfirm \
  --overwrite '/usr/share/omarchy/*' "${pacman_args[@]}" "${pacman_targets[@]}" 2>"$errors"; then
  cat "$errors" >&2
  finish_aurora_switch
  exit 0
fi
cat "$errors" >&2

# A repository snapshot from before omarchy-apple-boot existed refuses the target before changing anything; update without it.
if ((${#pacman_targets[@]})) &&
  sed "s/$(printf '\033')\[[0-9;]*m//g" "$errors" | grep -qx 'error: target not found: omarchy-apple-boot'; then
  echo -e "\e[33mThis Mac's package repository has no omarchy-apple-boot yet; updating without it.\e[0m" >&2
  rm -f "$errors"
  exec env OMARCHY_APPLE_BOOT_UNAVAILABLE=1 omarchy-update-system-pkgs
fi

# A repository mid-transition -- one package already rebuilt against a new
# library, the packages that need it not yet -- is refused by pacman before it
# installs anything, and that refusal is right: the partial upgrade would not
# boot. Nothing here can fix it and nothing was changed, so say that instead of
# handing it to the conflict handler as if it were ours.
if grep -qE 'unable to satisfy dependency|breaks dependency' "$errors"; then
  if omarchy-hw-apple-silicon; then
    echo -e "\e[33m\nThe Arch Linux ARM repositories are mid-update, so this upgrade cannot go through yet. Nothing on this Mac was changed. Try again later.\e[0m" >&2
  else
    echo -e "\e[33m\nThe Arch Linux repositories are mid-update, so this upgrade cannot go through yet. Nothing on this computer was changed. Try again later.\e[0m" >&2
  fi
  exit 3
fi

# The handler takes it from here: it clears files pacman doesn't own yet and
# runs this again, and puts a package conflict to whoever started the update.
# Anything else, including a second failure, is for a human.
[[ ${OMARCHY_UPDATE_RETRY:-} != 1 ]] || exit 1
# exec, so the EXIT trap above does not fire and the handler can still read the
# report. It takes over deleting it.
exec env OMARCHY_UPDATE_CONFLICT=1 omarchy-update-system-pkgs-when-conflicted "$errors"
