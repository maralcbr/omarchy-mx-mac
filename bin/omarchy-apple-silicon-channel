#!/bin/bash

# omarchy:summary=Keep this Mac's Apple Silicon channel record
# omarchy:args=ensure|status|current|hold <reason>|release|switch <rc|edge>|reset-rc|locked <command> [args...]|verify-locked
# omarchy:hidden=true
# omarchy:requires-sudo=true

# The record says which channel this Mac follows: stable on linux-asahi, rc on
# linux-aurora. A Mac without one is given one on update, but only when the
# installed kernel and the image's kernel marker agree. channel=rc is policy, not
# proof that the qualified kernel is installed. A hold stops [omarchy-aurora]
# moving; packages still upgrade against the repository it has. locked runs a
# command holding the channel lock, which is on the record's directory, and
# verify-locked checks the inherited descriptor and makes sure it holds that lock.
#
# An rc Mac also follows an Aurora lane, rc or edge, kept apart in
# apple-silicon-aurora-lane so the record itself never changes shape: runtimes
# that only know format 1 keep reading it. switch records a requested lane,
# which omarchy update applies and clears once it has proven the kernel boots;
# reset-rc does the same for rc whatever the lane file holds. lane, lane-write
# and stage-descriptor are the updater's, under the lock it already holds, and
# held names the Aurora packages pacman's configuration holds back.
#
# Exit 2: the record, its storage, the lock or the evidence cannot be trusted.
# Exit 3: there is no record, and for ensure none could be inferred.

set -euo pipefail

root=${OMARCHY_APPLE_SILICON_CHANNEL_ROOT:-}
state_dir="$root/var/lib/omarchy"
record="$state_dir/apple-silicon-channel"
lane_file="$state_dir/apple-silicon-aurora-lane"
descriptor_file="$state_dir/aurora-target.descriptor"
pacman_conf="$root/etc/pacman.conf"
verify_hook="$root/usr/share/libalpm/hooks/01-omarchy-aurora-verify.hook"
kernel_marker="$root/usr/share/omarchy/apple-silicon-kernel"
lock_timeout=${OMARCHY_APPLE_SILICON_CHANNEL_LOCK_TIMEOUT:-60}
testing=${OMARCHY_APPLE_SILICON_CHANNEL_TESTING:-0}

usage() {
  echo "Usage: omarchy-apple-silicon-channel <ensure|status|current|hold <reason>|release|switch <rc|edge>|reset-rc|locked <command> [args...]|verify-locked>"
}

fail() {
  echo "Apple Silicon channel: $*" >&2
  exit 2
}

problem=""
record_channel="" record_kernel="" record_hold=""
evidence=""

# $2 is "file" or "directory"; a directory only needs a root owner.
root_controlled() {
  local path=$1 owner group mode
  if ! read -r owner group mode < <(stat -c '%u %g %a' "$path" 2>/dev/null); then
    problem="cannot inspect $path"
    return 1
  fi
  if [[ $testing != 1 ]] && [[ $owner != 0 || ($2 == file && $group != 0) ]]; then
    problem="$path is not owned by root"
    return 1
  fi
  if (( (8#$mode & 8#022) != 0 )); then
    problem="$path is writable by users other than root"
    return 1
  fi
}

safe_state_dir() {
  if [[ -L $state_dir || ! -d $state_dir ]]; then
    problem="$state_dir is not a directory"
    return 1
  fi
  root_controlled "$state_dir" directory
}

valid_reason() {
  [[ -n $1 && $1 != *$'\n'* ]] && (( ${#1} <= 200 )) &&
    LC_ALL=C grep -qxE '[[:print:]]+' <<<"$1"
}

# 0 with record_* set, 3 when there is no record, 2 with problem set.
read_record() {
  local line key value bad_line
  local -A seen=()
  record_channel="" record_kernel="" record_hold=""

  if [[ -e $state_dir || -L $state_dir ]]; then
    safe_state_dir || return 2
  fi
  [[ -e $record || -L $record ]] || return 3
  if [[ -L $record || ! -f $record ]]; then
    problem="$record is not a regular file"
    return 2
  fi
  root_controlled "$record" file || return 2
  if [[ ! -r $record ]]; then
    problem="$record is not readable"
    return 2
  fi
  if bad_line=$(LC_ALL=C grep -m 1 -naxvE '[a-z_]+=[[:print:]]+' "$record"); then
    problem="$record line ${bad_line%%:*} is not key=value with a printable value"
    return 2
  fi

  while IFS= read -r line || [[ -n $line ]]; do
    key=${line%%=*}
    value=${line#*=}
    if [[ -n ${seen[$key]:-} ]]; then
      problem="$record repeats $key"
      return 2
    fi
    seen[$key]=1
    case "$key" in
      format)
        if [[ $value != 1 ]]; then
          problem="$record has unsupported format $value"
          return 2
        fi
        ;;
      channel) record_channel=$value ;;
      kernel) record_kernel=$value ;;
      hold) record_hold=$value ;;
      *)
        problem="$record has unknown key $key"
        return 2
        ;;
    esac
  done <"$record"

  for key in format channel kernel; do
    if [[ -z ${seen[$key]:-} ]]; then
      problem="$record has no $key"
      return 2
    fi
  done
  case "$record_channel:$record_kernel" in
    stable:linux-asahi | rc:linux-aurora) ;;
    *)
      problem="$record pairs channel $record_channel with kernel $record_kernel"
      return 2
      ;;
  esac
  if [[ -n ${seen[hold]:-} ]] && ! valid_reason "$record_hold"; then
    problem="$record has a hold longer than 200 characters"
    return 2
  fi
}

lane=rc lane_switch="" lane_accepted="" lane_pending=""

# 0 with lane* set, an absent file being lane=rc; 2 with problem set.
read_lane() {
  local line key value bad_line
  local -A seen=()
  lane=rc lane_switch="" lane_accepted="" lane_pending=""

  [[ -e $lane_file || -L $lane_file ]] || return 0
  if [[ -L $lane_file || ! -f $lane_file ]]; then
    problem="$lane_file is not a regular file"
    return 2
  fi
  root_controlled "$lane_file" file || return 2
  if [[ ! -r $lane_file ]]; then
    problem="$lane_file is not readable"
    return 2
  fi
  if bad_line=$(LC_ALL=C grep -m 1 -naxvE '[a-z_]+=[[:print:]]+' "$lane_file"); then
    problem="$lane_file line ${bad_line%%:*} is not key=value with a printable value"
    return 2
  fi

  while IFS= read -r line || [[ -n $line ]]; do
    key=${line%%=*}
    value=${line#*=}
    if [[ -n ${seen[$key]:-} ]]; then
      problem="$lane_file repeats $key"
      return 2
    fi
    seen[$key]=1
    case "$key" in
      format)
        if [[ $value != 1 ]]; then
          problem="$lane_file has unsupported format $value"
          return 2
        fi
        ;;
      lane | switch)
        if [[ $value != rc && $value != edge ]]; then
          problem="$lane_file has $key $value, which is neither rc nor edge"
          return 2
        fi
        [[ $key == lane ]] && lane=$value || lane_switch=$value
        ;;
      edge_accepted | edge_pending)
        if [[ ! $value =~ ^[1-9][0-9]{0,8}:[0-9a-f]{64}$ ]]; then
          problem="$lane_file has a malformed $key"
          return 2
        fi
        [[ $key == edge_accepted ]] && lane_accepted=$value || lane_pending=$value
        ;;
      *)
        problem="$lane_file has unknown key $key"
        return 2
        ;;
    esac
  done <"$lane_file"

  for key in format lane; do
    if [[ -z ${seen[$key]:-} ]]; then
      problem="$lane_file has no $key"
      return 2
    fi
  done
}

print_lane() {
  printf 'lane=%s\n' "$lane"
  [[ -z $lane_switch ]] || printf 'switch=%s\n' "$lane_switch"
  [[ -z $lane_accepted ]] || printf 'edge_accepted=%s\n' "$lane_accepted"
  [[ -z $lane_pending ]] || printf 'edge_pending=%s\n' "$lane_pending"
}

# The Aurora packages pacman holds back, as pacman itself reads its
# configuration: IgnorePkg and IgnoreGroup wherever they are included from,
# IgnoreGroup matched against the groups each package is in, installed or in
# a synced repository. 1 when the configuration cannot be read.
held_aurora_packages() {
  local ignored_packages ignored_groups package pattern group held=()
  local -a groups

  ignored_packages=$(pacman-conf --config "$pacman_conf" IgnorePkg 2>/dev/null) || return 1
  ignored_groups=$(pacman-conf --config "$pacman_conf" IgnoreGroup 2>/dev/null) || return 1
  for package in linux-aurora linux-aurora-headers m1n1-aurora; do
    while IFS= read -r pattern; do
      if [[ -n $pattern && $package == $pattern ]]; then
        held+=("$package")
        continue 2
      fi
    done <<<"$ignored_packages"
    [[ -n $ignored_groups ]] || continue
    mapfile -t groups < <(
      { LC_ALL=C pacman -Qi "$package" 2>/dev/null || true; LC_ALL=C pacman -Si "$package" 2>/dev/null || true; } |
        awk -F' : ' '/^Groups +:/ && $2 != "None" { n = split($2, names, / +/); for (i = 1; i <= n; i++) print names[i] }'
    )
    for group in "${groups[@]}"; do
      while IFS= read -r pattern; do
        if [[ -n $pattern && $group == $pattern ]]; then
          held+=("$package")
          continue 3
        fi
      done <<<"$ignored_groups"
    done
  done
  echo "${held[*]}"
}

aurora_section_on_edge() {
  local line section="" header='^[[:space:]]*\[([^]]+)\][[:space:]]*$'

  [[ -r $pacman_conf ]] || return 1
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line =~ $header ]]; then
      section=${BASH_REMATCH[1]}
    elif [[ $section == omarchy-aurora && $line =~ ^[[:space:]]*Server[[:space:]]*=.*/releases/download/aurora-edge-[1-9][0-9]*/?[[:space:]]*$ ]]; then
      return 0
    fi
  done <"$pacman_conf"
  return 1
}

# Sets evidence to the one kernel this Mac runs; 1 with problem set when that is
# ambiguous, 2 when it cannot be read.
classify() {
  local installed aurora=0 asahi=0 marker=none kernel

  evidence=""
  # linux-aurora provides linux-asahi, so only exact installed names count.
  if ! installed=$(pacman -Qq 2>/dev/null); then
    problem="could not list installed packages"
    return 2
  fi
  grep -Fxq linux-aurora <<<"$installed" && aurora=1
  grep -Fxq linux-asahi <<<"$installed" && asahi=1

  if [[ -e $kernel_marker || -L $kernel_marker ]]; then
    if [[ -L $kernel_marker || ! -f $kernel_marker || ! -r $kernel_marker ]]; then
      problem="$kernel_marker is not a readable regular file"
      return 1
    fi
    marker=""
    for kernel in linux-aurora linux-asahi; do
      if cmp -s "$kernel_marker" <(printf '%s\n' "$kernel") || cmp -s "$kernel_marker" <(printf '%s' "$kernel"); then
        marker=$kernel
      fi
    done
    if [[ -z $marker ]]; then
      problem="$kernel_marker names neither linux-aurora nor linux-asahi"
      return 1
    fi
  fi

  if (( aurora && asahi )); then
    problem="both linux-aurora and linux-asahi are installed"
    return 1
  fi
  if (( ! aurora && ! asahi )); then
    problem="neither linux-aurora nor linux-asahi is installed"
    return 1
  fi
  evidence=linux-asahi
  (( ! aurora )) || evidence=linux-aurora
  if [[ $marker != none && $marker != "$evidence" ]]; then
    problem="$kernel_marker names $marker, but $evidence is installed"
    return 1
  fi
}

# 0 when the record is valid and the evidence names its kernel, 3 without a
# record, 2 otherwise.
checked_record() {
  read_record || return
  if ! classify; then
    problem="$record names $record_kernel, which this Mac does not confirm: $problem"
    return 2
  fi
  if [[ $evidence != "$record_kernel" ]]; then
    problem="$record names $record_kernel, but this Mac runs $evidence"
    return 2
  fi
}

# Machine-wide, unlike omarchy-update-lock, which is per runtime directory. A
# directory is never replaced the way a lock file can be. $1 == create makes it.
lock_state_dir() {
  [[ ${OMARCHY_APPLE_SILICON_CHANNEL_LOCKED:-} != 1 ]] ||
    fail "the channel lock is already held by a caller; taking it again would wait for itself"
  if [[ ${1:-} == create && ! -e $state_dir && ! -L $state_dir ]]; then
    sudo install -d -o root -g root -m 0755 "$state_dir" || fail "could not create $state_dir"
  fi
  safe_state_dir || fail "$problem"
  exec {lock_fd}<"$state_dir" || fail "could not open $state_dir"
  flock -x -w "$lock_timeout" "$lock_fd" ||
    fail "could not lock $state_dir within ${lock_timeout}s; another update or channel change holds it"
  if [[ ! /dev/fd/$lock_fd -ef $state_dir ]] || ! safe_state_dir; then
    fail "$state_dir changed while waiting for its lock"
  fi
}

# The flags locked exports are only claims: an inherited or preset environment
# counts for nothing until the descriptor is open on this directory and holds its lock.
verify_locked() {
  local fd=${OMARCHY_APPLE_SILICON_CHANNEL_LOCK_FD:-} fd_id dir_id

  [[ ${OMARCHY_APPLE_SILICON_CHANNEL_LOCKED:-} == 1 ]] ||
    fail "not running under omarchy-apple-silicon-channel locked"
  [[ $fd =~ ^[0-9]+$ ]] ||
    fail "OMARCHY_APPLE_SILICON_CHANNEL_LOCK_FD is not a descriptor number, so the channel lock is not proven"
  [[ -e /proc/$$/fd/$fd ]] || fail "descriptor $fd is not open, so the channel lock is not held"
  safe_state_dir || fail "$problem"
  if ! fd_id=$(stat -L -c '%d:%i' "/proc/$$/fd/$fd" 2>/dev/null) ||
    ! dir_id=$(stat -c '%d:%i' "$state_dir" 2>/dev/null) || [[ $fd_id != "$dir_id" ]]; then
    fail "descriptor $fd is not open on $state_dir, so the channel lock is not held"
  fi
  flock -n -x "$fd" || fail "descriptor $fd does not hold the lock on $state_dir; another process does"
}

staging=""
trap '[[ -z $staging ]] || sudo rm -f "$staging"' EXIT

# Replaces $1 with stdin through a rename, so readers see the old or the new file.
write_state() {
  local path=$1

  safe_state_dir || fail "$problem"
  staging=$(sudo mktemp -p "$state_dir" ".${path##*/}.XXXXXX") || fail "could not stage $path"
  sudo tee "$staging" >/dev/null || fail "could not write $path"
  sudo chown root:root "$staging" && sudo chmod 0644 "$staging" || fail "could not write $path"
  sudo mv -f "$staging" "$path" || fail "could not write $path"
  staging=""
}

write_record() {
  local channel=$1 kernel=$2 hold=${3:-}

  write_state "$record" < <(
    printf 'format=1\nchannel=%s\nkernel=%s\n' "$channel" "$kernel"
    [[ -z $hold ]] || printf 'hold=%s\n' "$hold"
  )
}

write_lane() {
  write_state "$lane_file" < <(printf 'format=1\n'; print_lane)
}

# Callers that hold the lock already prove it; everyone else takes it.
lock_or_verify() {
  if [[ ${OMARCHY_APPLE_SILICON_CHANNEL_LOCKED:-} == 1 ]]; then
    verify_locked
  else
    lock_state_dir
  fi
}

command=${1:-}
case "$command" in
  ensure | status | current | release) (( $# == 1 )) || { usage >&2; exit 2; } ;;
  hold) (( $# == 2 )) || { usage >&2; exit 2; } ;;
  locked) (( $# >= 2 )) || { usage >&2; exit 2; } ;;
  verify-locked) (( $# == 1 )) || { usage >&2; exit 2; } ;;
  lane | reset-rc | held) (( $# == 1 )) || { usage >&2; exit 2; } ;;
  switch) (( $# == 2 )) && [[ $2 == rc || $2 == edge ]] || { usage >&2; exit 2; } ;;
  lane-write) (( $# >= 2 )) || { usage >&2; exit 2; } ;;
  stage-descriptor) (( $# == 2 )) || { usage >&2; exit 2; } ;;
  -h | --help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

result=0
case "$command" in
  ensure)
    omarchy-hw-apple-silicon || exit 0
    lock_state_dir create
    checked_record || result=$?
    if (( result == 3 )); then
      result=0
      classify || result=$?
      if (( result == 1 )); then
        printf '\e[33mCannot tell which Apple Silicon channel this Mac follows, so channel handling is skipped: %s.\e[0m\n' "$problem" >&2
        exit 3
      fi
      (( result == 0 )) || fail "$problem"
      if [[ $evidence == linux-aurora ]]; then
        write_record rc linux-aurora
      else
        write_record stable linux-asahi
      fi
      exit 0
    fi
    (( result == 0 )) || fail "$problem"
    ;;
  status)
    checked_record || result=$?
    (( result != 2 )) || fail "$problem"
    (( result == 0 )) || exit 3
    printf 'channel=%s\nkernel=%s\n' "$record_channel" "$record_kernel"
    [[ -z $record_hold ]] || printf 'hold=%s\n' "$record_hold"
    ;;
  current)
    checked_record || result=$?
    if (( result == 0 )) && [[ $record_channel == rc ]]; then
      if read_lane; then
        echo "$lane"
      else
        echo "Apple Silicon channel: $problem" >&2
        echo unknown
      fi
    elif (( result == 0 )); then
      echo "$record_channel"
    else
      (( result != 2 )) || echo "Apple Silicon channel: $problem" >&2
      echo unknown
    fi
    exit 0
    ;;
  hold | release)
    if [[ $command == hold ]] && ! valid_reason "$2"; then
      fail "a hold reason is one line of 1 to 200 printable ASCII characters"
    fi
    if [[ ! -e $state_dir && ! -L $state_dir ]]; then
      fail "$record does not exist yet; omarchy update records it"
    fi
    lock_state_dir
    read_record || result=$?
    (( result != 3 )) || fail "$record does not exist yet; omarchy update records it"
    (( result == 0 )) || fail "$problem"
    if [[ $command == hold ]]; then
      [[ $record_hold == "$2" ]] || write_record "$record_channel" "$record_kernel" "$2"
      echo "This Mac's Apple Silicon channel is held: $2"
    else
      [[ -z $record_hold ]] || write_record "$record_channel" "$record_kernel"
      echo "This Mac's Apple Silicon channel is not held."
    fi
    ;;
  locked)
    shift
    lock_state_dir
    export OMARCHY_APPLE_SILICON_CHANNEL_LOCKED=1 OMARCHY_APPLE_SILICON_CHANNEL_LOCK_FD=$lock_fd
    exec "$@"
    ;;
  verify-locked)
    verify_locked
    ;;
  lane)
    checked_record || result=$?
    (( result != 2 )) || fail "$problem"
    (( result == 0 )) || exit 3
    # The lane is an rc Mac's; any other record ignores the file.
    if [[ $record_channel == rc ]]; then
      read_lane || fail "$problem"
    fi
    print_lane
    ;;
  held)
    held_aurora_packages || fail "pacman cannot read $pacman_conf"
    ;;
  lane-write)
    shift
    verify_locked
    read_record || result=$?
    (( result == 0 )) || fail "${problem:-$record does not exist yet}"
    [[ $record_channel == rc ]] || fail "only an rc Mac has an Aurora lane"
    read_lane || fail "$problem"
    for assignment in "$@"; do
      key=${assignment%%=*}
      value=${assignment#*=}
      [[ $assignment == *=* ]] || fail "lane-write takes key=value, not '$assignment'"
      case "$key:$value" in
        lane:rc | lane:edge) lane=$value ;;
        switch: | switch:rc | switch:edge) lane_switch=$value ;;
        edge_accepted:* | edge_pending:*)
          [[ -z $value || $value =~ ^[1-9][0-9]{0,8}:[0-9a-f]{64}$ ]] || fail "lane-write: malformed $key"
          [[ $key == edge_accepted ]] && lane_accepted=$value || lane_pending=$value
          ;;
        *) fail "lane-write: unsupported $assignment" ;;
      esac
    done
    write_lane
    ;;
  stage-descriptor)
    verify_locked
    [[ -f $2 && -r $2 && ! -L $2 ]] || fail "$2 is not a readable regular file"
    (( $(wc -c <"$2") <= 131072 )) || fail "$2 is larger than 128 KiB"
    if [[ -e $descriptor_file || -L $descriptor_file ]]; then
      [[ -f $descriptor_file && ! -L $descriptor_file ]] || fail "$descriptor_file is not a regular file"
      ! cmp -s "$2" "$descriptor_file" || exit 0
    fi
    write_state "$descriptor_file" <"$2"
    ;;
  switch)
    target=$2
    omarchy-update-lock held || fail "the update lock is not held; use omarchy-channel-set $target"
    [[ -e $state_dir || -L $state_dir ]] || fail "$record does not exist yet; omarchy update records it"
    lock_or_verify
    # Everything is read under the lock, and nothing is written unless all of it passes.
    checked_record || result=$?
    (( result != 3 )) || fail "$record does not exist yet; omarchy update records it"
    (( result == 0 )) || fail "$problem"
    [[ $record_channel == rc ]] ||
      fail "this Mac runs $record_kernel on $record_channel; rc and edge are the Aurora kernel's, and moving between kernel families is not available"
    [[ -z $record_hold ]] ||
      fail "this Mac's channel is held ($record_hold); omarchy-apple-silicon-channel release lifts the hold"
    held=$(held_aurora_packages) || fail "pacman cannot read /etc/pacman.conf, so a hold on the Aurora packages cannot be ruled out"
    [[ -z $held ]] ||
      fail "IgnorePkg/IgnoreGroup in /etc/pacman.conf holds $held; remove that hold before switching"
    if [[ $target == edge && ! -f $verify_hook ]]; then
      fail "this runtime does not install $verify_hook, which edge relies on; update Omarchy first"
    fi
    read_lane || fail "$problem; omarchy-apple-silicon-channel reset-rc starts it again from rc"
    if [[ $lane_switch == "$target" ]] ||
      { [[ $lane == "$target" && -z $lane_switch ]] && ! { [[ $target == rc ]] && aurora_section_on_edge; }; }; then
      echo "This Mac already follows $target."
      exit 0
    fi
    lane=$target lane_switch=$target
    write_lane
    echo "This Mac now follows $target. omarchy update moves the Aurora kernel and checks that it boots before calling the switch done."
    ;;
  reset-rc)
    [[ -e $state_dir || -L $state_dir ]] || fail "$record does not exist yet; omarchy update records it"
    lock_or_verify
    read_record || result=$?
    (( result != 3 )) || fail "$record does not exist yet; omarchy update records it"
    (( result == 0 )) || fail "$problem"
    [[ $record_channel == rc ]] || fail "this Mac follows $record_channel, which has no Aurora lane"
    if ! read_lane; then
      [[ -f $lane_file && ! -L $lane_file ]] || fail "$problem; remove it by hand"
      echo "Apple Silicon channel: $problem; starting it again from rc, without its edge history." >&2
      lane_accepted="" lane_pending=""
    fi
    lane=rc lane_switch=rc
    write_lane
    echo "This Mac returns to rc on the next omarchy update."
    [[ -z $record_hold ]] || echo "Its channel is held ($record_hold), so nothing moves until omarchy-apple-silicon-channel release."
    ;;
esac
