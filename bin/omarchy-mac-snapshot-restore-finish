#!/bin/bash

# omarchy:summary=First-boot worker that verifies an omarchy-mac-snapshot-restore
# omarchy:requires-sudo=true
# omarchy:hidden=true

# Runs once, early on the first boot after omarchy-mac-snapshot-restore, via
# omarchy-mac-snapshot-restore-finish.service (armed by
# /var/lib/omarchy/snapshot-restore/pending). Verifies that the restored root
# carries the snapper collection, records a snapshot of the restored state,
# and marks the recovery record finished. The previous root is kept; the
# owner removes it with omarchy-snapshot prune-previous.

set -uo pipefail

STATE_DIR=${OMARCHY_SNAPSHOT_RESTORE_STATE_DIR:-/var/lib/omarchy/snapshot-restore}
RECORD=${OMARCHY_SNAPSHOT_RESTORE_RECORD:-/boot/omarchy/snapshot-restore.state}
SNAPSHOTS_DIR=${OMARCHY_SNAPSHOTS_DIR:-/.snapshots}

[[ -f $STATE_DIR/pending ]] || exit 0

if (( EUID != 0 )); then
  echo "Error: omarchy-mac-snapshot-restore-finish must run as root" >&2
  exit 1
fi

log() {
  echo "snapshot-restore: $1"
}

result() {
  printf '%s\t%s\t%s\n' "$(date --iso-8601=seconds)" "$1" "$2" >"$STATE_DIR/last-result"
}

restored_from=$(sed -n 's/^restored_from=//p' "$STATE_DIR/restored-from" 2>/dev/null | head -n 1)

if ! btrfs subvolume show "$SNAPSHOTS_DIR" >/dev/null 2>&1; then
  log "$SNAPSHOTS_DIR is not a subvolume on the restored root; keeping the restore pending"
  result failed "snapshots subvolume missing"
  exit 1
fi

if omarchy-cmd-missing snapper; then
  log "snapper is not installed on the restored root; keeping the restore pending"
  result failed "snapper missing"
  exit 1
fi
if ! snapper --no-dbus -c root list >/dev/null 2>&1; then
  log "snapper cannot read the restored collection; keeping the restore pending"
  result failed "snapper list failed"
  exit 1
fi
snapper --no-dbus -c root create -c number -d "Restored from ${restored_from:-?}" \
  --userdata "restored_from=${restored_from:-unknown}" >/dev/null 2>&1 ||
  log "could not record a snapshot of the restored state (continuing)"

# The record on /boot is what lets prune-previous tell a verified restore
# from one that has not rebooted yet, so it must be updated or nothing is.
if [[ ! -f $RECORD ]]; then
  log "no restore record at $RECORD; keeping the restore pending"
  result failed "record missing"
  exit 1
fi
if ! sed -i 's/^phase=.*/phase=finished/' "$RECORD" || ! grep -Fxq 'phase=finished' "$RECORD"; then
  log "could not mark $RECORD finished; keeping the restore pending"
  result failed "record update failed"
  exit 1
fi
rm -f "$STATE_DIR/pending"
result finished "restored from snapshot ${restored_from:-?}"
rm -f "${OMARCHY_SNAPSHOT_RESTORE_WANTS_DIR:-/etc/systemd/system/sysinit.target.wants}/omarchy-mac-snapshot-restore-finish.service"
log "restore from snapshot ${restored_from:-?} verified; run omarchy-snapshot prune-previous to drop the kept root"
exit 0
