#!/bin/bash

# omarchy:summary=Retire the omarchy-mac [omarchy-aarch64] repository and replace its conflicting packages
# omarchy:hidden=true
# omarchy:requires-sudo=true

# Macs that crossed from the omarchy-mac project still list its unsigned
# community repository, [omarchy-aarch64] (github.com/omarchy-mac/omarchy-pkgs-aarch64),
# and hold packages from it or from the AUR that conflict with the signed
# [omarchy] ones. install/hardware/pacman.sh drops the section, keeping
# [omarchy] ahead of everything it shadowed; then each legacy package is
# replaced by its [omarchy] equivalent, only where the legacy one is installed
# and the replacement is available, and the retired sync database leaves
# pacman's sync directory. Nothing is done on a Mac without any of them.
#
# Exit 0 when there was nothing to do or everything was done, 1 when a step
# could not finish. A step that fails leaves what it has not finished in
# place for the next run to find: the section when pacman.conf could not be
# rewritten or synced, the legacy package until its own files are gone.
# omarchy update runs this before every package upgrade, so a caller carries on.

set -euo pipefail

omarchy-hw-apple-silicon || exit 0

pacman_conf="${OMARCHY_PACMAN_CONF:-/etc/pacman.conf}"
legacy_header='^[[:space:]]*\[omarchy-aarch64\][[:space:]]*$'

if grep -Eq "$legacy_header" "$pacman_conf"; then
  echo "Retiring the legacy [omarchy-aarch64] package repository"
  if ! sudo env OMARCHY_PATH="$OMARCHY_PATH" OMARCHY_PACMAN_CONF="$pacman_conf" \
    bash -euo pipefail -c 'source "$1"' _ "$OMARCHY_PATH/install/hardware/pacman.sh"; then
    echo "Could not remove [omarchy-aarch64] from $pacman_conf; its packages stay as they are." >&2
    exit 1
  fi
  if grep -Eq "$legacy_header" "$pacman_conf"; then
    echo "[omarchy-aarch64] is still listed in $pacman_conf; its packages stay as they are." >&2
    exit 1
  fi
fi

# legacy package, then the [omarchy] package that replaces it.
legacy_replacements=(
  "obsidian-appimage obsidian"
  "hyprland-preview-share-picker-git hyprland-preview-share-picker"
)

status=0
for pair in "${legacy_replacements[@]}"; do
  read -r legacy replacement <<<"$pair"
  pacman -Q "$legacy" &>/dev/null || continue
  if ! pacman -Si "$replacement" &>/dev/null; then
    echo "$replacement is not in the configured repositories; keeping $legacy"
    continue
  fi

  legacy_files=() legacy_dirs=()
  while IFS= read -r file; do
    if [[ $file == */ ]]; then
      legacy_dirs=("$file" "${legacy_dirs[@]}")
    else
      legacy_files+=("$file")
    fi
  done < <(pacman -Qlq "$legacy")
  # obsidian-appimage declares its conflict with obsidian, and --ask 4 lets
  # pacman remove it in the same transaction. The -git picker declares none,
  # so the files the two share are taken over in that transaction instead.
  overwrite=()
  for file in "${legacy_files[@]}"; do
    overwrite+=(--overwrite "$(sed 's/[][*?\\]/\\&/g' <<<"$file")")
  done

  echo "Replacing $legacy with $replacement from the Omarchy repositories"
  if ! sudo pacman -S --noconfirm --ask 4 "${overwrite[@]}" "$replacement"; then
    echo "Could not install $replacement; $legacy stays installed." >&2
    status=1
    continue
  fi
  pacman -Q "$legacy" &>/dev/null || continue

  # The shared files now belong to the replacement too, so removing the
  # legacy package normally would delete them. The files and emptied
  # directories no other package owns go first, while it is still installed,
  # so a failure here is retried on the next run; then its database entry
  # goes. pacman -Qo names only the first owner, so ownership comes from the
  # full file list of every other package.
  cleaned=1
  others=$(mktemp)
  if pacman -Ql >"$others.all"; then
    awk -v legacy="$legacy" '$1 != legacy { sub(/^[^ ]+ /, ""); print }' "$others.all" >"$others"
    for file in "${legacy_files[@]}"; do
      [[ -e $file || -L $file ]] && [[ ! -d $file ]] || continue
      grep -Fxq -- "$file" "$others" && continue
      sudo rm -f -- "$file" || { cleaned=0; break; }
    done
    if (( cleaned )); then
      for dir in "${legacy_dirs[@]}"; do
        [[ -d $dir ]] || continue
        grep -Fxq -- "$dir" "$others" && continue
        sudo rmdir --ignore-fail-on-non-empty -- "$dir" || { cleaned=0; break; }
      done
    fi
  else
    cleaned=0
  fi
  rm -f "$others" "$others.all"
  if (( ! cleaned )) || ! sudo pacman -Rdd --dbonly --noconfirm "$legacy"; then
    echo "$replacement is installed, but $legacy could not be removed; the next run tries again." >&2
    status=1
  fi
done

# The retired repository's sync database. pacman ignores a database whose
# section is gone, but omarchy-update-asahi-bundle reads it, or the copy
# install/hardware/pacman.sh keeps when it drops the section, to prove which
# installed packages that repository built. With the section gone the live
# copy can no longer change, so it moves to the kept copy (Macs that lost the
# section before pacman.sh kept one have only the live copy). The kept copy
# goes once no installed package is one that repository built: omarchy update
# runs the bundle before this, so a legacy bundle package it replaced no
# longer matches, and one it could not replace keeps the proof for next time.
# Whenever the answer is uncertain, the database stays.
kept_db="${OMARCHY_RETIRED_REPOSITORY_DIR:-/var/lib/omarchy/retired-repositories}/omarchy-aarch64.db"

desc_field() {
  awk -v field="%$1%" '$0 == field { getline; print; exit }'
}

# Succeeds when an installed package has the name, version and build date of
# an entry in the database, the way the bundle looks it up (the entry named
# after the installed package's local directory), and whenever that cannot be
# decided: an unreadable database, local package database or entry.
proves_installed_package() {
  local database=$1 members member dir local_desc local_entry entry field
  members=$(bsdtar -tf "$database" 2>/dev/null) || return 0
  [[ -n $members && -r $db_path/local && -x $db_path/local ]] || return 0
  while IFS= read -r member; do
    [[ $member == */desc ]] || continue
    dir=${member%/desc}
    dir=${dir#./}
    [[ -n $dir && $dir != */* && -e $db_path/local/$dir ]] || continue
    local_desc="$db_path/local/$dir/desc"
    local_entry=$(cat -- "$local_desc" 2>/dev/null) || return 0
    entry=$(bsdtar -xOf "$database" "$member" 2>/dev/null) || return 0
    for field in NAME VERSION BUILDDATE; do
      [[ $(desc_field "$field" <<<"$entry") == "$(desc_field "$field" <<<"$local_entry")" ]] || continue 2
    done
    return 0
  done <<<"$members"
  return 1
}

retire_sync_database() {
  local repositories live_db sidecars=() file retire_live=1 result=0

  # pacman-conf reads the configuration pacman does, Include files and all.
  if ! repositories=$(pacman-conf --config "$pacman_conf" --repo-list 2>/dev/null) ||
    ! db_path=$(pacman-conf --config "$pacman_conf" DBPath 2>/dev/null); then
    echo "Could not read the pacman configuration; the retired [omarchy-aarch64] sync database stays." >&2
    return 1
  fi
  ! grep -Fxq omarchy-aarch64 <<<"$repositories" || return 0
  db_path=${db_path:-/var/lib/pacman}
  db_path=${db_path%/}
  live_db="$db_path/sync/omarchy-aarch64.db"

  # Signatures and the file-list database prove nothing and are simply removed.
  for file in "$live_db.sig" "$db_path/sync/omarchy-aarch64.files" "$db_path/sync/omarchy-aarch64.files.sig"; do
    [[ -e $file ]] && sidecars+=("$file")
  done
  if (( ${#sidecars[@]} )) && ! sudo rm -f -- "${sidecars[@]}"; then
    result=1
  fi

  if [[ -f $live_db ]]; then
    if proves_installed_package "$live_db" && ! cmp -s "$live_db" "$kept_db"; then
      # Existence is asked with the privilege the replacement would use: a
      # kept copy this user cannot see or read still counts as proof.
      if sudo test -e "$kept_db" && proves_installed_package "$kept_db"; then
        # Both prove something and differ: both stay for the bundle.
        retire_live=0
      elif ! sudo install -D -m 0644 "$live_db" "$kept_db"; then
        echo "Could not keep the retired [omarchy-aarch64] sync database; it stays in $db_path/sync." >&2
        retire_live=0
        result=1
      fi
    fi
    if (( retire_live )); then
      if sudo rm -f -- "$live_db"; then
        echo "Removed the retired [omarchy-aarch64] sync database from $db_path/sync"
      else
        result=1
      fi
    fi
  fi

  if [[ -f $kept_db && ! -f $live_db ]] && ! proves_installed_package "$kept_db"; then
    if sudo rm -f -- "$kept_db"; then
      echo "Removed the kept [omarchy-aarch64] sync database; no installed package came from that repository"
    else
      result=1
    fi
  fi
  return "$result"
}

retire_sync_database || status=1

exit "$status"
