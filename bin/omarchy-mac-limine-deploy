#!/bin/bash

# omarchy:summary=Put the installed Limine on the ESP of an Apple Silicon Mac that boots it
# omarchy:requires-sudo=true
# omarchy:hidden=true

# U-Boot boots ESP:/EFI/BOOT/BOOTAA64.EFI. The limine package's own pacman
# hook (limine-install) deploys nothing on aarch64, so this copies the
# packaged Limine into that slot whenever it changed; a pacman hook on
# usr/share/limine/BOOTAA64.EFI runs it, and so does omarchy-mac-boot-update.

set -uo pipefail

limine_efi=${OMARCHY_LIMINE_EFI:-/usr/share/limine/BOOTAA64.EFI}
limine_default=${OMARCHY_LIMINE_DEFAULT:-/etc/default/limine}

omarchy-mac-limine-active || exit 0
# The ESP Limine's tooling writes to (ESP_PATH, /boot/efi or on older installs
# /boot), else wherever omarchy-mac-esp finds it.
esp=${OMARCHY_ESP:-$(sed -n -E 's/^ESP_PATH="?([^"]*)"?$/\1/p' "$limine_default" 2>/dev/null | tail -n 1)}
[[ -n $esp ]] || esp=$(omarchy-mac-esp) || { echo "omarchy-mac-limine-deploy: cannot find the system ESP" >&2; exit 1; }
target=$esp/EFI/BOOT/BOOTAA64.EFI
[[ -f $limine_efi ]] || { echo "omarchy-mac-limine-deploy: $limine_efi is missing" >&2; exit 1; }
findmnt -no TARGET "$esp" >/dev/null 2>&1 || { echo "omarchy-mac-limine-deploy: the ESP is not mounted at $esp" >&2; exit 1; }

cmp -s "$limine_efi" "$target" && exit 0
# Staged beside the slot and synced before the rename: the slot is never
# half-written, and a Mac that loses power keeps GRUB or gets whole Limine.
mkdir -p "$esp/EFI/BOOT" &&
  install -m600 "$limine_efi" "$target.new" &&
  sync -f "$target.new" || { rm -f "$target.new"; echo "omarchy-mac-limine-deploy: could not stage Limine on $esp" >&2; exit 1; }
mv -f "$target.new" "$target" || { rm -f "$target.new"; echo "omarchy-mac-limine-deploy: could not write $target" >&2; exit 1; }
sync -f "$target" || true
echo "Limine updated on $target"
