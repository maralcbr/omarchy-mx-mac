#!/bin/bash

# omarchy:summary=Install and configure Voxtype dictation
# omarchy:requires-sudo=true

set -e

# Install voxtype and configure it for use.

if gum confirm "Install Voxtype + AI model (~150MB) to enable dictation?"; then
  # voxtype-bin is prebuilt for x86_64, and for aarch64 in the [omarchy]
  # repository. voxtype-bin conflicts with the AUR voxtype, so a Mac that
  # already built voxtype from source keeps it. Without either, the AUR
  # source package is the only Voxtype that installs.
  if [[ $(uname -m) == "x86_64" ]]; then
    omarchy-pkg-add wtype voxtype-bin
  elif omarchy-pkg-present voxtype && ! omarchy-pkg-present voxtype-bin; then
    omarchy-pkg-add wtype
  elif omarchy-pkg-present voxtype-bin || omarchy-pkg-available voxtype-bin; then
    omarchy-pkg-add wtype voxtype-bin
  else
    gum style --foreground 3 "There's no prebuilt Voxtype binary for your CPU architecture."
    if ! gum confirm "Build Voxtype from source instead? This can take 10-20 minutes."; then
      echo "Skipping Voxtype install."
      exit 0
    fi

    if ! omarchy-pkg-aur-accessible; then
      gum style --foreground 1 "The AUR is unreachable right now, so Voxtype can't be built from source. Try again later."
      exit 1
    fi

    if ! omarchy-pkg-aur-add voxtype; then
      gum style --foreground 1 "Building Voxtype from source failed. The build output above shows why."
      exit 1
    fi
    omarchy-pkg-add wtype
  fi

  # Setup voxtype
  mkdir -p ~/.config/voxtype
  cp "$OMARCHY_PATH/default/voxtype/config.toml" ~/.config/voxtype/

  voxtype setup --download --no-post-install
  if omarchy-hw-vulkan; then
    voxtype setup gpu --enable || true
  fi
  voxtype setup systemd

  hyprctl reload >/dev/null
  omarchy-restart-shell
  omarchy-notification-send -g  "Voxtype Dictation Ready" "Hold F9 to dictate (or toggle with Super + Ctrl + X)." -t 10000
fi
