#!/bin/bash

# omarchy:summary=Set a new encryption password for a drive selected.
# omarchy:requires-sudo=true

# After provisioning on Apple Silicon, the login and root passwords are the
# passphrase of the disk holding /. Changing that disk's password keeps them
# together: the LUKS key changes first and must open the disk before either
# account changes. The journal records only the disk's UUID, key slots and
# phase, so a change that stops part way is finished by the next run. Other
# encrypted drives, and other platforms, change the LUKS key alone.

# Passwords live in variables; never trace them.
set +x

JOURNAL=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/drive-password.state

apple_silicon() {
  omarchy-hw-apple-silicon
}

journal_get() {
  [[ -f $JOURNAL ]] || return 1
  awk -F= -v k="$1" '$1 == k { print $2; exit }' "$JOURNAL"
}

# Set key/value pairs durably, keeping every other recorded key.
journal_put() {
  local line key tmp
  local -A updates=()
  local -a lines=()

  while (( $# >= 2 )); do
    updates[$1]=$2
    shift 2
  done

  if [[ -f $JOURNAL ]]; then
    while IFS= read -r line || [[ -n $line ]]; do
      if [[ -n $line && -z ${updates[${line%%=*}]+set} ]]; then
        lines+=("$line")
      fi
    done <"$JOURNAL"
  fi
  for key in "${!updates[@]}"; do
    lines+=("$key=${updates[$key]}")
  done

  tmp=$(mktemp "$JOURNAL.XXXXXX") || return 1
  if printf '%s\n' "${lines[@]}" >"$tmp" && chmod 600 "$tmp" && sync "$tmp" && mv -f "$tmp" "$JOURNAL"; then
    sync "${JOURNAL%/*}"
    return
  fi
  rm -f "$tmp"
  return 1
}

# The LUKS partition beneath /, or nothing when / is not encrypted. Fails when
# it cannot tell, including a crypt layer whose LUKS partition lsblk cannot name.
root_luks_device() {
  local root_source ancestry device
  root_source=$(findmnt -no SOURCE /) && [[ -n $root_source ]] || return 1
  ancestry=$(lsblk -nsrpo NAME,TYPE,FSTYPE "${root_source%%[*}") || return 1
  device=$(awk '$3 == "crypto_LUKS" { print $1; exit }' <<<"$ancestry")
  if [[ -n $device ]]; then
    readlink -f "$device"
  elif awk '$2 == "crypt" { found = 1 } END { exit !found }' <<<"$ancestry"; then
    return 1
  fi
}

# Every cryptsetup call holds the disk lock, so one left running by a run that
# was killed finishes before the next run looks at the drive.

# Print the key slot the password opens. Returns 2 when it opens none, and
# another failure when the drive cannot be checked. cryptsetup open tries
# enrolled tokens (TPM2, FIDO2, keyring) before the key and reports a token's
# slot whatever key it was given, so allow only a token type no token has.
drive_key_slot() {
  local drive=$1 password=$2 out status=0
  out=$(printf '%s' "$password" | sudo flock "$disk_lock" env LC_ALL=C cryptsetup open --test-passphrase --verbose --token-type passphrase-only --key-file - "$drive" 2>&1) || status=$?
  (( status == 0 )) || return "$status"
  grep -o 'Key slot [0-9]* unlocked' <<<"$out" | grep -o '[0-9]*' | head -1
}

# The enabled key slots, comma-separated. A luks2-keyring token under "Tokens:"
# looks like a keyslot, so read only the keyslot section.
drive_slots() {
  local dump
  dump=$(sudo flock "$disk_lock" cryptsetup luksDump "$1") || return 1
  awk '
    /^[^ \t]/ { keyslots = ($0 == "Keyslots:") }
    keyslots && /^ +[0-9]+: luks2/ { sub(":", "", $1); print $1 }
    /^Key Slot [0-9]+: ENABLED/ { sub(":", "", $3); print $3 }' <<<"$dump" | paste -sd, -
}

kill_slot() {
  local drive=$1 password=$2 slot=$3
  printf '%s' "$password" | sudo flock "$disk_lock" cryptsetup luksKillSlot -q --key-file - "$drive" "$slot"
}

login_user() {
  local user=${SUDO_USER:-$(id -un)}
  [[ -n $user && $user != "root" ]] || return 1
  printf '%s' "$user"
}

# luksChangeKey writes the new key before it retires the old one (LUKS2 swaps
# them in one header update), so a failure that leaves the new key unable to
# open the drive changed nothing: that returns 2. One that stops in between
# leaves both keys, so the old key is retired here until it opens nothing.
# Sets new_slot.
change_luks_key() {
  local drive=$1 current=$2 new=$3 old_slot=$4 remains attempt status
  local -a pbkdf=(--iter-time 2000)

  echo "Changing full-disk encryption password for $drive"
  if sudo cryptsetup isLuks --type luks2 "$drive"; then
    pbkdf+=(--pbkdf argon2id)
  fi
  # Both keys travel over stdin, the current one on the first line.
  printf '%s\n%s' "$current" "$new" |
    sudo flock "$disk_lock" bash -c 'IFS= read -r current; drive=$1; shift; exec cryptsetup luksChangeKey "$@" --key-file <(printf "%s" "$current") "$drive" <(cat)' bash "$drive" "${pbkdf[@]}"

  new_slot=$(drive_key_slot "$drive" "$new") || return
  for (( attempt = 0; attempt < 8; attempt++ )); do
    status=0
    remains=$(drive_key_slot "$drive" "$current") || status=$?
    (( status == 2 )) && return 0
    (( status == 0 )) && [[ $remains != "$new_slot" ]] || return 1
    kill_slot "$drive" "$new" "$remains" || return 1
  done
  return 1
}

# The menu launches this command unelevated, so chpasswd runs under sudo like
# cryptsetup.
sync_accounts() {
  local user=$1 password=$2
  echo "Setting the login password for $user and root to match"
  printf '%s:%s\n' "$user" "$password" | sudo chpasswd || return 1
  printf 'root:%s\n' "$password" | sudo chpasswd
}

# Phase luks: the key change may or may not have landed. Phase accounts: the
# new key alone opens the recorded slot and the accounts still need it.
change_system_password() {
  local current=$1 new=$2 old_slot=$3 user=$4 slots status=0

  slots=$(drive_slots "$root_drive")
  if [[ ,$slots, != *",$old_slot,"* ]]; then
    echo "Could not read the key slots of $root_drive."
    return 1
  fi
  mkdir -p "${JOURNAL%/*}" &&
    journal_put uuid "$root_uuid" old_slot "$old_slot" slots "$slots" phase luks || return 1

  change_luks_key "$root_drive" "$current" "$new" "$old_slot" || status=$?
  if (( status == 2 )); then
    rm -f "$JOURNAL"
    echo "The disk password did not change, so the login and root passwords did not either."
    return 1
  elif (( status != 0 )); then
    echo "Could not confirm the disk password change. Run omarchy-drive-password again to finish."
    return 1
  fi
  journal_put slot "$new_slot" phase accounts || return 1

  if ! sync_accounts "$user" "$new"; then
    echo "The login and root passwords were not updated. Run omarchy-drive-password again to finish."
    return 1
  fi
  rm -f "$JOURNAL"
}

# A journal left on this system's disk by a change that stopped part way.
change_pending() {
  local phase uuid
  phase=$(journal_get phase) || return 1
  uuid=$(journal_get uuid)
  if [[ $phase == "luks" || $phase == "accounts" ]] && [[ -n $uuid && $uuid == "$root_uuid" ]]; then
    return 0
  fi
  rm -f "$JOURNAL"
  return 1
}

# Settle the disk on the password it opens with now, then match the accounts.
# Before the change was confirmed that is the old key (removing the slot the
# change added, if any) or the new key in the one slot the change added
# (retiring the old slot); after, only the confirmed slot. Any other key on the
# disk, such as the recovery passphrase, is refused, and so is a disk that gained
# more than one slot since.
finish_interrupted_change() {
  local phase old_slot slots slot user header password opened now added extra count=0 status=0

  phase=$(journal_get phase)
  old_slot=$(journal_get old_slot)
  slots=$(journal_get slots)
  slot=$(journal_get slot)

  if [[ $phase == "luks" && ! ( $old_slot =~ ^[0-9]+$ && ,$slots, == *",$old_slot,"* ) ]] ||
    [[ $phase == "accounts" && ! $slot =~ ^[0-9]+$ ]]; then
    echo "$JOURNAL is unreadable. Remove it once the disk and login passwords agree."
    return 1
  fi

  user=$(login_user) || { echo "Run omarchy-drive-password as the user who logs in to finish the last password change."; return 1; }

  echo "The last password change for $root_drive stopped before the login and root passwords matched it."
  if [[ $phase == "accounts" ]]; then
    header="New encryption password"
  else
    header="Encryption password that opens $root_drive now (the new one if the change went through)"
  fi
  password=$(gum input --password --header "$header") || return 1

  opened=$(drive_key_slot "$root_drive" "$password") || status=$?
  if (( status != 0 && status != 2 )); then
    echo "Could not check the password against $root_drive."
    return 1
  fi

  if [[ $phase == "luks" && -n $opened ]]; then
    now=$(drive_slots "$root_drive") || { echo "Could not read the key slots of $root_drive."; return 1; }
    for extra in ${now//,/ }; do
      if [[ ,$slots, != *",$extra,"* ]]; then
        added=$extra
        count=$(( count + 1 ))
      fi
    done
    if (( count > 1 )); then
      echo "The key slots of $root_drive changed since the interrupted change. Finish it by hand."
      return 1
    fi

    if [[ $opened == "$old_slot" ]]; then
      [[ -z $added ]] || kill_slot "$root_drive" "$password" "$added" || return 1
    elif [[ -n $added && $opened == "$added" ]]; then
      if [[ ,$now, == *",$old_slot,"* ]]; then
        kill_slot "$root_drive" "$password" "$old_slot" || return 1
      fi
    else
      opened=""
    fi
    [[ -z $opened ]] || journal_put slot "$opened" phase accounts || return 1
  elif [[ $phase == "accounts" && $opened != "$slot" ]]; then
    opened=""
  fi

  if [[ -z $opened ]]; then
    echo "That password does not finish the change on $root_drive. Run omarchy-drive-password again to finish."
    return 1
  fi

  sync_accounts "$user" "$password" || return 1
  rm -f "$JOURNAL"
  echo "The login and root passwords now match the disk password."
}

change_selected_drive() {
  local encrypted_drives drive login current old_slot new_password confirmation status=0 system_drive=false

  encrypted_drives=$(blkid -t TYPE=crypto_LUKS -o device)
  if [[ -z $encrypted_drives ]]; then
    echo "No encrypted drives available."
    return 1
  fi

  if (( $(wc -l <<<"$encrypted_drives") == 1 )); then
    drive="$encrypted_drives"
  else
    drive="$(omarchy-drive-select "$encrypted_drives")"
  fi

  if [[ -z $drive ]]; then
    echo "No drive selected."
    return 0
  fi

  if [[ -n $root_drive && $(readlink -f "$drive") == "$root_drive" ]]; then
    system_drive=true
    drive=$root_drive
    login=$(login_user) || { echo "Run omarchy-drive-password as the user who logs in to change the system disk password."; return 1; }
    echo "$drive holds the system, so its new password also becomes the login password for $login and root."
  fi

  current=$(gum input --password --header "Current encryption password") || return 1
  old_slot=$(drive_key_slot "$drive" "$current") || status=$?
  if (( status == 2 )); then
    echo "That password does not open $drive."
    return 1
  elif (( status != 0 )); then
    echo "Could not check the password against $drive."
    return 1
  fi

  new_password=$(gum input --password --header "New encryption password") || return 1
  [[ -n $new_password ]] || { echo "Password cannot be empty."; return 1; }

  confirmation=$(gum input --password --header "Confirm new encryption password") || return 1
  [[ $new_password == "$confirmation" ]] || { echo "Passwords do not match."; return 1; }
  [[ $new_password != "$current" ]] || { echo "The new password is the current one."; return 1; }

  if [[ $system_drive == "true" ]]; then
    change_system_password "$current" "$new_password" "$old_slot" "$login"
  else
    change_luks_key "$drive" "$current" "$new_password" "$old_slot" || status=$?
    if (( status == 2 )); then
      echo "The password of $drive did not change."
      return 1
    elif (( status != 0 )); then
      echo "Could not confirm the password change on $drive."
      return 1
    fi
  fi
}

disk_lock=${JOURNAL%/*}/drive-password.disk.lock
mkdir -p "${JOURNAL%/*}" && touch "$disk_lock" && exec {lock_fd}>"${JOURNAL%/*}/drive-password.lock" && flock -n "$lock_fd" ||
  { echo "Another drive password change is running."; exit 1; }

root_drive=""
if apple_silicon; then
  root_drive=$(root_luks_device) || { echo "Could not tell which drive holds the system."; exit 1; }
fi
root_uuid=""
if [[ -n $root_drive ]]; then
  root_uuid=$(lsblk -dno UUID "$root_drive") && [[ -n $root_uuid ]] || { echo "Could not read the UUID of $root_drive."; exit 1; }
fi

if change_pending; then
  finish_interrupted_change
else
  change_selected_drive
fi
