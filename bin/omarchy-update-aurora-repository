#!/bin/bash

# omarchy:summary=Pin the Aurora kernel repository at the qualified signed release
# omarchy:args=[--complete]
# omarchy:hidden=true
# omarchy:requires-sudo=true

# Macs installed from the RC (Aurora) channel run linux-aurora and m1n1-aurora,
# which live only in [omarchy-aurora]: one immutable aurora-packages-<commit>
# or aurora-stable-packages-<commit> release. The ISO pins that release once, and
# some Aurora payloads left the section out altogether, so nothing ever moved
# these Macs to a newer kernel.
#
# The runtime pins the release holding the kernel last qualified on real
# hardware, the digest of its signed AURORA descriptor, and the releases it
# replaces. This proves the release matches, then adds [omarchy-aurora] just
# ahead of [omarchy] or moves it forward from one of those predecessors. Commit
# hashes carry no order, so a section on any other release -- a candidate pinned
# by hand for qualification, say -- is left exactly as it is. Every other byte of
# pacman.conf stays as it was, and a machine whose channel record is not an
# unheld Aurora kernel (linux-aurora) is never touched.
#
# An rc Mac whose Aurora lane is edge follows the newest aurora-edge-<N> release
# instead, never one below the release it last accepted. The release it picks is
# journaled as pending before the section moves, so an interrupted update comes
# back to the same one. An edge section goes back to a pin only once a switch
# to rc or stable is asked for. The stable lane uses default/aurora-stable-release
# the same way rc uses the qualified pin. Lane switches are authenticated
# repository selections with an explicit targeted downgrade. Whichever release
# the section ends on, its verified descriptor is staged for the pacman hook that
# checks the synced database.
#
# While a switch or an edge move is open, the three packages are written to
# $OMARCHY_AURORA_TARGETS so the upgrade installs that release's versions, older
# or not. --complete then proves they are installed; before reboot it records
# that as pending, and after reboot (when uname matches) the move counts as done.
# Exit 3: edge could not be followed this time, so the section stays on the
# authenticated current release; nothing is rewritten onto another lane's pin.
#
# Image builds (OMARCHY_MAC_IMAGE_BUILD=1) keep the [omarchy-aurora] Server the
# builder already pinned. The signed AURORA for that release is verified and
# staged; the section is never moved or advanced to the runtime pin.

set -euo pipefail

repo=maralcbr/omarchy-pkgs
trusted_key=C81AC3E2A99556F9B21D5FEA3DD49BC9F8360BDC
trusted_subkey=CAB18E175BFB9ACCE185234474DE0C737AC186E4
release_tag_pattern='^aurora-packages-[0-9a-f]{40}$'
stable_tag_pattern='^aurora-stable-packages-[0-9a-f]{40}$'
edge_tag_pattern='^aurora-edge-([1-9][0-9]{0,8})$'
edge_pointer_url=https://downloads.aicodelabs.com.au/pointers/aurora-edge-channel
releases_api_url="https://api.github.com/repos/$repo/releases?per_page=100"
listing_page_limit=10
comment_line="# Aurora kernel and bootloader, kept on the qualified release by omarchy update"
aurora_packages=(linux-aurora linux-aurora-headers m1n1-aurora)

# A move carries the headers only where they are installed: some Aurora Macs
# still hold linux-asahi-headers, which conflict with them.
move_packages() {
  local installed package
  installed=$(pacman -Qq) || return 1
  for package in "${aurora_packages[@]}"; do
    [[ $package != linux-aurora-headers ]] || grep -Fxq -- "$package" <<<"$installed" || continue
    printf '%s\n' "$package"
  done
}

# True when update-m1n1 takes its device trees from ALARM's *-ARCH default, as
# omarchy-apple-silicon-retire-saved-modules decides it. A user-set DTBS is not
# this hazard: completion still trusts the boot check.
dtbs_from_alarm_default() {
  local script config configured
  script=$(root_path /usr/bin/update-m1n1)
  [[ -r $script ]] && grep -Eq '^[[:space:]]*:[[:space:]]+\$\{DTBS:=.*/modules/\*-ARCH' "$script" || return 1
  config=$(root_path /etc/default/update-m1n1)
  [[ -e $config ]] || return 0
  configured=$(env -i PATH=/usr/bin:/bin bash --noprofile --norc -c '
    unset DTBS M1N1_UPDATE_DISABLED
    . "$1" >/dev/null 2>&1 || exit 1
    printf "%s" "${DTBS-}${M1N1_UPDATE_DISABLED-}"
  ' _ "$config") || return 1
  [[ -z $configured ]]
}

# ALARM's update-m1n1 takes the newest *-ARCH directory. A leftover headers
# tree above linux-aurora with no dtbs makes that rebuild empty; name the owner.
stale_aurora_module_trees() {
  local file kver="" name match dtb owner_text owner repair
  local modules
  local -a hazards=()

  modules=$(root_path /usr/lib/modules)
  while IFS= read -r file; do
    [[ $file =~ ^/usr/lib/modules/([^/]+)/vmlinuz$ ]] || continue
    [[ -z $kver ]] || return 1
    kver=${BASH_REMATCH[1]}
  done < <(pacman -Qlq linux-aurora 2>/dev/null || true)
  [[ -n $kver ]] || return 1

  for match in "$modules"/*-ARCH; do
    [[ -e $match || -L $match ]] || continue
    name=${match##*/}
    [[ $name != "$kver" ]] || continue
    [[ $(printf '%s\n%s\n' "$name" "$kver" | sort -rV | head -1) == "$name" ]] || continue
    repair=""
    for dtb in "$match"/dtbs/*.dtb; do
      [[ -f $dtb ]] || continue
      repair=has
      break
    done
    [[ $repair != has ]] || continue
    owner=""
    owner_text=$(LC_ALL=C pacman -Qqo "/usr/lib/modules/$name" 2>&1) && owner=$owner_text || {
      [[ $owner_text == *"No package owns"* ]] || owner="unknown"
    }
    if [[ $owner == linux-asahi-headers ]]; then
      repair="owned by linux-asahi-headers; sudo pacman -Rdd linux-asahi-headers, sudo pacman -S --needed omarchy-aurora/linux-aurora-headers, sudo update-m1n1"
    elif [[ -n $owner && $owner != unknown ]]; then
      repair="owned by $owner; remove that package's files from /usr/lib/modules/$name, then sudo update-m1n1"
    elif [[ $owner == unknown ]]; then
      repair="ownership unknown; inspect /usr/lib/modules/$name, then sudo update-m1n1"
    else
      repair="owned by no package; move it aside, then sudo update-m1n1"
    fi
    hazards+=("/usr/lib/modules/$name sorts above linux-aurora $kver and has no device trees ($repair)")
  done
  (( ${#hazards[@]} )) || return 1
  local message=""
  printf -v message '%s; ' "${hazards[@]}"
  printf '%s' "${message%; }"
}

fail() {
  echo "Aurora kernel repository update: $*" >&2
  exit 2
}

refuse_offline_download() {
  [[ ${OMARCHY_AURORA_OFFLINE:-} != 1 ]] || fail "offline mode refuses to download $1"
}

mode=update
case "${1:-}" in
  "") ;;
  --complete) mode=complete ;;
  -h|--help)
    echo "Usage: omarchy-update-aurora-repository [--complete]"
    exit 0
    ;;
  *) fail "unknown option '$1'" ;;
esac

root_path() {
  printf '%s%s\n' "${OMARCHY_AURORA_ROOT:-}" "$1"
}

# Only a Mac whose channel record names linux-aurora reads [omarchy-aurora]. A
# record that cannot be trusted stops the update; evidence too ambiguous to
# record skips this. Legacy Asahi Macs (stable:linux-asahi) are left alone.
omarchy-hw-apple-silicon || exit 0
# Locks nest update lock, then channel lock, and nothing waits for the update lock
# while holding the channel lock, so ensure and the re-execs below cannot deadlock.
if [[ ${OMARCHY_APPLE_SILICON_CHANNEL_LOCKED:-} != 1 ]]; then
  channel_status=0
  omarchy-apple-silicon-channel ensure || channel_status=$?
  case $channel_status in
    0) ;;
    3) exit 0 ;;
    *) exit 2 ;;
  esac
  # ensure took and released the channel lock; a legacy Asahi Mac (kernel=linux-asahi)
  # stops before the update lock. An Aurora Mac, including record channel=stable
  # on linux-aurora, continues.
  record_channel="" record_kernel=""
  if asahi_status=$(omarchy-apple-silicon-channel status 2>/dev/null); then
    while IFS= read -r line; do
      case "$line" in
        channel=*) record_channel=${line#channel=} ;;
        kernel=*) record_kernel=${line#kernel=} ;;
      esac
    done <<<"$asahi_status"
    [[ $record_kernel == linux-aurora ]] || exit 0
  fi

  # omarchy update already holds the update lock; run on its own, take it here.
  if ! omarchy-update-lock held; then
    exec env OMARCHY_AURORA_REPOSITORY_STANDALONE=1 omarchy-update-lock run "$0" "$@"
  fi

  # The rest holds the channel lock, so a hold cannot land between reading the record and repinning.
  exec omarchy-apple-silicon-channel locked "$0" "$@"
fi

# Re-entered from locked, or from an environment that only claims to be: prove both locks.
omarchy-apple-silicon-channel verify-locked || exit 2
omarchy-update-lock held || fail "the update lock is not held; run omarchy update, or this command on its own"

channel_status=0
channel_record=$(omarchy-apple-silicon-channel status) || channel_status=$?
case $channel_status in
  0) ;;
  3) exit 0 ;;
  *) exit 2 ;;
esac
channel="" channel_hold="" channel_kernel=""
while IFS= read -r line; do
  case "$line" in
    channel=*) channel=${line#channel=} ;;
    kernel=*) channel_kernel=${line#kernel=} ;;
    hold=*) channel_hold=${line#hold=} ;;
  esac
done <<<"$channel_record"
[[ $channel_kernel == linux-aurora ]] || exit 0
if [[ -n $channel_hold && $mode == update ]]; then
  printf "\e[33mLeaving [omarchy-aurora] as it is: this Mac's channel is held (%s).\e[0m\n" "$channel_hold" >&2
  exit 0
fi

lane_state=$(omarchy-apple-silicon-channel lane) ||
  fail "this Mac's Aurora lane cannot be read; omarchy-apple-silicon-channel reset-rc returns it to rc"
current_boot_id() {
  local id
  id=${OMARCHY_BOOT_ID:-$(tr -d '-\n' </proc/sys/kernel/random/boot_id 2>/dev/null || true)}
  [[ $id =~ ^[0-9a-f]{32}$ ]] || id=unknown
  printf '%s' "$id"
}

# The kernel release the installed linux-aurora would boot (its modules directory).
installed_kernel_release() {
  local file
  while IFS= read -r file; do
    [[ $file =~ ^/usr/lib/modules/([^/]+)/vmlinuz$ ]] || continue
    printf '%s' "${BASH_REMATCH[1]}"
    return 0
  done < <(pacman -Qlq linux-aurora 2>/dev/null || true)
  return 1
}

lane=rc switch="" accepted="" pending="" reboot_pending=""
while IFS= read -r line; do
  case "$line" in
    lane=*) lane=${line#lane=} ;;
    switch=*) switch=${line#switch=} ;;
    edge_accepted=*) accepted=${line#edge_accepted=} ;;
    edge_pending=*) pending=${line#edge_pending=} ;;
    reboot_pending=*) reboot_pending=${line#reboot_pending=} ;;
  esac
done <<<"$lane_state"
accepted_sequence=${accepted%%:*} accepted_digest=${accepted#*:}
pending_sequence=${pending%%:*} pending_digest=${pending#*:}

pin_file="$OMARCHY_PATH/default/aurora-qualified-release"
stable_pin_file="$OMARCHY_PATH/default/aurora-stable-release"
trusted_key_file="$OMARCHY_PATH/default/omarchy-arm-repository.asc"
staged_descriptor="$(root_path /var/lib/omarchy)/aurora-target.descriptor"
reboot_blocked=${OMARCHY_REBOOT_BLOCKED:-/run/omarchy-reboot-blocked}

# 0 with pin_tag, pin_digest and pin_predecessors set from $1. $2 is rc or stable:
# stable accepts aurora-packages-* (the placeholder) and aurora-stable-packages-*.
parse_pin_file() {
  local file=$1 allowed=$2 line predecessor
  pin_tag="" pin_digest="" pin_predecessors=()
  local seen=0

  [[ -r $file ]] || return 1
  while IFS= read -r line; do
    case "$line" in
      tag=*)
        [[ -z $pin_tag ]] || return 1
        pin_tag=${line#tag=}
        ;;
      descriptor_sha256=*)
        [[ -z $pin_digest ]] || return 1
        pin_digest=${line#descriptor_sha256=}
        ;;
      predecessors=*)
        (( ! seen )) || return 1
        seen=1
        read -ra pin_predecessors <<<"${line#predecessors=}"
        ;;
      ""|"#"*) ;;
      *) return 1 ;;
    esac
  done <"$file"
  [[ -n $pin_tag && $pin_digest =~ ^[0-9a-f]{64}$ ]] && (( seen )) || return 1
  if [[ $allowed == stable ]]; then
    [[ $pin_tag =~ $release_tag_pattern || $pin_tag =~ $stable_tag_pattern ]] || return 1
  else
    [[ $pin_tag =~ $release_tag_pattern ]] || return 1
  fi
  for predecessor in "${pin_predecessors[@]}"; do
    if [[ $allowed == stable ]]; then
      [[ $predecessor =~ $release_tag_pattern || $predecessor =~ $stable_tag_pattern ]] || return 1
    else
      [[ $predecessor =~ $release_tag_pattern ]] || return 1
    fi
    [[ $predecessor != "$pin_tag" ]] || return 1
  done
}

tag="" pinned_sha256="" predecessors=()
other_tag="" other_predecessors=()
parse_pin_file "$pin_file" rc || fail "the qualified Aurora release pin is malformed"
rc_pin_tag=$pin_tag rc_pin_digest=$pin_digest
rc_pin_predecessors=("${pin_predecessors[@]}")
stable_pin_tag="" stable_pin_digest="" stable_pin_predecessors=()
if [[ -r $stable_pin_file ]]; then
  if parse_pin_file "$stable_pin_file" stable; then
    stable_pin_tag=$pin_tag stable_pin_digest=$pin_digest
    stable_pin_predecessors=("${pin_predecessors[@]}")
  elif [[ $lane == stable ]]; then
    fail "the stable Aurora release pin is malformed"
  fi
elif [[ $lane == stable ]]; then
  fail "the stable Aurora release pin is not installed"
fi
if [[ $lane == stable ]]; then
  tag=$stable_pin_tag pinned_sha256=$stable_pin_digest
  predecessors=("${stable_pin_predecessors[@]}")
  other_tag=$rc_pin_tag
  other_predecessors=("${rc_pin_predecessors[@]}")
else
  tag=$rc_pin_tag pinned_sha256=$rc_pin_digest
  predecessors=("${rc_pin_predecessors[@]}")
  other_tag=$stable_pin_tag
  other_predecessors=("${stable_pin_predecessors[@]}")
fi

pacman_conf=$(root_path /etc/pacman.conf)
[[ -r $pacman_conf ]] || fail "pacman configuration is missing"
mapfile -t lines <"$pacman_conf"

# Lines written here end the way the file's own lines do.
eol=""
[[ ${lines[0]:-} != *$'\r' ]] || eol=$'\r'
signature_line="SigLevel = Required DatabaseOptional$eol"

header='^[[:space:]]*\[([^]]+)\][[:space:]]*$'
setting='^[[:space:]]*([A-Za-z]+)[[:space:]]*=[[:space:]]*(.*)$'
aurora=() omarchy=()
for i in "${!lines[@]}"; do
  [[ ${lines[i]} =~ $header ]] || continue
  case "${BASH_REMATCH[1]}" in
    omarchy-aurora) aurora+=("$i") ;;
    omarchy) omarchy+=("$i") ;;
  esac
done
(( ${#aurora[@]} <= 1 )) || fail "pacman configuration has more than one [omarchy-aurora] repository"
(( ${#omarchy[@]} == 1 )) || fail "pacman configuration must contain exactly one [omarchy] repository"

# A hold outlives any repin: pacman keeps the kernel it has. The hold was put
# there on purpose, so it stays; say plainly what it blocks.
if [[ $mode == update ]]; then
  held=$(omarchy-apple-silicon-channel held 2>/dev/null) || held=""
  if [[ -n $held ]]; then
    echo -e "\e[33mIgnorePkg/IgnoreGroup in /etc/pacman.conf holds $held, so omarchy update cannot install a newer Aurora kernel until that hold is removed.\e[0m" >&2
  fi
fi

# The first line of the run of comments sitting directly on top of line $1.
comments_above() {
  local i=$1
  while (( i > 0 )) && [[ ${lines[i-1]} =~ ^[[:space:]]*# ]]; do
    (( i-- ))
  done
  echo "$i"
}

# One past the last setting of the section headed at $1. Blank and comment lines
# before the next header belong to whatever follows.
section_end() {
  local end=$(( ${#lines[@]} )) i
  for (( i = $1 + 1; i < ${#lines[@]}; i++ )); do
    if [[ ${lines[i]} =~ $header ]]; then
      end=$i
      break
    fi
  done
  while (( end - 1 > $1 )) && [[ ${lines[end-1]} =~ ^[[:space:]]*(#.*)?$ ]]; do
    (( end-- ))
  done
  echo "$end"
}

# What the section names now: none, the pin, a predecessor, an edge release, or
# something else, which is somebody's decision and is never moved.
section_kind=none start="" end="" current=() kept=() recognised=0
if (( ${#aurora[@]} )); then
  start=${aurora[0]}
  end=$(section_end "$start")
  release_url="^https://github\.com/$repo/releases/download/(aurora-packages-[0-9a-f]{40}|aurora-stable-packages-[0-9a-f]{40}|aurora-edge-[1-9][0-9]{0,8})/?[[:space:]]*$"
  recognised=1
  for (( i = start + 1; i < end; i++ )); do
    if [[ ${lines[i]} =~ $setting ]]; then
      name=${BASH_REMATCH[1]}
      value=${BASH_REMATCH[2]%$'\r'}
      case "$name" in
        SigLevel) continue ;;
        Server)
          if [[ $value =~ $release_url ]]; then
            [[ " ${current[*]} " == *" ${BASH_REMATCH[1]} "* ]] || current+=("${BASH_REMATCH[1]}")
          else
            current+=("$value")
            recognised=0
          fi
          continue
          ;;
        Include)
          current+=("Include = $value")
          recognised=0
          continue
          ;;
      esac
    fi
    kept+=("${lines[i]}")
  done

  if (( ! recognised || ${#current[@]} != 1 )); then
    section_kind=other
  elif [[ ${current[0]} == "$tag" ]]; then
    section_kind=pin
  elif [[ " ${predecessors[*]} " == *" ${current[0]} "* ]]; then
    section_kind=predecessor
  elif [[ -n $other_tag && ${current[0]} == "$other_tag" ]] ||
    { (( ${#other_predecessors[@]} )) && [[ " ${other_predecessors[*]} " == *" ${current[0]} "* ]]; }; then
    section_kind=other_lane
  elif [[ ${current[0]} =~ $edge_tag_pattern ]]; then
    section_kind=edge
  else
    section_kind=other
  fi
fi
current_tag=""
[[ $section_kind == none || $section_kind == other ]] || current_tag=${current[0]}

declare -A package_version=()
database_sha256=""
target_tag="" target_digest=""

# Proven once, and trusted only while root controls it and it has the digest expected of it.
trusted_staged() {
  local owner group mode
  [[ -n $1 && -f $staged_descriptor && ! -L $staged_descriptor ]] || return 1
  read -r owner group mode < <(stat -c '%u %g %a' "$staged_descriptor" 2>/dev/null) || return 1
  if [[ ${OMARCHY_APPLE_SILICON_CHANNEL_TESTING:-0} != 1 ]] && [[ $owner != 0 || $group != 0 ]]; then
    return 1
  fi
  (( (8#$mode & 8#022) == 0 )) || return 1
  [[ $(sha256sum "$staged_descriptor" | cut -d' ' -f1) == "$1" ]]
}

# 0 when $1 describes exactly $target_tag: its channel, tag and sequence agree,
# and it names each Aurora package and the repository database once.
read_descriptor() {
  local line key value name version database_lines=0
  local -A fields=() counts=() package_lines=()
  package_version=() database_sha256=""

  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line == *=* ]] || return 1
    key=${line%%=*}
    value=${line#*=}
    case "$key" in
      package)
        IFS='|' read -r _ name version _ <<<"$value"
        [[ -n $name && -n $version ]] || return 1
        package_lines[$name]=$(( ${package_lines[$name]:-0} + 1 ))
        package_version[$name]=$version
        ;;
      asset)
        if [[ ${value%%|*} == omarchy-aurora.db ]]; then
          database_sha256=${value#*|}
          (( database_lines += 1 ))
        fi
        ;;
      *)
        counts[$key]=$(( ${counts[$key]:-0} + 1 ))
        fields[$key]=$value
        ;;
    esac
  done <"$1"

  for key in format channel release_tag signing_fingerprint; do
    [[ ${counts[$key]:-0} == 1 ]] || return 1
  done
  [[ ${fields[format]} == 1 && ${fields[release_tag]} == "$target_tag" && ${fields[signing_fingerprint]} == "$trusted_subkey" ]] || return 1
  if [[ $target_tag =~ $edge_tag_pattern ]]; then
    [[ ${fields[channel]} == aurora-edge && ${counts[sequence]:-0} == 1 && ${fields[sequence]} == "${BASH_REMATCH[1]}" ]] || return 1
  elif [[ $target_tag =~ $stable_tag_pattern ]]; then
    [[ ${fields[channel]} == aurora-stable && -z ${counts[sequence]:-} ]] || return 1
  else
    [[ ${fields[channel]} == aurora && -z ${counts[sequence]:-} ]] || return 1
  fi
  for name in "${aurora_packages[@]}"; do
    [[ ${package_lines[$name]:-0} == 1 ]] || return 1
  done
  (( database_lines == 1 )) && [[ $database_sha256 =~ ^[0-9a-f]{64}$ ]]
}

if [[ $mode == complete ]]; then
  unverified() {
    echo -e "\e[31mThe move to $target_tag is not verified: $1.\e[0m" >&2
    echo "Do not reboot yet. Fix that and run omarchy update again, or run omarchy-apple-silicon-channel reset-rc to go back to rc." >&2
    sudo tee "$reboot_blocked" >/dev/null <<<"the move to $target_tag is not verified: $1" || true
    exit 1
  }

  # Only an open switch, or an edge release journaled as pending, has anything
  # to prove, and a switch that names no release it can prove is never done.
  if [[ ( $lane == rc || $lane == stable ) && $switch == "$lane" ]]; then
    target_tag=$tag target_digest=$pinned_sha256
  elif [[ $lane == edge && -n $pending ]]; then
    target_tag=aurora-edge-$pending_sequence target_digest=$pending_digest
  elif [[ $lane == edge && $switch == edge && -n $accepted ]]; then
    target_tag=aurora-edge-$accepted_sequence target_digest=$accepted_digest
  elif [[ -z $switch ]]; then
    exit 0
  else
    target_tag=$switch
    unverified "no release was journaled for the switch to $switch"
  fi

  [[ $current_tag == "$target_tag" ]] || unverified "[omarchy-aurora] is on ${current[*]:-no server}"
  trusted_staged "$target_digest" && read_descriptor "$staged_descriptor" ||
    unverified "the staged descriptor is not $target_tag's"
  moved=$(move_packages) || unverified "the installed packages cannot be listed"
  for package in $moved; do
    installed=$(pacman -Q "$package" 2>/dev/null) || unverified "$package is not installed"
    installed=${installed#"$package "}
    [[ $installed == "${package_version[$package]}" ]] ||
      unverified "$package $installed is installed, but $target_tag has ${package_version[$package]}"
  done
  # A downgrade leaves the running kernel's modules where update-m1n1 looks first.
  omarchy-apple-silicon-retire-saved-modules linux-aurora ||
    unverified "the running kernel's saved modules could not be moved aside for m1n1"
  if dtbs_from_alarm_default && stale_reason=$(stale_aurora_module_trees); then
    unverified "$stale_reason"
  fi
  boot_status=0
  omarchy-apple-silicon-boot-check linux-aurora || boot_status=$?
  if (( boot_status == 0 )); then
    if [[ $lane == rc || $lane == stable ]]; then
      omarchy-apple-silicon-channel lane-write switch= edge_pending= reboot_pending= || exit 2
      message="This Mac is back on $lane ($target_tag), running linux-aurora ${package_version[linux-aurora]}, and its boot files match."
    else
      omarchy-apple-silicon-channel lane-write "edge_accepted=${target_tag#aurora-edge-}:$target_digest" edge_pending= switch= reboot_pending= || exit 2
      message="This Mac now runs $target_tag from edge, linux-aurora ${package_version[linux-aurora]}, and its boot files match."
    fi
    [[ ! -e $reboot_blocked ]] || sudo rm -f "$reboot_blocked"
    echo "$message"
    exit 0
  fi
  # The strict check failed: the installed kernel is not the running one. That
  # is expected until the Mac reboots. The journal names the installing boot
  # and the kernel it installed: another boot that runs a different kernel and
  # not the journaled one is the only proof the kernel did not come up.
  current_boot=$(current_boot_id)
  installed_kver=$(installed_kernel_release || true)
  journal_boot=${reboot_pending%%:*}
  journal_kver=""
  [[ $reboot_pending != *:* ]] || journal_kver=${reboot_pending#*:}
  running_kver=${OMARCHY_BOOT_CHECK_UNAME:-$(uname -r)}
  if [[ -n $reboot_pending && $journal_boot != 1 && $journal_boot != unknown && $current_boot != unknown &&
        $journal_boot != "$current_boot" && ( -z $journal_kver || $journal_kver != "$running_kver" ) ]]; then
    unverified "the installed kernel did not come up after reboot"
  fi
  boot_status=0
  OMARCHY_BOOT_CHECK_ALLOW_PENDING_REBOOT=1 omarchy-apple-silicon-boot-check linux-aurora || boot_status=$?
  (( boot_status == 0 )) || unverified "the boot files do not match the installed kernel"
  omarchy-apple-silicon-channel lane-write "reboot_pending=$current_boot${installed_kver:+:$installed_kver}" || exit 2
  [[ ! -e $reboot_blocked ]] || sudo rm -f "$reboot_blocked"
  echo "linux-aurora ${package_version[linux-aurora]} from $target_tag is installed, reboot pending."
  exit 0
fi

leave() {
  local status=$1
  shift
  echo -e "\e[33m$*\e[0m" >&2
  exit "$status"
}

workdir=$(mktemp -d)
trap 'rm -rf "$workdir"' EXIT
descriptor="$workdir/AURORA"

# A pointer exactly as the publisher writes it, compared byte for byte.
read_edge_pointer() {
  local file="$1" body="" size sequence canonical
  local pattern=$'^format=1\nsequence=([1-9][0-9]{0,8})\n'
  [[ -f $file ]] && size=$(wc -c <"$file") || return 1
  (( size <= 256 )) || return 1
  IFS= read -r -d '' body <"$file" || true
  [[ $body =~ $pattern ]] || return 1
  sequence=${BASH_REMATCH[1]}
  printf -v canonical 'format=1\nsequence=%s\ntag=aurora-edge-%s\n' "$sequence" "$sequence"
  [[ $body == "$canonical" ]] && (( size == ${#canonical} )) || return 1
  printf '%s\n' "$sequence"
}

# The highest edge sequence published as a full release, or nothing when there
# is none. Fails unless the listing is read to an empty page within the cap.
listed_edge_sequence() {
  local page highest="" found
  for (( page = 1; page <= listing_page_limit; page++ )); do
    refuse_offline_download "$releases_api_url&page=$page"
    curl --fail --location --silent --proto '=https' --tlsv1.2 --max-time 30 \
      "$releases_api_url&page=$page" --output "$workdir/releases.json" || return 1
    jq -e 'type == "array"' "$workdir/releases.json" >/dev/null 2>&1 || return 1
    if (( $(jq 'length' "$workdir/releases.json") == 0 )); then
      printf '%s\n' "$highest"
      return 0
    fi
    found=$(jq -r '
      [ .[]
        | select(.draft == false and .prerelease == false)
        | .tag_name
        | select(type == "string" and test("^aurora-edge-[1-9][0-9]{0,8}$"))
        | sub("^aurora-edge-"; "") | tonumber ]
      | max // empty
    ' "$workdir/releases.json" 2>/dev/null) || return 1
    if [[ -n $found ]] && (( found > ${highest:-0} )); then
      highest=$found
    fi
  done
  return 1
}

# Sets edge_sequence, or defer when edge cannot be followed this time. The
# pointer can hold a Mac back, never move it below the release it accepted.
discover_edge() {
  local pointer_status=0 pointer_sequence="" listed="" listing=1
  refuse_offline_download "$edge_pointer_url"
  curl --fail --location --silent --proto '=https' --tlsv1.2 --max-time 20 --max-filesize 256 \
    "$edge_pointer_url" --output "$workdir/pointer" || pointer_status=$?
  if (( pointer_status == 0 || pointer_status == 63 )); then
    pointer_sequence=$(read_edge_pointer "$workdir/pointer") ||
      echo "Aurora edge: the edge pointer is malformed; using the release listing." >&2
  fi
  if [[ -n $accepted && -n $pointer_sequence ]] && (( pointer_sequence >= accepted_sequence )); then
    edge_sequence=$pointer_sequence
    return 0
  fi

  listed=$(listed_edge_sequence) || listing=0
  if (( listing )) && [[ -n $accepted ]]; then
    edge_sequence=$accepted_sequence
    if [[ -n $listed ]] && (( listed > accepted_sequence )); then
      edge_sequence=$listed
    fi
  elif (( listing )) && [[ -n $listed ]]; then
    edge_sequence=$listed
  elif (( listing )); then
    defer="no edge release is published yet"
  elif [[ -z $accepted && -n $pointer_sequence ]]; then
    echo "Aurora edge: the release listing is unavailable, so this follows the edge pointer to aurora-edge-$pointer_sequence." >&2
    edge_sequence=$pointer_sequence
  else
    defer="the edge release listing is unavailable"
  fi
}

# Without edge this time, keep the authenticated current release. Never fall
# back to another lane's pin: a stable section must not become the rc pin, and
# an rc section must not be rewritten onto stable. Exit before anything is
# staged or rewritten.
plan_defer() {
  leave 3 "Aurora edge: $1; [omarchy-aurora] stays on ${current_tag:-${current[*]:-no server}} for this update."
}

gpg_ready=0
prepare_gpg() {
  (( ! gpg_ready )) || return 0
  for command in gpg sha256sum; do
    omarchy-cmd-present "$command" || fail "$command is required"
  done
  if [[ ${OMARCHY_AURORA_OFFLINE:-} != 1 ]]; then
    omarchy-cmd-present curl || fail "curl is required"
  fi
  gnupg_dir="$workdir/gnupg"
  mkdir -m 0700 "$gnupg_dir"
  [[ -r $trusted_key_file ]] || fail "trusted Omarchy ARM repository key is not installed"
  actual_fingerprint=$(gpg --batch --show-keys --with-colons "$trusted_key_file" 2>/dev/null |
    awk -F: '$1 == "fpr" && !found { print $10; found = 1 }') ||
    fail "could not read the trusted Omarchy ARM repository key"
  [[ $actual_fingerprint == "$trusted_key" ]] || fail "trusted Omarchy ARM repository key fingerprint does not match"
  gpg --batch --homedir "$gnupg_dir" --import "$trusted_key_file" >/dev/null 2>&1 || fail "could not load the trusted Omarchy ARM repository key"
  subkey_kind=$(gpg --batch --homedir "$gnupg_dir" --with-colons --list-keys 2>/dev/null |
    awk -F: -v wanted="$trusted_subkey" '
      $1 == "pub" || $1 == "sub" { kind = $1; next }
      $1 == "fpr" && $10 == wanted && !found { print kind; found = 1 }
    ') ||
    fail "could not list the trusted Omarchy ARM repository key"
  [[ $subkey_kind == "sub" ]] || fail "trusted Omarchy ARM repository key does not carry the signing subkey"
  gpg_ready=1
}

verify_signature() {
  local file="$1" signature="$2" status
  [[ -s $file && -s $signature ]] || fail "missing signed asset $(basename "$file")"
  status=$(gpg --batch --homedir "$gnupg_dir" --status-fd 1 --verify "$signature" "$file" 2>/dev/null) ||
    fail "signature verification failed for $(basename "$file")"
  awk -v key="$trusted_subkey" '$2 == "VALIDSIG" && $3 == key { valid=1 } END { exit !valid }' <<<"$status" ||
    fail "$(basename "$file") was not signed by the Omarchy ARM repository signing subkey"
}

# 0 with $descriptor holding $target_tag's proven descriptor, 1 when it could not
# be downloaded. The pin's digest is its proof, so an rc descriptor staged
# under that digest is reused; an edge one is fetched again each time.
obtain_descriptor() {
  local server="https://github.com/$repo/releases/download/$target_tag" digest
  if [[ ${OMARCHY_AURORA_OFFLINE:-} == 1 ]]; then
    trusted_staged "$target_digest" || fail "offline mode requires a trusted staged descriptor matching $target_tag"
    cp "$staged_descriptor" "$descriptor"
    read_descriptor "$descriptor" || fail "the staged descriptor for $target_tag is malformed"
    return 0
  fi
  if [[ ! $target_tag =~ $edge_tag_pattern ]] && trusted_staged "$target_digest"; then
    cp "$staged_descriptor" "$descriptor"
    read_descriptor "$descriptor" || fail "the staged descriptor for $target_tag is malformed"
    return 0
  fi
  prepare_gpg
  refuse_offline_download "$server/AURORA"
  refuse_offline_download "$server/AURORA.sig"
  if ! curl --fail --location --silent --show-error --proto '=https' --tlsv1.2 "$server/AURORA" --output "$descriptor" ||
    ! curl --fail --location --silent --show-error --proto '=https' --tlsv1.2 "$server/AURORA.sig" --output "$descriptor.sig"; then
    if trusted_staged "$target_digest"; then
      cp "$staged_descriptor" "$descriptor"
      read_descriptor "$descriptor" || fail "the staged descriptor for $target_tag is malformed"
      return 0
    fi
    echo "Aurora kernel repository update: could not download $server/AURORA" >&2
    return 1
  fi
  digest=$(sha256sum "$descriptor" | cut -d' ' -f1)
  if [[ -n $target_digest && $digest != "$target_digest" ]]; then
    [[ $target_tag =~ $edge_tag_pattern ]] || fail "AURORA in $target_tag does not match the qualified digest"
    fail "AURORA in $target_tag is not the one this Mac already verified for that release; refusing a release that changed after publication"
  fi
  verify_signature "$descriptor" "$descriptor.sig"
  read_descriptor "$descriptor" || fail "AURORA in $target_tag does not describe that Aurora release"
  target_digest=$digest
}

# Image builds pin [omarchy-aurora] to the builder's selected lane release.
# Do not follow the runtime pin, edge, or a switch; only verify that section's
# signed AURORA descriptor and stage it, the way image mode keeps [omarchy] on
# the builder's asahi-packages-stable tag.
if [[ ${OMARCHY_MAC_IMAGE_BUILD:-} == 1 ]]; then
  [[ $section_kind != none ]] || fail "image mode requires a pinned [omarchy-aurora] repository"
  if (( ! recognised || ${#current[@]} != 1 )) ||
    { [[ ! ${current[0]} =~ $release_tag_pattern ]] &&
      [[ ! ${current[0]} =~ $stable_tag_pattern ]] &&
      [[ ! ${current[0]} =~ $edge_tag_pattern ]]; }; then
    fail "image mode requires [omarchy-aurora] to name an Aurora lane release"
  fi
  target_tag=${current[0]}
  target_digest=""
  obtain_descriptor || fail "image mode could not verify the AURORA descriptor for $target_tag"
  if ! cmp -s "$descriptor" "$staged_descriptor"; then
    omarchy-apple-silicon-channel stage-descriptor "$descriptor" || exit 2
  fi
  leave 0 "image mode keeps the builder's [omarchy-aurora] on $target_tag"
fi

defer="" edge_sequence=""
if [[ ${OMARCHY_AURORA_OFFLINE:-} == 1 ]]; then
  if [[ $lane == edge ]]; then
    if [[ -n $pending ]]; then
      target_tag=aurora-edge-$pending_sequence
      target_digest=$pending_digest
    elif [[ -n $accepted ]]; then
      target_tag=aurora-edge-$accepted_sequence
      target_digest=$accepted_digest
    else
      fail "offline mode requires a journaled edge target"
    fi
  else
    target_tag=$tag
    target_digest=$pinned_sha256
  fi
  [[ $current_tag == "$target_tag" ]] ||
    fail "offline mode requires [omarchy-aurora] on $target_tag (on ${current[*]:-no server})"
  trusted_staged "$target_digest" ||
    fail "offline mode requires a trusted staged descriptor matching $target_tag"
  obtain_descriptor || exit 2
elif [[ $lane == rc || $lane == stable ]]; then
  # Only the pin itself or a release it names as replaced may move, and an edge
  # or other-lane release only once a switch to this pin was asked for. Anything
  # else may be newer, and a hand-pinned candidate is somebody's decision.
  if [[ $section_kind == other || ( $section_kind == edge && $switch != "$lane" ) ||
    ( $section_kind == other_lane && $switch != "$lane" ) ]]; then
    pin_name="qualified release $tag"
    [[ $lane != stable ]] || pin_name="stable release $tag"
    leave 0 "Leaving [omarchy-aurora] on ${current[*]:-no server}: it is neither the runtime's $pin_name nor a release that one replaces."
  fi
  target_tag=$tag target_digest=$pinned_sha256
  obtain_descriptor || exit 2
else
  [[ $section_kind != other ]] ||
    leave 0 "Leaving [omarchy-aurora] on ${current[*]:-no server}: this Mac follows edge, but omarchy update only moves it from the qualified release $tag, a release that one replaces, or an edge release."
  omarchy-cmd-present jq || fail "jq is required"
  # A release already journaled is finished before anything is discovered again.
  if [[ -n $pending ]]; then
    edge_sequence=$pending_sequence
    target_digest=$pending_digest
  else
    discover_edge
    [[ -z $edge_sequence || $edge_sequence != "$accepted_sequence" ]] || target_digest=$accepted_digest
  fi
  if [[ -n $defer ]]; then
    plan_defer "$defer"
  fi
  target_tag=aurora-edge-$edge_sequence
  if ! obtain_descriptor; then
    [[ $target_tag =~ $edge_tag_pattern ]] || exit 2
    plan_defer "$target_tag could not be downloaded"
  fi
fi

# Journaled before anything moves, so an interrupted update resumes this
# release, and before an unaccepted release counts even when the section
# already names it. Only the accepted release, already in place, needs none.
if [[ $target_tag =~ $edge_tag_pattern ]]; then
  selected="${BASH_REMATCH[1]}:$target_digest"
  if [[ $pending != "$selected" ]] && [[ $selected != "$accepted" || $current_tag != "$target_tag" ]]; then
    pending=$selected
    omarchy-apple-silicon-channel lane-write "edge_pending=$pending" || exit 2
  fi
fi
if ! cmp -s "$descriptor" "$staged_descriptor"; then
  omarchy-apple-silicon-channel stage-descriptor "$descriptor" || exit 2
fi

server_line="Server = https://github.com/$repo/releases/download/$target_tag$eol"
omarchy_start=$(comments_above "${omarchy[0]}")
if [[ -z $start ]]; then
  updated=(
    "${lines[@]:0:omarchy_start}"
    "$comment_line$eol" "[omarchy-aurora]$eol" "$signature_line" "$server_line" "$eol"
    "${lines[@]:omarchy_start}"
  )
else
  block=("${lines[start]}" "$signature_line" "$server_line" "${kept[@]}")
  if (( start < ${omarchy[0]} )); then
    updated=("${lines[@]:0:start}" "${block[@]}" "${lines[@]:end}")
  else
    # Behind [omarchy], pacman would resolve the kernel from the wrong place.
    # Move the block, its own comments with it, and the blank line after it.
    from=$(comments_above "$start")
    to=$end
    if (( to < ${#lines[@]} )) && [[ ${lines[to]} =~ ^[[:space:]]*$ ]]; then
      (( to += 1 ))
    fi
    updated=(
      "${lines[@]:0:omarchy_start}"
      "${lines[@]:from:start-from}" "${block[@]}" "$eol"
      "${lines[@]:omarchy_start:from-omarchy_start}"
      "${lines[@]:to}"
    )
  fi
fi

printf '%s\n' "${updated[@]}" >"$workdir/pacman.conf"
# A file that ended without a newline keeps ending that way.
if [[ -s $pacman_conf && -n $(tail -c 1 "$pacman_conf") ]]; then
  truncate -s -1 "$workdir/pacman.conf"
fi

if ! cmp -s "$workdir/pacman.conf" "$pacman_conf"; then
  prepare_gpg
  backup="$(root_path /var/lib/omarchy/backups)/aurora-repository-$(date +%Y%m%d%H%M%S)"
  mkdir "$workdir/backup"
  cp "$pacman_conf" "$workdir/backup/pacman.conf"
  config_paths=("$pacman_conf")
  [[ ! -d $(root_path /etc/pacman.d) ]] || config_paths+=("$(root_path /etc/pacman.d)")
  sudo find "${config_paths[@]}" -type f -exec sha256sum {} + >"$workdir/backup/config-sha256.txt"
  sudo install -d -o root -g root -m 0700 "$backup"
  sudo cp -a "$workdir/backup"/. "$backup/"

  if ! sudo pacman-key --finger "$trusted_key" >/dev/null 2>&1; then
    sudo pacman-key --add "$trusted_key_file"
    sudo pacman-key --lsign-key "$trusted_key"
  fi

  # The package upgrade after this step does the sync. Every release serves its
  # database as omarchy-aurora.db, and upload times are not ordered by release,
  # so that sync could keep a cached database from the previous release and
  # reject it against the new signature. Drop it before the new pin lands: no
  # cache beside the old pin only means the next sync downloads it again, but a
  # stale one beside the new pin would outlive a rerun, which finds nothing left
  # to change.
  db_path=$(awk -F= '/^[[:space:]]*DBPath[[:space:]]*=/ { gsub(/[[:space:]]/, "", $2); print $2 }' "$pacman_conf")
  sync_dir="$(root_path "${db_path:-/var/lib/pacman}")/sync"
  sudo rm -f "$sync_dir/omarchy-aurora.db" "$sync_dir/omarchy-aurora.db.sig" ||
    fail "could not remove the cached Aurora database in $sync_dir; pacman.conf is unchanged"

  # Staged beside the original so the rename is atomic.
  sudo install -o root -g root -m 0644 "$workdir/pacman.conf" "$pacman_conf.omarchy-aurora"
  sudo mv -f "$pacman_conf.omarchy-aurora" "$pacman_conf"

  echo "Pinned the Aurora kernel repository to $target_tag (backup: $backup)"
  if [[ ${OMARCHY_AURORA_REPOSITORY_STANDALONE:-} == 1 ]]; then
    echo "omarchy update will sync it."
  fi
fi

[[ -z $defer ]] || exit 3

# An open move installs exactly the staged release's packages, older or not.
if [[ -n ${OMARCHY_AURORA_TARGETS:-} ]] &&
  [[ ( ( $lane == rc || $lane == stable ) && $switch == "$lane" ) || ($lane == edge && ($switch == edge || -n $pending)) ]]; then
  moved=$(move_packages) || fail "the installed packages cannot be listed"
  printf 'omarchy-aurora/%s\n' $moved >"$OMARCHY_AURORA_TARGETS"
fi
