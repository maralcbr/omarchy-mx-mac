#!/bin/bash

# omarchy:summary=Check whether an Omarchy update is available

# Official Omarchy tags can point at different commits in this fork, so only
# compare tags from the Mac release namespace.
latest_tag=$(git -C "$OMARCHY_PATH" ls-remote --tags --sort="version:refname" origin "v*-mac.*" | awk '{print $2}' | sed 's#refs/tags/##' | tail -n 1)
if [[ -z $latest_tag ]]; then
  echo "Error: Could not retrieve latest tag."
  exit 1
fi

# Get local tag
current_tag=""
while IFS= read -r tag; do
  current_tag="$tag"
  break
done < <(git -C "$OMARCHY_PATH" tag --merged HEAD --list "v*-mac.*" --sort=-version:refname)
if [[ -z $current_tag ]]; then
  echo "Error: Could not retrieve current tag."
  exit 1
fi

if [[ $current_tag != $latest_tag ]]; then
  echo "Omarchy update available ($latest_tag)"
  exit 0
else
  echo "Omarchy is up to date ($current_tag)"
  exit 1
fi
