#!/bin/bash

# omarchy:summary=Check whether an Omarchy update is available

set -euo pipefail

latest_tag=$(omarchy-stable-release source_tag)
current_tag=$(git -C "$OMARCHY_PATH" describe --tags --exact-match --match "v*-mac.*" 2>/dev/null || true)
[[ -n $current_tag ]] || current_tag="unreleased"

if [[ $current_tag != "unreleased" ]] && (( $(vercmp "${latest_tag#v}" "${current_tag#v}") < 0 )); then
  echo "Error: Refusing stable release rollback ($current_tag -> $latest_tag)." >&2
  exit 2
elif [[ $current_tag != $latest_tag ]]; then
  echo "Omarchy update available ($latest_tag)"
  exit 0
else
  echo "Omarchy is up to date ($current_tag)"
  exit 1
fi
